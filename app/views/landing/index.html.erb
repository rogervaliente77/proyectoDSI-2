<!-- 3. HERO CARROUSEL WALLPAPER -->
<header class="hero-carousel">
  <!-- Slide 1 -->
  <div class="carousel-slide active" style="background-image: url('https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1600&q=80');">
    <div class="carousel-overlay"></div>
    <div class="carousel-content">
      <span class="carousel-badge">Especialistas BMW & Alta Gama</span>
      <h1>BIMERS MOTOR CARS - <span>PREMIUM SERVICE</span></h1>
      <p>Diagnóstico computarizado avanzado, mecánica general y repuestos de alta performance.</p>
    </div>
  </div>

  <!-- Slide 2 -->
  <div class="carousel-slide" style="background-image: url('https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=1600&q=80');">
    <div class="carousel-overlay"></div>
    <div class="carousel-content">
      <span class="carousel-badge">Garantía & Confianza</span>
      <h1>Mantenimiento Preventivo & Correctivo</h1>
      <p>Personal certificado y tecnología de punta para el máximo rendimiento de tu auto.</p>
    </div>
  </div>

  <!-- Controles -->
  <button class="carousel-btn prev" onclick="moveSlide(-1)"><i class="fa-solid fa-chevron-left"></i></button>
  <button class="carousel-btn next" onclick="moveSlide(1)"><i class="fa-solid fa-chevron-right"></i></button>
</header>

<!-- 4. BOTONES DE ACCIONES RÁPIDAS (PANEL BLANCO) -->
<div class="quick-actions-container">
  <div class="quick-actions">
    <div class="action-btn">
      <i class="fa-regular fa-calendar-check"></i>
      <span>Agendar Cita</span>
    </div>
    <div class="action-btn">
      <i class="fa-solid fa-cart-shopping"></i>
      <span>Tienda Online</span>
    </div>
    <div class="action-btn">
      <i class="fa-solid fa-location-dot"></i>
      <span>Ubicación</span>
    </div>
    <div class="action-btn">
      <i class="fa-solid fa-headset"></i>
      <span>Contacto</span>
    </div>
  </div>
</div>

<!-- 5. CARDS DE CATEGORÍAS (DINÁMICAS CON BREADCRUMB) -->
<section id="servicios" class="text-center">
  <div class="section-title text-center">
    <h2>Categorías Principales</h2>
    <p>Explora nuestras líneas de productos y servicios especializados</p>
  </div>

  <!-- Breadcrumb Centrado -->
  <nav class="landing-breadcrumb-container mb-4 flex-center">
    <ul class="landing-breadcrumb" id="category-breadcrumb">
      <li class="breadcrumb-item active" data-category-id="root">
        <i class="fa-solid fa-folder"></i> Categorías Principales
      </li>
    </ul>
  </nav>

  <!-- Grid dinámico de categorías (Centrado) -->
  <div class="categories-grid" id="categories-grid">
    <% @categories.each do |category| %>
      <% 
        parent_id_val = category.parent_id.present? ? category.parent_id.to_s : "root"
        subcategories_count = category.subcategories.count
        has_image = category.respond_to?(:image_url) && category.image_url.present?
      %>
      <div class="category-card category-card-wrapper" 
           data-id="<%= category.id %>" 
           data-parent-id="<%= parent_id_val %>" 
           data-name="<%= category.name %>"
           data-slug="<%= category.name.parameterize %>">
        
        <!-- Imagen o Fallback -->
        <div class="category-card-img-wrapper">
          <% if has_image %>
            <img src="<%= category.image_url %>" alt="<%= category.name %>">
          <% else %>
            <div class="category-card-placeholder">
              <i class="fa-solid fa-layer-group"></i>
            </div>
          <% end %>
        </div>
        
        <!-- Cuerpo de la card -->
        <div class="category-card-body">
          <div class="category-card-title" title="<%= category.name %>">
            <span><%= category.name %></span>
          </div>
          
          <div class="category-card-action">
            <% if subcategories_count > 0 %>
              <button type="button" class="btn-subcategories view-subcategories-btn" data-id="<%= category.id %>" data-name="<%= category.name %>">
                Ver Subcategorías (<%= subcategories_count %>) <i class="fa-solid fa-chevron-right"></i>
              </button>
            <% else %>
              <button type="button" class="btn-subcategories" onclick="filterCategory('<%= category.name.parameterize %>')">
                Ver Productos <i class="fa-solid fa-arrow-down"></i>
              </button>
            <% end %>
          </div>
        </div>

      </div>
    <% end %>
  </div>
</section>

<!-- 6. CATÁLOGO CON FILTROS LATERALES -->
<section class="catalog-container" id="tienda">
  
  <!-- Filtros Lateral -->
  <aside class="filter-sidebar">
    <div class="search-box-sidebar">
      <input type="text" id="search-input" placeholder="Buscar..." onkeyup="filterProducts()">
    </div>

    <div class="filter-header-btn">
      <i class="fa-solid fa-sliders"></i> Filtros
    </div>

    <div class="filter-group">
      <label>Categoría</label>
      <select id="category-select" onchange="filterProducts()">
        <option value="all">Todas las categorías</option>
        <% @categories.each do |cat| %>
          <option value="<%= cat.name.parameterize %>"><%= cat.name %></option>
        <% end %>
      </select>
    </div>

    <div class="filter-group">
      <label>Tipo de servicio / producto</label>
      <select id="type-select" onchange="filterProducts()">
        <option value="all">Todos los tipos</option>
        <% if defined?(CarType) %>
          <% CarType.all.each do |ct| %>
            <option value="<%= ct.name.parameterize %>"><%= ct.name %></option>
          <% end %>
        <% else %>
          <option value="preventivo">Preventivo</option>
          <option value="alto-rendimiento">Alto Rendimiento</option>
        <% end %>
      </select>
    </div>

    <div class="filter-group">
      <label>Marca Vehículo</label>
      <select id="brand-select" onchange="filterProducts()">
        <option value="all">Todas las marcas</option>
        <% if defined?(Marca) %>
          <% Marca.all.each do |m| %>
            <option value="<%= m.name.parameterize %>"><%= m.name %></option>
          <% end %>
        <% else %>
          <option value="bmw">BMW</option>
          <option value="audi">Audi</option>
          <option value="mercedes">Mercedes-Benz</option>
        <% end %>
      </select>
    </div>

    <button class="btn-apply-filters" onclick="filterProducts()">Filtrar</button>
  </aside>

  <!-- Products Cards Grid Dinámico -->
  <main>
    <div class="products-grid" id="products-grid">
      <% if @products.present? && @products.any? %>
        <% @products.each do |product| %>
          <% 
            cat_slug = product.category ? product.category.name.parameterize : "sin-categoria"
            marca_slug = product.respond_to?(:marca) && product.marca ? product.marca.name.parameterize : ""
            type_slug = product.respond_to?(:car_type) && product.car_type ? product.car_type.name.parameterize : ""
            
            first_img_obj = product.try(:product_images)&.first
            img_url_from_db = if first_img_obj.is_a?(Hash)
                                first_img_obj['image_url'] || first_img_obj[:image_url]
                              else
                                first_img_obj.try(:image_url) || first_img_obj.try(:[], 'image_url')
                              end

            img_product = img_url_from_db.presence || 'https://images.unsplash.com/photo-1600706432522-e78112d8a9f2?auto=format&fit=crop&w=500&q=80'
          %>
          <div class="product-card" 
              data-category="<%= cat_slug %>" 
              data-brand="<%= marca_slug %>"
              data-type="<%= type_slug %>"
              data-name="<%= product.name.downcase %>">
            <div class="product-img-box">
              <img src="<%= img_product %>" alt="<%= product.name %>">
            </div>
            <div class="product-body">
              <h3 class="product-title"><%= product.name %></h3>
              <p class="product-desc"><%= product.try(:description) || "Producto de alta gama." %></p>
              <div class="product-footer">
                <span class="product-price">$<%= '%.2f' % (product.try(:price) || 0) %></span>
                <button class="btn-buy" type="button"><i class="fa-solid fa-cart-shopping"></i></button>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="no-products-msg">
          <i class="fa-solid fa-box-open"></i>
          <p>No hay productos disponibles actualmente.</p>
        </div>
      <% end %>
    </div>
  </main>
</section>

<!-- ESTILOS LIGEROS ORIGINALES DE LA VISTA -->
<style>
  /* 1. Breadcrumb con alineación e integración original */
  .landing-breadcrumb-container {
    max-width: 1200px;
    margin: 0 auto 20px auto;
    padding: 0 20px;
  }

  .landing-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 12px 20px;
    background-color: #f8f9fa;
    border-radius: 8px;
    gap: 8px;
    align-items: center;
    font-size: 0.95rem;
  }

  .landing-breadcrumb li.breadcrumb-item a {
    color: #0d6efd;
    text-decoration: none;
    font-weight: 500;
  }

  .landing-breadcrumb li.breadcrumb-item a:hover {
    text-decoration: underline;
  }

  .landing-breadcrumb li.breadcrumb-item.active {
    color: #333;
    font-weight: 700;
  }

  .landing-breadcrumb li + li::before {
    content: "/";
    padding-right: 8px;
    color: #6c757d;
  }

  /* Centrar títulos y encabezados de la sección */
  #servicios {
    text-align: center;
  }

  .section-title {
    text-align: center;
    margin-bottom: 25px;
  }

  /* 2. Grid de Categorías en una sola línea (Scroll Horizontal Flex) */
  .categories-grid {
    display: flex;
    flex-wrap: nowrap;          /* Forzado a 1 sola línea en pantallas grandes */
    overflow-x: auto;           /* Habilita scroll si no caben todas */
    justify-content: center;    /* Centra las tarjetas en pantalla */
    gap: 16px;
    max-width: 100%;
    margin: 0 auto;
    padding: 10px 5px 20px 5px; /* Espacio para sombras y barra de scroll */
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  /* Si hay muchas categorías y sobrepasan el ancho de pantalla, desactiva el centrado para scroll limpio */
  @media (max-width: 1200px) {
    .categories-grid {
      justify-content: flex-start;
    }
  }

  /* Personalización de la barra de scroll */
  .categories-grid::-webkit-scrollbar {
    height: 6px;
  }

  .categories-grid::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
  }

  .categories-grid::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 10px;
  }

  .categories-grid::-webkit-scrollbar-thumb:hover {
    background: #0d6efd;
  }

  /* 3. Card de Categoría con dimensiones fijas y alineadas */
  .category-card {
    flex: 0 0 200px;            /* Ancho fijo de 200px por card */
    height: 270px;              /* Altura uniforme estándar */
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #e9ecef;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .category-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
  }

  /* Imagen y Placeholder */
  .category-card-img-wrapper {
    width: 100%;
    height: 140px;
    overflow: hidden;
    background-color: #f8f9fa;
    position: relative;
  }

  .category-card-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .category-card:hover .category-card-img-wrapper img {
    transform: scale(1.06);
  }

  /* Placeholder cuando no hay category.image_url */
  .category-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
    color: #adb5bd;
  }

  .category-card-placeholder i {
    font-size: 2.8rem;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .category-card:hover .category-card-placeholder i {
    transform: scale(1.1);
    color: #6c757d;
  }

  /* Cuerpo inferior de la card */
  .category-card-body {
    padding: 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
    background-color: #ffffff;
  }

  /* Título reservando altura fija exacta de 2 líneas para nivelar botones */
  .category-card-title {
    height: 2.6em;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-bottom: 8px;
  }

  .category-card-title span {
    font-size: 0.88rem;
    font-weight: 700;
    color: #212529;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Botón de acción fijado al fondo */
  .category-card-action {
    width: 100%;
    margin-top: auto;
  }

  .btn-subcategories {
    background: #0d6efd;
    border: none;
    color: #ffffff;
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .btn-subcategories:hover {
    background: #0b5ed7;
    color: #ffffff;
  }

  /* 4. Estilos para el mensaje de "Sin Productos" */
  .no-products-msg {
    grid-column: 1 / -1;
    width: 100%;
    padding: 50px 20px;
    text-align: center;
    background-color: #ffffff;
    border: 1px dashed #ced4da;
    border-radius: 10px;
    color: #6c757d;
    margin: 20px 0;
  }

  .no-products-msg i {
    font-size: 3rem;
    margin-bottom: 12px;
    color: #adb5bd;
  }

  .no-products-msg p {
    font-size: 1.05rem;
    font-weight: 500;
    margin: 0;
  }
</style>

<!-- JAVASCRIPT CON SOPORTE PARA TURBO / TURBOLINKS -->
<script>
  function setupLandingScript() {
    // 1. Menú hamburguesa móvil
    const menuToggle = document.getElementById('menu-toggle');
    const navMenu = document.getElementById('nav-menu');

    if (menuToggle && navMenu) {
      menuToggle.addEventListener('click', () => {
        navMenu.classList.toggle('active');
      });
    }

    // 2. Carrusel de imágenes
    let currentSlide = 0;
    const slides = document.querySelectorAll('.carousel-slide');

    window.showSlide = function(index) {
      if (!slides.length) return;
      slides.forEach(slide => slide.classList.remove('active'));
      if (index >= slides.length) currentSlide = 0;
      if (index < 0) currentSlide = slides.length - 1;
      slides[currentSlide].classList.add('active');
    };

    window.moveSlide = function(step) {
      currentSlide += step;
      window.showSlide(currentSlide);
    };

    // 3. Sistema Dinámico de Navegación de Categorías & Breadcrumb
    const categoriesGrid = document.getElementById("categories-grid");
    const breadcrumb = document.getElementById("category-breadcrumb");
    
    if (!categoriesGrid || !breadcrumb) return;

    let navigationHistory = [{ id: 'root', name: 'Categorías Principales' }];

    function renderCurrentLevel(parentId) {
      const allWrappers = categoriesGrid.querySelectorAll(".category-card-wrapper");
      let countVisible = 0;

      allWrappers.forEach(wrapper => {
        if (wrapper.dataset.parentId === parentId) {
          wrapper.style.display = 'block';
          countVisible++;
        } else {
          wrapper.style.display = 'none';
        }
      });

      let noCatMsg = document.getElementById("no-categories-msg");
      if (countVisible === 0) {
        if (!noCatMsg) {
          noCatMsg = document.createElement("div");
          noCatMsg.id = "no-categories-msg";
          noCatMsg.style.cssText = "width: 100%; text-align: center; padding: 40px; color: #6c757d;";
          noCatMsg.innerHTML = '<i class="fa-solid fa-folder-open" style="font-size: 2.5rem; margin-bottom: 10px;"></i><p>No hay subcategorías disponibles en este nivel.</p>';
          categoriesGrid.appendChild(noCatMsg);
        }
      } else if (noCatMsg) {
        noCatMsg.remove();
      }

      renderBreadcrumb();
    }

    function renderBreadcrumb() {
      breadcrumb.innerHTML = "";
      navigationHistory.forEach((item, index) => {
        const isLast = index === navigationHistory.length - 1;
        const li = document.createElement("li");
        li.className = `breadcrumb-item ${isLast ? "active" : ""}`;
        
        if (isLast) {
          li.textContent = item.name;
        } else {
          const a = document.createElement("a");
          a.href = "#servicios";
          a.textContent = item.name;
          a.addEventListener("click", function(e) {
            e.preventDefault();
            navigationHistory = navigationHistory.slice(0, index + 1);
            renderCurrentLevel(item.id);
          });
          li.appendChild(a);
        }
        breadcrumb.appendChild(li);
      });
    }

    categoriesGrid.onclick = function(e) {
      const btn = e.target.closest(".view-subcategories-btn");
      if (btn) {
        e.stopPropagation();
        const catId = btn.dataset.id;
        const catName = btn.dataset.name;

        navigationHistory.push({ id: catId, name: catName });
        renderCurrentLevel(catId);
      }
    };

    renderCurrentLevel("root");

    // 4. Filtrado de Productos por Categoría, Marca, Tipo y Búsqueda
    window.filterCategory = function(catSlug) {
      const catSelect = document.getElementById('category-select');
      if (catSelect) {
        catSelect.value = catSlug;
        window.filterProducts();
        
        const tiendaSection = document.getElementById('tienda');
        if (tiendaSection) {
          tiendaSection.scrollIntoView({ behavior: 'smooth' });
        }
      }
    };

    window.filterProducts = function() {
      const searchVal = (document.getElementById('search-input')?.value || '').toLowerCase();
      const selectedCategory = document.getElementById('category-select')?.value || 'all';
      const selectedBrand = document.getElementById('brand-select')?.value || 'all';
      const selectedType = document.getElementById('type-select')?.value || 'all';
      
      const cards = document.querySelectorAll('.product-card');

      cards.forEach(card => {
        const cardCategory = card.dataset.category;
        const cardBrand = card.dataset.brand;
        const cardType = card.dataset.type;
        const cardName = card.dataset.name;

        const matchesCategory = (selectedCategory === 'all' || cardCategory === selectedCategory);
        const matchesBrand = (selectedBrand === 'all' || cardBrand === selectedBrand);
        const matchesType = (selectedType === 'all' || cardType === selectedType);
        const matchesSearch = cardName.includes(searchVal);

        if (matchesCategory && matchesBrand && matchesType && matchesSearch) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    };
  }

  // Compatibilidad con eventos de carga de Rails
  document.addEventListener("DOMContentLoaded", setupLandingScript);
  document.addEventListener("turbo:load", setupLandingScript);
  document.addEventListener("turbolinks:load", setupLandingScript);
</script>