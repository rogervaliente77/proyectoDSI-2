<!-- TOP BAR SUPERIOR -->
<div class="top-bar">
  <div class="top-bar-info">
    <span><i class="fa-solid fa-envelope"></i> <%= @config.company_email rescue '' %></span>
    <span><i class="fa-solid fa-phone"></i> <%= @config.tel rescue ''%></span>
    <a href="<%= @config.wsp_number rescue ''%>" target="_blank" rel="noopener noreferrer">
      <i class="fa-brands fa-whatsapp"></i> WhatsApp
    </a>
    <span><i class="fa-solid fa-location-dot"></i> <%= @config.short_address rescue ''%></span>
  </div>
  <div class="top-bar-social">
    <a href="<%= @config.fb_url rescue '#'%>" target="_blank"><i class="fa-brands fa-facebook-f"></i></a>
    <a href="<%= @config.inst_url rescue '#'%>" target="_blank"><i class="fa-brands fa-instagram"></i></a>
  </div>
</div>

<!-- NAVEGACIÓN PRINCIPAL -->
<nav class="main-nav">
  <div class="logo-container">
    <%= link_to root_path, class: "logo-link" do %>
      <%= image_tag "logo-blanco.png", alt: "Logo Bimers", class: "navbar-logo-img" %>
    <% end %>
  </div>

  <button class="mobile-toggle" id="menu-toggle">
    <i class="fa-solid fa-bars"></i>
  </button>

  <ul class="nav-links" id="nav-menu">
    <li><a href="#">Inicio</a></li>
    <li><a href="#servicios-taller" data-turbo="false" data-turbolinks="false">Servicios de Taller</a></li>
    <li><a href="#tienda" data-turbo="false" data-turbolinks="false">Tienda Online</a></li>
    <li><a href="#contacto" data-turbo="false" data-turbolinks="false">Ubicación & Contacto</a></li>
  </ul>
</nav>

<!-- BOTÓN FLOTANTE DEL CARRITO -->
<div id="floating-cart-btn" class="floating-cart-btn" onclick="toggleCartModal()">
  <i class="fa-solid fa-cart-shopping"></i>
  <span id="floating-cart-count" class="cart-badge">0</span>
</div>

<!-- MODAL / SLIDE-OVER DEL CARRITO -->
<div id="cart-modal-overlay" class="cart-modal-overlay" onclick="toggleCartModal()"></div>
<div id="cart-drawer" class="cart-drawer">
  <div class="cart-drawer-header">
    <h3><i class="fa-solid fa-cart-shopping"></i> Tu Carrito</h3>
    <button class="cart-close-btn" onclick="toggleCartModal()">&times;</button>
  </div>
  
  <div id="cart-drawer-items" class="cart-drawer-items">
    <!-- Se llena dinámicamente con JS -->
  </div>

  <div class="cart-drawer-footer">
    <div class="cart-total-row">
      <span>Total:</span>
      <span id="cart-drawer-total">$0.00</span>
    </div>
    <!-- Al presionar pagar, valida registro -->
    <button id="btn-checkout" class="btn-checkout" onclick="proceedToCheckout()">
      Proceder al Pago <i class="fa-solid fa-arrow-right"></i>
    </button>
  </div>
</div>

<style>
  /* Botón Flotante */
  .floating-cart-btn {
    position: fixed;
    bottom: 25px;
    right: 25px;
    width: 60px;
    height: 60px;
    background-color: #0d6efd;
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
    cursor: pointer;
    z-index: 999;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .floating-cart-btn:hover {
    transform: scale(1.08);
    background-color: #0b5ed7;
  }
  .cart-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    background-color: #dc3545;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #ffffff;
  }

  /* Modal Lateral (Drawer) */
  .cart-modal-overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.5);
    display: none;
    z-index: 1000;
  }
  .cart-drawer {
    position: fixed;
    top: 0; right: -400px;
    width: 380px; max-width: 100%; height: 100%;
    background: #ffffff;
    z-index: 1001;
    box-shadow: -4px 0 15px rgba(0,0,0,0.15);
    display: flex;
    flex-direction: column;
    transition: right 0.3s ease;
  }
  .cart-drawer.open { right: 0; }
  .cart-modal-overlay.open { display: block; }

  .cart-drawer-header {
    padding: 18px 20px;
    background: #0f172a;
    color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .cart-drawer-header h3 { margin: 0; font-size: 1.1rem; }
  .cart-close-btn { background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer; }

  .cart-drawer-items {
    flex: 1;
    overflow-y: auto;
    padding: 15px;
  }
  .cart-item-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid #e2e8f0;
  }
  .cart-item-row img {
    width: 50px; height: 50px; object-fit: cover; border-radius: 6px;
  }
  .cart-item-info { flex: 1; }
  .cart-item-title { font-size: 0.88rem; font-weight: 700; color: #0f172a; margin: 0 0 4px 0; }
  .cart-item-price { font-size: 0.85rem; color: #0d6efd; font-weight: 600; }

  .cart-qty-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .btn-qty {
    background: #e2e8f0;
    border: none;
    width: 24px; height: 24px;
    border-radius: 4px;
    font-weight: bold;
    cursor: pointer;
  }
  .btn-qty:hover { background: #cbd5e1; }

  .cart-drawer-footer {
    padding: 20px;
    border-top: 1px solid #e2e8f0;
    background: #f8fafc;
  }
  .cart-total-row {
    display: flex;
    justify-content: space-between;
    font-size: 1.1rem;
    font-weight: 800;
    margin-bottom: 15px;
    color: #0f172a;
  }
  .btn-checkout {
    width: 100%;
    padding: 12px;
    background: #10b981;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .btn-checkout:hover { background: #059669; }

  .cart-item-details {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: #64748b;
    margin-bottom: 3px;
  }

  .cart-item-qty-badge {
    background-color: #f1f5f9;
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid #e2e8f0;
  }

  .cart-qty-controls .qty-display {
    font-weight: 700;
    font-size: 0.88rem;
    min-width: 18px;
    text-align: center;
    color: #0f172a;
  }
</style>