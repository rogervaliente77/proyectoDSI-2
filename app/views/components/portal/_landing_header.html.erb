<!-- SCRIPT GENERAL DEL CARRITO Y CHECKOUT PARA TODO EL PORTAL -->
<script>
  const STORAGE_KEY = 'bimers_cart_data';

  function getCart() {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    } catch (e) {
      console.error("Error al leer localStorage:", e);
      return [];
    }
  }

  function saveCart(cart) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
    } catch (e) {
      console.error("Error al guardar en localStorage:", e);
    }
    updateUI();
  }

  function changeQty(productId, delta) {
    let cart = getCart();
    const index = cart.findIndex(item => String(item.id) === String(productId));

    if (index > -1) {
      cart[index].qty += delta;
      if (cart[index].qty <= 0) {
        cart.splice(index, 1);
      }
      saveCart(cart);
    }
  }

  function toggleCartModal() {
    document.getElementById('cart-modal-overlay')?.classList.toggle('open');
    document.getElementById('cart-drawer')?.classList.toggle('open');
  }

  function proceedToCheckout() {
    const cart = getCart();
    if (cart.length === 0) {
      alert("Tu carrito está vacío. Agrega algunos productos antes de proceder al pago.");
      return;
    }

    const drawer = document.getElementById('cart-drawer');
    if (drawer && drawer.classList.contains('open')) {
      toggleCartModal();
    }

    const summaryList = document.getElementById('checkout-summary-list');
    const grandTotalElem = document.getElementById('checkout-grand-total');

    if (summaryList) {
      summaryList.innerHTML = cart.map(item => `
        <div class="checkout-summary-item">
          <span>${item.qty}x ${item.name}</span>
          <strong>$${(item.price * item.qty).toFixed(2)}</strong>
        </div>
      `).join('');
    }

    if (grandTotalElem) {
      const grandTotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
      grandTotalElem.textContent = `$${grandTotal.toFixed(2)}`;
    }

    document.getElementById('checkout-modal-overlay')?.classList.add('open');
  }

  function closeCheckoutModal() {
    document.getElementById('checkout-modal-overlay')?.classList.remove('open');
  }

  function selectDeliveryOption(method, element) {
    const parent = element.closest('.options-grid');
    if (parent) {
      parent.querySelectorAll('.option-card').forEach(card => card.classList.remove('active'));
    }
    element.classList.add('active');

    const radio = element.querySelector('input[type="radio"]');
    if (radio) radio.checked = true;

    const addressContainer = document.getElementById('address-field-container');
    if (addressContainer) {
      addressContainer.style.display = (method === 'delivery') ? 'block' : 'none';
    }
  }

  function selectPaymentOption(method, element) {
    const parent = element.closest('.options-grid');
    if (parent) {
      parent.querySelectorAll('.option-card').forEach(card => card.classList.remove('active'));
    }
    element.classList.add('active');

    const radio = element.querySelector('input[type="radio"]');
    if (radio) radio.checked = true;

    const transferInfo = document.getElementById('transfer-details-info');
    if (transferInfo) {
      transferInfo.style.display = (method === 'TRANSFERENCIA') ? 'block' : 'none';
    }
  }

  function confirmPurchase() {
    const cart = getCart();
    if (cart.length === 0) {
      alert("Tu carrito está vacío.");
      return;
    }

    const deliveryMethod = document.querySelector('input[name="delivery_method"]:checked')?.value || 'pickup';
    const paymentMethod = document.querySelector('input[name="payment_method"]:checked')?.value || 'EFECTIVO';
    const shippingAddress = deliveryMethod === 'delivery' ? "<%= j(@client&.direccion) %>" : '';

    if (deliveryMethod === 'delivery' && !shippingAddress.trim()) {
      alert("No tienes una dirección registrada en tu perfil para realizar el envío. Actualiza tus datos.");
      return;
    }

    if (!confirm("¿Estás seguro de que deseas confirmar esta compra?")) {
      return;
    }

    const confirmBtn = document.querySelector('.btn-confirm-order');
    const originalBtnHTML = confirmBtn.innerHTML;
    confirmBtn.disabled = true;
    confirmBtn.style.opacity = "0.7";
    confirmBtn.style.cursor = "not-allowed";
    confirmBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Procesando...`;

    const payload = {
      delivery_method: deliveryMethod,
      payment_method: paymentMethod,
      shipping_address: shippingAddress,
      items: cart.map(item => ({
        product_id: item.id,
        quantity: item.qty,
        unit_price: item.price
      }))
    };

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

    fetch('/portal/cart/checkout', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify(payload)
    })
    .then(response => response.json().then(data => ({ status: response.status, body: data })))
    .then(result => {
      if (result.status === 200 && result.body.success) {
        saveCart([]);
        closeCheckoutModal();
        showSuccessAlert(result.body.code);
      } else {
        alert("Error al procesar la compra: " + (result.body.error || "Inténtalo de nuevo."));
      }
    })
    .catch(error => {
      console.error("Error en la petición de checkout:", error);
      alert("Ocurrió un error inesperado al procesar tu orden.");
    })
    .finally(() => {
      confirmBtn.disabled = false;
      confirmBtn.style.opacity = "1";
      confirmBtn.style.cursor = "pointer";
      confirmBtn.innerHTML = originalBtnHTML;
    });
  }

  function showSuccessAlert(orderCode) {
    let alertOverlay = document.getElementById('success-order-overlay');
    if (!alertOverlay) {
      alertOverlay = document.createElement('div');
      alertOverlay.id = 'success-order-overlay';
      alertOverlay.style.cssText = `
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(5px);
        display: flex; align-items: center; justify-content: center; z-index: 1070;
      `;
      alertOverlay.innerHTML = `
        <div style="background: #ffffff; width: 90%; max-width: 420px; border-radius: 14px; padding: 30px; text-align: center; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.3);">
          <div style="font-size: 3.5rem; color: #10b981; margin-bottom: 15px;">
            <i class="fa-solid fa-circle-check"></i>
          </div>
          <h3 style="color: #0f172a; font-size: 1.3rem; margin-bottom: 10px; font-weight: 800;">¡Pedido Exitoso!</h3>
          <p style="color: #64748b; font-size: 0.92rem; margin-bottom: 20px;">
            Tu orden <strong id="success-code" style="color: #0f172a;"></strong> ha sido registrada correctamente.
          </p>
          <button id="btn-goto-purchases" style="width: 100%; background: #0d6efd; color: #fff; border: none; padding: 12px; border-radius: 8px; font-weight: 700; font-size: 0.95rem; cursor: pointer; transition: background 0.2s;">
            Ver Mis Compras <i class="fa-solid fa-arrow-right" style="margin-left: 6px;"></i>
          </button>
        </div>
      `;
      document.body.appendChild(alertOverlay);
    }

    document.getElementById('success-code').textContent = orderCode;
    alertOverlay.style.display = 'flex';

    document.getElementById('btn-goto-purchases').onclick = function() {
      window.location.href = '/portal/purchases';
    };
  }

  function updateUI() {
    const cart = getCart();
    
    const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
    const badge = document.getElementById('floating-cart-count');
    if (badge) badge.textContent = totalQty;

    document.querySelectorAll('.product-cart-action-box').forEach(box => {
      const productId = String(box.dataset.productId);
      const item = cart.find(i => String(i.id) === productId);

      if (item && item.qty > 0) {
        box.innerHTML = `
          <div class="card-qty-selector">
            <button type="button" class="btn-qty" onclick="changeQty('${productId}', -1)">-</button>
            <span class="qty-num">${item.qty}</span>
            <button type="button" class="btn-qty" onclick="changeQty('${productId}', 1)">+</button>
          </div>
        `;
      } else {
        box.innerHTML = `
          <button class="btn-buy btn-add-to-cart" type="button" aria-label="Agregar al carrito" onclick="handleAddToCart('${productId}')">
            <i class="fa-solid fa-cart-shopping"></i>
          </button>
        `;
      }
    });

    const container = document.getElementById('cart-drawer-items');
    const totalElem = document.getElementById('cart-drawer-total');
    
    if (container) {
      if (cart.length === 0) {
        container.innerHTML = `<p style="text-align:center; color:#64748b; margin-top:30px;">Tu carrito está vacío.</p>`;
      } else {
        container.innerHTML = cart.map(item => {
          const itemSubtotal = (item.price * item.qty).toFixed(2);
          const itemUnitPrice = item.price.toFixed(2);

          return `
            <div class="cart-item-row">
              <img src="${item.img}" alt="${item.name}">
              <div class="cart-item-info">
                <h4 class="cart-item-title">${item.name}</h4>
                <div class="cart-item-details">
                  <span class="cart-item-qty-badge">Cant: <strong>${item.qty}</strong></span>
                  <span class="cart-item-unit-price">($${itemUnitPrice} c/u)</span>
                </div>
                <span class="cart-item-price">$${itemSubtotal}</span>
              </div>
              <div class="cart-qty-controls">
                <button type="button" class="btn-qty" onclick="changeQty('${item.id}', -1)">-</button>
                <span class="qty-display">${item.qty}</span>
                <button type="button" class="btn-qty" onclick="changeQty('${item.id}', 1)">+</button>
              </div>
            </div>
          `;
        }).join('');
      }
    }

    if (totalElem) {
      const grandTotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
      totalElem.textContent = `$${grandTotal.toFixed(2)}`;
    }
  }

  // Inicializadores globales para menú, perfil y carrito en todas las vistas
  (function() {
    function initHeaderScripts() {
      var toggleBtn = document.getElementById('menu-toggle');
      var navMenu = document.getElementById('nav-menu');
      var profileBtn = document.getElementById('profile-dropdown-btn');
      var profileMenu = document.getElementById('profile-dropdown-menu');

      if (toggleBtn && navMenu) {
        toggleBtn.onclick = function(e) {
          e.preventDefault();
          navMenu.classList.toggle('active');
        };

        var links = navMenu.querySelectorAll('a:not(.dropdown-item)');
        links.forEach(function(link) {
          link.onclick = function() {
            navMenu.classList.remove('active');
          };
        });
      }

      if (profileBtn && profileMenu) {
        profileBtn.onclick = function(e) {
          e.stopPropagation();
          profileMenu.classList.toggle('show');
        };

        document.addEventListener('click', function(e) {
          if (!profileBtn.contains(e.target) && !profileMenu.contains(e.target)) {
            profileMenu.classList.remove('show');
          }
        });
      }

      updateUI();
    }

    ['DOMContentLoaded', 'turbo:load', 'turbolinks:load'].forEach(eventName => {
      document.addEventListener(eventName, initHeaderScripts);
    });
  })();
</script>