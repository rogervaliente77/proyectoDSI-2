<!-- TOP BAR SUPERIOR -->
<div class="top-bar">
  <div class="top-bar-info">
    <span><i class="fa-solid fa-envelope"></i> <%= @config.company_email rescue '' %></span>
    <span><i class="fa-solid fa-phone"></i> <%= @config.tel rescue ''%></span>
    <a href="<%= @config.wsp_number rescue ''%>" target="_blank" rel="noopener noreferrer">
      <i class="fa-brands fa-whatsapp"></i> WhatsApp
    </a>
    <span><i class="fa-solid fa-location-dot"></i> <%= @config.short_address rescue ''%></span>
  </div>
  <div class="top-bar-social">
    <a href="<%= @config.fb_url rescue '#'%>" target="_blank"><i class="fa-brands fa-facebook-f"></i></a>
    <a href="<%= @config.inst_url rescue '#'%>" target="_blank"><i class="fa-brands fa-instagram"></i></a>
  </div>
</div>

<!-- NAVEGACIÓN PRINCIPAL -->
<nav class="main-nav">
  <div class="logo-container">
    <%= link_to portal_home_path, class: "logo-link" do %>
      <%= image_tag "logo-blanco.png", alt: "Logo Bimers", class: "navbar-logo-img" %>
    <% end %>
  </div>

  <button class="mobile-toggle" id="menu-toggle" aria-label="Toggle navigation">
    <i class="fa-solid fa-bars"></i>
  </button>

  <ul class="nav-links" id="nav-menu">
    <li><%= link_to "Inicio", portal_home_path, data: { turbo: false } %></li>
    <li><%= link_to "Mis compras", portal_purchases_path, data: { turbo: false } %></li>
    
    <!-- ÁREA DE PERFIL Y DROPDOWN DE USUARIO -->
    <li class="nav-item-profile">
      <div class="profile-dropdown-wrapper">
        <button type="button" class="profile-trigger-btn" id="profile-dropdown-btn">
          <% if current_user.respond_to?(:avatar_url) && current_user.avatar_url.present? %>
            <img src="<%= current_user.avatar_url %>" alt="Avatar" class="profile-avatar-img">
          <% elsif current_user.respond_to?(:avatar) && current_user.avatar.attached? %>
            <%= image_tag current_user.avatar, class: "profile-avatar-img", alt: "Avatar" %>
          <% else %>
            <div class="profile-avatar-placeholder">
              <i class="fa-solid fa-user"></i>
            </div>
          <% end %>
          <span class="profile-username"><%= current_user.try(:first_name) || current_user.try(:name) || "Mi Cuenta" %></span>
          <i class="fa-solid fa-chevron-down profile-arrow"></i>
        </button>

        <div class="profile-dropdown-menu" id="profile-dropdown-menu">
          <% if defined?(portal_users_edit_password_path) %>
            <a href="<%= portal_users_edit_password_path(id: current_user.id) %>" data-turbo="false" class="dropdown-item">
              <i class="fa-solid fa-key"></i> Cambiar contraseña
            </a>
          <% else %>
            <a href="#" class="dropdown-item">
              <i class="fa-solid fa-key"></i> Cambiar contraseña
            </a>
          <% end %>

          <hr class="dropdown-divider">

          <% if defined?(portal_logout_path) %>
            <a href="<%= portal_logout_path %>" 
              data-turbo="false" 
              data-method="put" 
              onclick="event.preventDefault(); document.getElementById('portal-logout-form').submit();" 
              class="dropdown-item dropdown-item-danger">
              <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
            </a>

            <%= form_with url: portal_logout_path, method: :put, id: 'portal-logout-form', html: { style: 'display: none;', data: { turbo: false } } do %>
            <% end %>
          <% else %>
            <a href="#" class="dropdown-item dropdown-item-danger">
              <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
            </a>
          <% end %>
        </div>
      </div>
    </li>
  </ul>
</nav>

<!-- BOTÓN FLOTANTE DEL CARRITO -->
<div id="floating-cart-btn" class="floating-cart-btn" onclick="toggleCartModal()">
  <i class="fa-solid fa-cart-shopping"></i>
  <span id="floating-cart-count" class="cart-badge">0</span>
</div>

<!-- MODAL / SLIDE-OVER DEL CARRITO -->
<div id="cart-modal-overlay" class="cart-modal-overlay" onclick="toggleCartModal()"></div>
<div id="cart-drawer" class="cart-drawer">
  <div class="cart-drawer-header">
    <h3><i class="fa-solid fa-cart-shopping"></i> Tu Carrito</h3>
    <button class="cart-close-btn" onclick="toggleCartModal()">&times;</button>
  </div>
  
  <div id="cart-drawer-items" class="cart-drawer-items">
    <!-- Se llena dinámicamente con JS -->
  </div>

  <div class="cart-drawer-footer">
    <div class="cart-total-row">
      <span>Total:</span>
      <span id="cart-drawer-total">$0.00</span>
    </div>
    <button id="btn-checkout" class="btn-checkout" onclick="proceedToCheckout()">
      Proceder al Pago <i class="fa-solid fa-arrow-right"></i>
    </button>
  </div>
</div>

<!-- MODAL DE FINALIZAR COMPRA (EXTRAÍDO DE HOME) -->
<div id="checkout-modal-overlay" class="checkout-modal-overlay" onclick="closeCheckoutModal()">
  <div class="checkout-modal" onclick="event.stopPropagation()">
    <div class="checkout-header">
      <h3><i class="fa-solid fa-file-invoice-dollar"></i> Finalizar Compra</h3>
      <button type="button" class="close-checkout-btn" onclick="closeCheckoutModal()">&times;</button>
    </div>

    <div class="checkout-body">
      <!-- RESUMEN DE ORDEN -->
      <div class="checkout-section">
        <h4 class="checkout-subtitle"><i class="fa-solid fa-list-check"></i> Resumen de tu Pedido</h4>
        <div id="checkout-summary-list" class="checkout-summary-list">
          <!-- Carga dinámicamente el contenido del carrito -->
        </div>
        <div class="checkout-total-banner">
          <span>Total a pagar:</span>
          <strong id="checkout-grand-total">$0.00</strong>
        </div>
      </div>

      <!-- SELECCIÓN DE MÉTODO DE ENTREGA -->
      <div class="checkout-section">
        <h4 class="checkout-subtitle"><i class="fa-solid fa-truck-ram"></i> Tipo de Entrega</h4>
        <div class="options-grid">
          <label class="option-card active" onclick="selectDeliveryOption('pickup', this)">
            <input type="radio" name="delivery_method" value="pickup" checked style="display:none;">
            <i class="fa-solid fa-warehouse option-icon"></i>
            <div>
              <strong>Recoger en Taller</strong>
              <p>Retiras en nuestro taller en El Salvador.</p>
            </div>
          </label>

          <label class="option-card" onclick="selectDeliveryOption('delivery', this)">
            <input type="radio" name="delivery_method" value="delivery" style="display:none;">
            <i class="fa-solid fa-truck-fast option-icon"></i>
            <div>
              <strong>Envío a Domicilio</strong>
              <p>Recibe tu repuesto directamente en tu casa.</p>
            </div>
          </label>
        </div>

        <div id="address-field-container" class="address-field-container" style="display: none;">
          <label><i class="fa-solid fa-location-dot" style="color: #0284c7;"></i> Dirección de Entrega Registrada:</label>
          <div style="background: #f1f5f9; border: 1px solid #cbd5e1; border-radius: 6px; padding: 10px 12px; font-size: 0.880rem; color: #0f172a; font-weight: 500;">
            <%= @client&.direccion.presence || "No tienes una dirección registrada en tu perfil." %>
          </div>
          <input type="hidden" id="shipping_address" value="<%= @client&.direccion %>">
        </div>
      </div>

      <!-- SELECCIÓN DE MÉTODO DE PAGO -->
      <div class="checkout-section">
        <h4 class="checkout-subtitle"><i class="fa-solid fa-credit-card"></i> Método de Pago</h4>
        <div class="options-grid">
          <label class="option-card active" onclick="selectPaymentOption('EFECTIVO', this)">
            <input type="radio" name="payment_method" value="EFECTIVO" checked style="display:none;">
            <i class="fa-solid fa-money-bill-wave option-icon"></i>
            <div>
              <strong>Efectivo (Pago Contra Entrega)</strong>
              <p>Pagas al recibir o al retirar en taller.</p>
            </div>
          </label>

          <label class="option-card" onclick="selectPaymentOption('TRANSFERENCIA', this)">
            <input type="radio" name="payment_method" value="TRANSFERENCIA" style="display:none;">
            <i class="fa-solid fa-building-columns option-icon"></i>
            <div>
              <strong>Transferencia Bancaria</strong>
              <p>Transferencia inmediata a nuestra cuenta.</p>
            </div>
          </label>
        </div>

        <div id="transfer-details-info" class="transfer-details-info" style="display: none;">
          <div class="bank-alert">
            <i class="fa-solid fa-circle-info"></i>
            <div>
              <strong>Datos de Cuenta Bancaria:</strong>
              <% if @config&.company_bank_account_name.present? || @config&.company_bank_account.present? || @config&.company_bank_account_holder.present? %>
                <p style="margin: 2px 0 0 0; font-size: 0.85rem;">
                  <%= @config.company_bank_account_name %>: <strong><%= @config.company_bank_account %></strong><br>
                  A nombre de: <strong><%= @config.company_bank_account_holder %></strong>
                </p>
              <% else %>
                <p style="margin: 2px 0 0 0; font-size: 0.85rem; color: #64748b;">Sin datos de cuenta bancaria configurados actualmente.</p>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="checkout-footer">
      <button type="button" class="btn-cancel-checkout" onclick="closeCheckoutModal()">Cancelar</button>
      <button type="button" class="btn-confirm-order" onclick="confirmPurchase()">
        <i class="fa-solid fa-circle-check"></i> Confirmar Compra
      </button>
    </div>
  </div>
</div>

