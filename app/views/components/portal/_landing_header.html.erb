<!-- TOP BAR SUPERIOR -->
<div class="top-bar">
  <div class="top-bar-info">
    <span><i class="fa-solid fa-envelope"></i> <%= @config.company_email rescue '' %></span>
    <span><i class="fa-solid fa-phone"></i> <%= @config.tel rescue ''%></span>
    <a href="<%= @config.wsp_number rescue ''%>" target="_blank" rel="noopener noreferrer">
      <i class="fa-brands fa-whatsapp"></i> WhatsApp
    </a>
    <span><i class="fa-solid fa-location-dot"></i> <%= @config.short_address rescue ''%></span>
  </div>
  <div class="top-bar-social">
    <a href="<%= @config.fb_url rescue '#'%>" target="_blank"><i class="fa-brands fa-facebook-f"></i></a>
    <a href="<%= @config.inst_url rescue '#'%>" target="_blank"><i class="fa-brands fa-instagram"></i></a>
  </div>
</div>

<!-- NAVEGACIÓN PRINCIPAL -->
<nav class="main-nav">
  <div class="logo-container">
    <%= link_to portal_home_path, class: "logo-link" do %>
      <%= image_tag "logo-blanco.png", alt: "Logo Bimers", class: "navbar-logo-img" %>
    <% end %>
  </div>

  <button class="mobile-toggle" id="menu-toggle" aria-label="Toggle navigation">
    <i class="fa-solid fa-bars"></i>
  </button>

  <ul class="nav-links" id="nav-menu">
    <li><%= link_to "Inicio", portal_home_path, data: { turbo: false } %></li>
    <li><a href="#tienda" data-turbo="false">Catálogo</a></li>
    <li><a href="#" data-turbo="false">Mis compras</a></li>
    
    <!-- ÁREA DE PERFIL Y DROPDOWN DE USUARIO -->
    <li class="nav-item-profile">
      <div class="profile-dropdown-wrapper">
        <button type="button" class="profile-trigger-btn" id="profile-dropdown-btn">
          <% if current_user.respond_to?(:avatar_url) && current_user.avatar_url.present? %>
            <img src="<%= current_user.avatar_url %>" alt="Avatar" class="profile-avatar-img">
          <% elsif current_user.respond_to?(:avatar) && current_user.avatar.attached? %>
            <%= image_tag current_user.avatar, class: "profile-avatar-img", alt: "Avatar" %>
          <% else %>
            <div class="profile-avatar-placeholder">
              <i class="fa-solid fa-user"></i>
            </div>
          <% end %>
          <span class="profile-username"><%= current_user.try(:first_name) || current_user.try(:name) || "Mi Cuenta" %></span>
          <i class="fa-solid fa-chevron-down profile-arrow"></i>
        </button>

        <div class="profile-dropdown-menu" id="profile-dropdown-menu">
          <a href="<%= defined?(edit_user_registration_path) ? edit_user_registration_path : '#' %>" class="dropdown-item">
            <i class="fa-solid fa-key"></i> Cambiar contraseña
          </a>
          <hr class="dropdown-divider">
          <% if defined?(destroy_user_session_path) %>
            <%= link_to destroy_user_session_path, method: :delete, data: { turbo_method: :delete }, class: "dropdown-item dropdown-item-danger" do %>
              <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
            <% end %>
          <% else %>
            <a href="#" class="dropdown-item dropdown-item-danger">
              <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
            </a>
          <% end %>
        </div>
      </div>
    </li>
  </ul>
</nav>

<!-- BOTÓN FLOTANTE DEL CARRITO -->
<div id="floating-cart-btn" class="floating-cart-btn" onclick="toggleCartModal()">
  <i class="fa-solid fa-cart-shopping"></i>
  <span id="floating-cart-count" class="cart-badge">0</span>
</div>

<!-- MODAL / SLIDE-OVER DEL CARRITO -->
<div id="cart-modal-overlay" class="cart-modal-overlay" onclick="toggleCartModal()"></div>
<div id="cart-drawer" class="cart-drawer">
  <div class="cart-drawer-header">
    <h3><i class="fa-solid fa-cart-shopping"></i> Tu Carrito</h3>
    <button class="cart-close-btn" onclick="toggleCartModal()">&times;</button>
  </div>
  
  <div id="cart-drawer-items" class="cart-drawer-items">
    <!-- Se llena dinámicamente con JS -->
  </div>

  <div class="cart-drawer-footer">
    <div class="cart-total-row">
      <span>Total:</span>
      <span id="cart-drawer-total">$0.00</span>
    </div>
    <button id="btn-checkout" class="btn-checkout" onclick="proceedToCheckout()">
      Proceder al Pago <i class="fa-solid fa-arrow-right"></i>
    </button>
  </div>
</div>

<style>
  /* ==========================================================================
     ESTILOS BASE / ESCRITORIO (PANTALLAS GRANDES >= 992px)
     ========================================================================== */

  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .main-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    font-size: 1.5rem;
    color: #ffffff;
    cursor: pointer;
  }

  @media (min-width: 992px) {
    .nav-links {
      display: flex !important;
      align-items: center !important;
      gap: 15px;
      list-style: none;
      margin: 0;
      padding: 0;
      position: static !important;
      background: transparent !important;
      box-shadow: none !important;
    }

    .nav-links li a {
      color: inherit;
    }
  }

  .nav-links li {
    display: flex;
    align-items: center;
  }

  /* ==========================================================================
     ESTILOS DEL COMPONENTE PERFIL Y DROPDOWN
     ========================================================================== */

  .nav-item-profile {
    position: relative;
  }

  .profile-dropdown-wrapper {
    position: relative;
  }

  .profile-trigger-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 4px 12px 4px 6px;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .profile-trigger-btn:hover {
    background-color: #f8fafc;
    border-color: #cbd5e1;
  }

  .profile-avatar-img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }

  .profile-avatar-placeholder {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: #003399;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
  }

  .profile-username {
    font-size: 0.85rem;
    font-weight: 600;
    color: #0f172a;
  }

  .profile-arrow {
    font-size: 0.7rem;
    color: #64748b;
    transition: transform 0.2s ease;
  }

  .profile-dropdown-menu {
    display: none;
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    width: 200px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    padding: 8px 0;
    z-index: 1000;
  }

  .profile-dropdown-menu.show {
    display: block;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    font-size: 0.85rem;
    color: #334155 !important;
    text-decoration: none !important;
    transition: background 0.2s ease;
  }

  /* Sobrescribir el estilo de hover en la etiqueta <a> y en los íconos internos */
  .profile-dropdown-menu a.dropdown-item:hover,
  .profile-dropdown-menu a.dropdown-item:hover i,
  .profile-dropdown-menu a.dropdown-item:focus,
  .profile-dropdown-menu a.dropdown-item:focus i {
    color: #0f172a !important; /* Texto e icono oscuro */
    background-color: #f1f5f9 !important; /* Fondo suave */
  }

  /* Para el botón de Cerrar Sesión en hover */
  .profile-dropdown-menu a.dropdown-item-danger:hover,
  .profile-dropdown-menu a.dropdown-item-danger:hover i,
  .profile-dropdown-menu a.dropdown-item-danger:focus,
  .profile-dropdown-menu a.dropdown-item-danger:focus i {
    color: #991b1b !important; /* Texto e icono rojo oscuro */
    background-color: #fef2f2 !important; /* Fondo rojo claro */
  }

  .dropdown-divider {
    margin: 6px 0;
    border: 0;
    border-top: 1px solid #e2e8f0;
  }

  /* ==========================================================================
     EXCLUSIVO PARA PANTALLAS PEQUEÑAS (< 992px)
     ========================================================================== */

  @media (max-width: 991px) {
    .top-bar {
      display: none !important;
    }

    .mobile-toggle {
      display: block !important;
      color: #ffffff !important;
    }

    .nav-links {
      display: none;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background-color: #0d1527 !important;
      padding: 20px 0;
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.5);
      z-index: 999;
      margin: 0;
      list-style: none;
    }

    .nav-links.active {
      display: flex !important;
      gap: 12px;
      align-items: center;
    }

    .nav-links li {
      width: 100%;
      text-align: center;
      justify-content: center;
    }

    .nav-links li a:not(.dropdown-item) {
      color: #0c0c0c !important;
      font-size: 0.95rem;
      font-weight: 600;
      text-decoration: none;
      display: block;
      padding: 8px 0;
      width: 100%;
    }

    .nav-item-profile {
      width: 100%;
      display: flex;
      justify-content: center;
    }

    .profile-dropdown-menu {
      right: 50%;
      transform: translateX(50%);
    }
  }

  /* ==========================================================================
     CARRITO Y MODAL LATERAL
     ========================================================================== */

  .floating-cart-btn {
    position: fixed;
    bottom: 25px;
    right: 25px;
    width: 60px;
    height: 60px;
    background-color: #0d6efd;
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
    cursor: pointer;
    z-index: 999;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .floating-cart-btn:hover {
    transform: scale(1.08);
    background-color: #0b5ed7;
  }

  .cart-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    background-color: #dc3545;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #ffffff;
  }

  .cart-modal-overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.5);
    display: none;
    z-index: 1000;
  }

  .cart-drawer {
    position: fixed;
    top: 0; right: -400px;
    width: 380px; max-width: 100%; height: 100%;
    background: #ffffff;
    z-index: 1001;
    box-shadow: -4px 0 15px rgba(0,0,0,0.15);
    display: flex;
    flex-direction: column;
    transition: right 0.3s ease;
  }

  .cart-drawer.open { right: 0; }
  .cart-modal-overlay.open { display: block; }

  .cart-drawer-header {
    padding: 18px 20px;
    background: #0f172a;
    color: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cart-drawer-header h3 { margin: 0; font-size: 1.1rem; }
  .cart-close-btn { background: none; border: none; color: #fff; font-size: 1.5rem; cursor: pointer; }

  .cart-drawer-items {
    flex: 1;
    overflow-y: auto;
    padding: 15px;
  }

  .cart-item-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid #e2e8f0;
  }

  .cart-item-row img {
    width: 50px; height: 50px; object-fit: cover; border-radius: 6px;
  }

  .cart-item-info { flex: 1; }
  .cart-item-title { font-size: 0.88rem; font-weight: 700; color: #0f172a; margin: 0 0 4px 0; }
  .cart-item-price { font-size: 0.85rem; color: #0d6efd; font-weight: 600; }

  .cart-qty-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .btn-qty {
    background: #e2e8f0;
    border: none;
    width: 24px; height: 24px;
    border-radius: 4px;
    font-weight: bold;
    cursor: pointer;
  }

  .btn-qty:hover { background: #cbd5e1; }

  .cart-drawer-footer {
    padding: 20px;
    border-top: 1px solid #e2e8f0;
    background: #f8fafc;
  }

  .cart-total-row {
    display: flex;
    justify-content: space-between;
    font-size: 1.1rem;
    font-weight: 800;
    margin-bottom: 15px;
    color: #0f172a;
  }

  .btn-checkout {
    width: 100%;
    padding: 12px;
    background: #10b981;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .btn-checkout:hover { background: #059669; }

  .cart-item-details {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: #64748b;
    margin-bottom: 3px;
  }

  .cart-item-qty-badge {
    background-color: #f1f5f9;
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid #e2e8f0;
  }

  .cart-qty-controls .qty-display {
    font-weight: 700;
    font-size: 0.88rem;
    min-width: 18px;
    text-align: center;
    color: #0f172a;
  }
</style>

<!-- SCRIPT DE INTERACCIÓN DROPDOWN PERFIL Y MENÚ MÓVIL -->
<script>
  (function() {
    function initHeaderScripts() {
      var toggleBtn = document.getElementById('menu-toggle');
      var navMenu = document.getElementById('nav-menu');
      var profileBtn = document.getElementById('profile-dropdown-btn');
      var profileMenu = document.getElementById('profile-dropdown-menu');

      if (toggleBtn && navMenu) {
        toggleBtn.onclick = function(e) {
          e.preventDefault();
          navMenu.classList.toggle('active');
        };

        var links = navMenu.querySelectorAll('a:not(.dropdown-item)');
        links.forEach(function(link) {
          link.onclick = function() {
            navMenu.classList.remove('active');
          };
        });
      }

      if (profileBtn && profileMenu) {
        profileBtn.onclick = function(e) {
          e.stopPropagation();
          profileMenu.classList.toggle('show');
        };

        document.addEventListener('click', function(e) {
          if (!profileBtn.contains(e.target) && !profileMenu.contains(e.target)) {
            profileMenu.classList.remove('show');
          }
        });
      }
    }

    document.addEventListener('DOMContentLoaded', initHeaderScripts);
    document.addEventListener('turbo:load', initHeaderScripts);
  })();
</script>