<!-- FOOTER COMPLETO Y ORGANIZADO -->
<footer id="contacto">
  <div class="footer-grid">
    <div class="footer-col">
      <div class="logo-container" style="margin-bottom: 15px;">
        <div class="bimers-stripes">
          <div class="stripe cyan"></div>
          <div class="stripe navy"></div>
          <div class="stripe red"></div>
        </div>
        <div class="logo-text">
          <span class="logo-main">BIMERS</span>
          <span class="logo-sub">MOTOR CARS</span>
        </div>
      </div>
      <p>Centro de servicio automotriz especializado. Reparación, mantenimiento preventivo y venta de repuestos importados.</p>
    </div>

    <div class="footer-col">
      <h4>Servicios</h4>
      <ul>
        <% if @config&.footer_services.present? %>
          <% @config.footer_services.split("\n").each do |service_name| %>
            <% next if service_name.blank? %>
            <li>
              <a href="#servicios-taller" data-turbo="false">
                <%= service_name.strip %>
              </a>
            </li>
          <% end %>
        <% else %>
          <!-- Fallback por si el campo está vacío -->
          <li><a href="#servicios-taller" data-turbo="false">Diagnóstico Computarizado</a></li>
          <li><a href="#servicios-taller" data-turbo="false">Mantenimiento de Motor</a></li>
          <li><a href="#servicios-taller" data-turbo="false">Sistema de Frenos ABS</a></li>
          <li><a href="#servicios-taller" data-turbo="false">Alineación y Balanceo 3D</a></li>
        <% end %>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Contacto Info</h4>
      <div class="contact-item">
        <i class="fa-solid fa-phone"></i>
        <div><%= @config.tel%></div>
      </div>
      <div class="contact-item">
        <i class="fa-solid fa-location-dot"></i>
        <div><%= @config.address%></div>
      </div>
    </div>

    <div class="footer-col">
      <h4>Sociales</h4>
      <ul>
        <li><a href="<%= @config.inst_url%>"><i class="fa-brands fa-instagram"></i> Instagram</a></li>
        <li><a href="<%= @config.fb_url%>"><i class="fa-brands fa-facebook"></i> Facebook</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; <%= Time.current.year %> BIMERS Motor Cars. Todos los derechos reservados.</p>
  </div>
</footer>