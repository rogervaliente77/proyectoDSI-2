<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BIMERS MOTOR CARS | Taller Especializado & Repuestos</title>
  
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= stylesheet_link_tag "bimers_catalog", media: "all", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>

  <!-- FontAwesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

  <!-- Renderizado desde app/views/components/landing/_landing_header.html.erb -->
  <%= render "components/landing/landing_header" %>

  <!-- Renderizado de la vista principal app/views/landing/index.html.erb -->
  <%= yield %>

  <!-- Renderizado desde app/views/components/landing/_landing_footer.html.erb -->
  <%= render "components/landing/landing_footer" %>

</body>
</html>