<!-- Inclusión de Librerías del Cliente -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<!-- SheetJS para Excel -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<!-- jsPDF y AutoTable para PDF -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>

<div class="container-fluid">
  <!-- Encabezado -->
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-chart-line text-primary mr-2"></i>Centro de Reportería y Métricas</h1>
  </div>

  <!-- Tarjeta de Controles y Filtros -->
  <div class="card shadow mb-4">
    <div class="card-header py-3 bg-primary text-white">
      <h6 class="m-0 font-weight-bold"><i class="fas fa-filter mr-1"></i> Filtros de Reporte</h6>
    </div>
    <div class="card-body">
      <form id="report-filter-form" class="form-row align-items-end">
        <div class="form-group col-md-3">
          <label class="font-weight-bold text-dark small">Tipo de Reporte:</label>
          <select id="report_type" class="form-control form-control-sm">
            <option value="general">Ventas Generales (Canales)</option>
            <option value="top_products">Top 5 Productos Más Vendidos</option>
            <option value="payment_methods">Desglose por Métodos de Pago</option>
            <option value="logistics">Logística de Entregas (Online)</option>
            <option value="by_cashier">Ventas por Cajero / Usuario</option>
          </select>
        </div>

        <div class="form-group col-md-2">
          <label class="font-weight-bold text-dark small">Canal de Venta:</label>
          <select id="sale_channel" class="form-control form-control-sm">
            <option value="all">Todos los Canales</option>
            <option value="online">Solo En Línea</option>
            <option value="manual">Solo Manuales (Taller)</option>
          </select>
        </div>

        <div class="form-group col-md-2">
          <label class="font-weight-bold text-dark small">Fecha Inicio:</label>
          <input type="date" id="start_date" class="form-control form-control-sm" value="<%= 30.days.ago.to_date %>">
        </div>

        <div class="form-group col-md-2">
          <label class="font-weight-bold text-dark small">Fecha Fin:</label>
          <input type="date" id="end_date" class="form-control form-control-sm" value="<%= Date.today %>">
        </div>

        <div class="form-group col-md-3">
          <button type="submit" class="btn btn-primary btn-sm btn-block shadow-sm">
            <i class="fas fa-search mr-1"></i> Generar Reporte
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Indicador de Carga (Spinner) -->
  <div id="loading-spinner" class="text-center my-5" style="display: none;">
    <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
      <span class="sr-only">Cargando datos...</span>
    </div>
    <p class="mt-2 text-muted font-weight-bold">Procesando métricas...</p>
  </div>

  <!-- Área de Resultados -->
  <div id="report-results" style="display: none;">
    
    <!-- Tarjetas de Resumen KPI y Botones de Exportación -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div class="h5 mb-0 font-weight-bold text-gray-800">Resumen y Exportación</div>
      <div class="btn-group">
        <button id="export-excel-btn" class="btn btn-success btn-sm shadow-sm">
          <i class="fas fa-file-excel mr-1"></i> Exportar a Excel (2 Hojas)
        </button>
        <button id="export-pdf-btn" class="btn btn-danger btn-sm shadow-sm ml-2">
          <i class="fas fa-file-pdf mr-1"></i> Exportar a PDF
        </button>
      </div>
    </div>

    <div class="row mb-4" id="kpi-summary-cards"></div>

    <!-- Pestañas de Visualización: Tabla vs Gráfico -->
    <div class="card shadow mb-4">
      <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary" id="report-title-display">Resultados del Reporte</h6>
        <ul class="nav nav-pills card-header-pills" id="view-tabs" role="tablist">
          <li class="nav-item">
            <a class="nav-link active btn-sm" id="tab-table" data-toggle="tab" href="#content-table" role="tab"><i class="fas fa-table mr-1"></i> Tabla</a>
          </li>
          <li class="nav-item">
            <a class="nav-link btn-sm" id="tab-chart" data-toggle="tab" href="#content-chart" role="tab"><i class="fas fa-chart-bar mr-1"></i> Gráfico</a>
          </li>
        </ul>
      </div>

      <div class="card-body">
        <div class="tab-content">
          <!-- Vista de Tabla -->
          <div class="tab-pane fade show active" id="content-table" role="tabpanel">
            <div class="table-responsive">
              <table class="table table-bordered table-striped align-middle" id="report-table">
                <thead class="thead-dark" id="report-table-head"></thead>
                <tbody id="report-table-body"></tbody>
                <tfoot class="bg-light font-weight-bold border-top border-2" id="report-table-foot"></tfoot>
              </table>
            </div>

            <div id="report-detailed-listing" class="mt-4"></div>
          </div>

          <!-- Vista de Gráfico -->
          <div class="tab-pane fade" id="content-chart" role="tabpanel">
            <div class="chart-area" style="position: relative; height:380px; width:100%">
              <canvas id="myReportChart"></canvas>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  let reportChart = null;
  let currentReportData = null;

  document.addEventListener("DOMContentLoaded", function() {
    const form = document.getElementById("report-filter-form");
    const exportExcelBtn = document.getElementById("export-excel-btn");
    const exportPdfBtn = document.getElementById("export-pdf-btn");

    form.addEventListener("submit", function(e) {
      e.preventDefault();
      fetchReportData();
    });

    // 🔧 Evento para resize del Canvas cuando se selecciona la pestaña de Gráfico
    if (window.jQuery) {
      $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
        if (e.target.id === 'tab-chart' && reportChart) {
          reportChart.resize();
        }
      });
    }

    exportExcelBtn.addEventListener("click", generateExcelReport);
    exportPdfBtn.addEventListener("click", generatePDFReport);

    function fetchReportData() {
      const reportType = document.getElementById("report_type").value;
      const saleChannel = document.getElementById("sale_channel").value;
      const startDate = document.getElementById("start_date").value;
      const endDate = document.getElementById("end_date").value;

      document.getElementById("loading-spinner").style.display = "block";
      document.getElementById("report-results").style.display = "none";

      const url = `/admin/sale_reports/sales_data?report_type=${reportType}&sale_channel=${saleChannel}&start_date=${startDate}&end_date=${endDate}&only_completed=true`;

      fetch(url)
        .then(response => response.json())
        .then(data => {
          currentReportData = data;
          document.getElementById("loading-spinner").style.display = "none";
          document.getElementById("report-results").style.display = "block";

          renderSummaryKPIs(data);
          renderTable(data);
          renderChart(data);
        })
        .catch(err => {
          console.error(err);
          document.getElementById("loading-spinner").style.display = "none";
          alert("Error al obtener los datos del reporte.");
        });
    }

    function renderSummaryKPIs(data) {
      const container = document.getElementById("kpi-summary-cards");
      container.innerHTML = "";

      if (data.summary) {
        container.innerHTML = `
          <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
              <div class="card-body">
                <div class="row no-gutters align-items-center">
                  <div class="col mr-2">
                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Recaudado</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">${data.summary.grand_total}</div>
                  </div>
                  <div class="col-auto"><i class="fas fa-dollar-sign fa-2x text-gray-300"></i></div>
                </div>
              </div>
            </div>
          </div>

          <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
              <div class="card-body">
                <div class="row no-gutters align-items-center">
                  <div class="col mr-2">
                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Total N° Ventas</div>
                    <div class="h5 mb-0 font-weight-bold text-gray-800">${data.summary.total_count}</div>
                  </div>
                  <div class="col-auto"><i class="fas fa-shopping-bag fa-2x text-gray-300"></i></div>
                </div>
              </div>
            </div>
          </div>
        `;
      }
    }

    function renderTable(data) {
      const thead = document.getElementById("report-table-head");
      const tbody = document.getElementById("report-table-body");
      const tfoot = document.getElementById("report-table-foot");
      const detailedContainer = document.getElementById("report-detailed-listing");

      thead.innerHTML = "";
      tbody.innerHTML = "";
      tfoot.innerHTML = "";
      if (detailedContainer) detailedContainer.innerHTML = "";

      if (!data.rows || data.rows.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-4">No se encontraron registros para el rango seleccionado.</td></tr>`;
        return;
      }

      const parseVal = (str) => parseFloat(str.replace(/[^0-9.-]+/g, "")) || 0;
      const fmtRet = (val) => (val > 0 ? `-$${val.toFixed(2)}` : `$0.00`);

      if (data.report_type === "general") {
        thead.innerHTML = `<tr>
          <th>Fecha</th>
          <th class="text-center">Transacciones</th>
          <th class="text-right">Total En Línea</th>
          <th class="text-right">Total Manual</th>
          <th class="text-right">Devoluciones</th>
          <th class="text-right">Total General</th>
        </tr>`;
        
        let sumTx = 0, sumOnline = 0, sumManual = 0, sumReturned = 0, sumTotal = 0;

        data.rows.forEach(r => {
          const retVal = parseVal(r.returned_amount || "$0.00");
          sumTx += r.total_transactions;
          sumOnline += parseVal(r.online_amount);
          sumManual += parseVal(r.manual_amount);
          sumReturned += retVal;
          sumTotal += parseVal(r.total_amount);

          tbody.innerHTML += `<tr>
            <td>${r.date}</td>
            <td class="text-center">${r.total_transactions}</td>
            <td class="text-right">${r.online_amount}</td>
            <td class="text-right">${r.manual_amount}</td>
            <td class="text-right ${retVal > 0 ? 'text-danger font-weight-bold' : 'text-muted'}">${retVal > 0 ? '-' + r.returned_amount : '$0.00'}</td>
            <td class="text-right text-danger font-weight-bold">${fmtRet(sumReturned)}</td>
          </tr>`;
        });

        const sumNet = sumTotal - sumReturned;

        tfoot.innerHTML = `
          <tr>
            <td class="text-uppercase text-dark font-weight-bold">TOTALES BRUTOS / DEVOLUCIONES</td>
            <td class="text-center text-dark">${sumTx}</td>
            <td class="text-right text-dark">$${sumOnline.toFixed(2)}</td>
            <td class="text-right text-dark">$${sumManual.toFixed(2)}</td>
            <td class="text-right text-danger font-weight-bold">-$${sumReturned.toFixed(2)}</td>
            <td class="text-right text-success font-weight-bold">$${sumTotal.toFixed(2)}</td>
          </tr>
          <tr class="table-active">
            <td colspan="5" class="text-right text-uppercase text-dark font-weight-bold">TOTAL NETO (DESCONTANDO DEVOLUCIONES):</td>
            <td class="text-right text-primary font-weight-bold" style="font-size: 1.05rem;">$${sumNet.toFixed(2)}</td>
          </tr>
        `;

        // RENDERIZAR LISTADO DETALLADO AGRUPADO POR FECHA Y TIPO
        if (data.detailed_groups && data.detailed_groups.length > 0 && detailedContainer) {
          let html = `<h5 class="font-weight-bold text-gray-800 mb-3 mt-4"><i class="fas fa-list-alt mr-1"></i> Desglose Detallado de Ventas por Fecha y Tipo</h5>`;
          
          data.detailed_groups.forEach(group => {
            html += `
              <div class="card shadow-sm mb-3 border-left-primary">
                <div class="card-header bg-light py-2">
                  <h6 class="m-0 font-weight-bold text-primary"><i class="far fa-calendar-alt mr-1"></i> Fecha: ${group.date}</h6>
                </div>
                <div class="card-body p-2">
            `;

            group.types.forEach(typeGroup => {
              html += `
                <div class="mb-3">
                  <span class="badge badge-${typeGroup.type_name === 'En Línea' ? 'primary' : 'success'} mb-2 px-2 py-1 font-weight-bold">
                    ${typeGroup.type_name}
                  </span>
                  <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-2" style="font-size: 0.82rem;">
                      <thead class="thead-light">
                        <tr>
                          <th>Código de Venta</th>
                          <th>Cliente</th>
                          <th class="text-center">Estado</th>
                          <th class="text-right">Monto Total</th>
                          <th class="text-right">Devolución</th>
                        </tr>
                      </thead>
                      <tbody>
              `;

              typeGroup.sales.forEach(sale => {
                const retBadge = sale.has_return
                  ? `<span class="text-danger font-weight-bold">-${sale.returned_amount}</span>${sale.return_type ? ` <span class="badge badge-warning text-dark">${sale.return_type}</span>` : ''}`
                  : `<span class="text-muted">$0.00</span>`;

                html += `
                  <tr>
                    <td><strong>${sale.code}</strong></td>
                    <td>${sale.client_name}</td>
                    <td class="text-center"><span class="badge badge-info">${sale.status}</span></td>
                    <td class="text-right font-weight-bold text-success">${sale.total_amount}</td>
                    <td class="text-right">${retBadge}</td>
                  </tr>
                `;
              });

              html += `
                      </tbody>
                    </table>
                  </div>
                </div>
              `;
            });

            html += `
                </div>
              </div>
            `;
          });

          detailedContainer.innerHTML = html;
        }

      } else if (data.report_type === "top_products") {
        thead.innerHTML = `<tr>
          <th>Producto</th>
          <th class="text-center">Unidades Vendidas</th>
          <th class="text-right">Monto Bruto</th>
          <th class="text-right">Devoluciones</th>
          <th class="text-right">Monto Neto</th>
        </tr>`;
        let sumQty = 0, sumSubtotal = 0, sumReturned = 0;

        data.rows.forEach(r => {
          const retVal = parseVal(r.returned_amount || "$0.00");
          const subVal = parseVal(r.subtotal);
          const netVal = parseVal(r.net_subtotal || r.subtotal);

          sumQty += parseFloat(r.quantity) || 0;
          sumSubtotal += subVal;
          sumReturned += retVal;

          const retText = retVal > 0
            ? `${r.returned_amount}${r.returned_qty > 0 ? ` (${r.returned_qty} ud.)` : ''}`
            : '$0.00';

          tbody.innerHTML += `<tr>
            <td>${r.product_name}</td>
            <td class="text-center">${r.quantity}</td>
            <td class="text-right">${r.subtotal}</td>
            <td class="text-right ${retVal > 0 ? 'text-danger font-weight-bold' : 'text-muted'}">${retText}</td>
            <td class="text-right font-weight-bold text-primary">$${netVal.toFixed(2)}</td>
          </tr>`;
        });

        const sumNetTop = sumSubtotal - sumReturned;

        tfoot.innerHTML = `
          <tr>
            <td class="text-uppercase text-dark font-weight-bold">TOTALES TOP 5</td>
            <td class="text-center text-dark">${sumQty}</td>
            <td class="text-right text-dark">$${sumSubtotal.toFixed(2)}</td>
            <td class="text-right text-danger font-weight-bold">-$${sumReturned.toFixed(2)}</td>
            <td class="text-right text-primary font-weight-bold" style="font-size: 1.05rem;">$${sumNetTop.toFixed(2)}</td>
          </tr>
        `;

        // Desglose de ventas por cada producto del Top 5
        if (detailedContainer) {
          let html = `<h5 class="font-weight-bold text-gray-800 mb-3 mt-4"><i class="fas fa-boxes mr-1"></i> Desglose por Venta (Top 5 Productos)</h5>`;

          data.rows.forEach(r => {
            html += `
              <div class="card shadow-sm mb-3 border-left-info">
                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                  <h6 class="m-0 font-weight-bold text-info">${r.product_name}</h6>
                  <span class="badge badge-info">Vendidas: ${r.quantity} uds | Bruto: ${r.subtotal} | Neto: ${r.net_subtotal}</span>
                </div>
                <div class="card-body p-2">
                  <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0" style="font-size: 0.82rem;">
                      <thead class="thead-light">
                        <tr>
                          <th>Código Venta</th>
                          <th>Fecha</th>
                          <th>Cliente</th>
                          <th class="text-center">Canal</th>
                          <th class="text-center">Unidades</th>
                          <th class="text-right">Subtotal</th>
                          <th class="text-right">Devolución</th>
                          <th class="text-right">Neto</th>
                        </tr>
                      </thead>
                      <tbody>
            `;

            (r.breakdown || []).forEach(b => {
              const bRetVal = parseVal(b.returned_amount || "$0.00");
              const bRetHtml = bRetVal > 0
                ? `<span class="text-danger font-weight-bold">-${b.returned_amount}${b.returned_qty > 0 ? ` (${b.returned_qty} ud.)` : ''}</span>`
                : `<span class="text-muted">$0.00</span>`;

              html += `
                <tr>
                  <td><strong>${b.sale_code}</strong></td>
                  <td>${b.date}</td>
                  <td>${b.client_name}</td>
                  <td class="text-center"><span class="badge badge-${b.channel === 'En Línea' ? 'primary' : 'success'}">${b.channel}</span></td>
                  <td class="text-center font-weight-bold">${b.quantity}</td>
                  <td class="text-right">${b.subtotal}</td>
                  <td class="text-right">${bRetHtml}</td>
                  <td class="text-right font-weight-bold text-primary">${b.net_subtotal}</td>
                </tr>
              `;
            });

            html += `
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            `;
          });

          detailedContainer.innerHTML = html;
        }

      } else if (data.report_type === "payment_methods") {
        thead.innerHTML = `<tr>
          <th>Método de Pago</th>
          <th class="text-center">Cantidad de Transacciones</th>
          <th class="text-right">Total Bruto</th>
          <th class="text-right">Devoluciones</th>
          <th class="text-right">Total Neto</th>
        </tr>`;
        let sumCount = 0, sumTotal = 0, sumReturned = 0;

        data.rows.forEach(r => {
          const retVal = parseVal(r.returned_amount || "$0.00");z
          const grossVal = parseVal(r.total);
          const netVal = parseVal(r.net_total || r.total);

          sumCount += r.count;
          sumTotal += grossVal;
          sumReturned += retVal;

          tbody.innerHTML += `<tr>
            <td>${r.method}</td>
            <td class="text-center">${r.count}</td>
            <td class="text-right">${r.total}</td>
            <td class="text-right ${retVal > 0 ? 'text-danger font-weight-bold' : 'text-muted'}">${retVal > 0 ? '' + r.returned_amount : '$0.00'}</td>
            <td class="text-right font-weight-bold text-info">$${netVal.toFixed(2)}</td>
          </tr>`;
        });

        const sumNetPayment = sumTotal - sumReturned;

        tfoot.innerHTML = `
          <tr>
            <td class="text-uppercase text-dark font-weight-bold">TOTALES BRUTOS / DEVOLUCIONES</td>
            <td class="text-center text-dark">${sumCount}</td>
            <td class="text-right text-dark">$${sumTotal.toFixed(2)}</td>
            <td class="text-right text-danger font-weight-bold">-$${sumReturned.toFixed(2)}</td>
            <td class="text-right text-info font-weight-bold">$${sumTotal.toFixed(2)}</td>
          </tr>
          <tr class="table-active">
            <td colspan="4" class="text-right text-uppercase text-dark font-weight-bold">TOTAL NETO (DESCONTANDO DEVOLUCIONES):</td>
            <td class="text-right text-primary font-weight-bold" style="font-size: 1.05rem;">$${sumNetPayment.toFixed(2)}</td>
          </tr>
        `;

        // Desglose de ventas por cada método de pago
        if (detailedContainer) {
          let html = `<h5 class="font-weight-bold text-gray-800 mb-3 mt-4"><i class="fas fa-credit-card mr-1"></i> Desglose de Ventas por Método de Pago</h5>`;

          data.rows.forEach(r => {
            html += `
              <div class="card shadow-sm mb-3 border-left-info">
                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                  <h6 class="m-0 font-weight-bold text-info">${r.method}</h6>
                  <span class="badge badge-info">Tx: ${r.count} | Bruto: ${r.total} | Neto: ${r.net_total || r.total}</span>
                </div>
                <div class="card-body p-2">
                  <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0" style="font-size: 0.82rem;">
                      <thead class="thead-light">
                        <tr>
                          <th>Código Venta</th>
                          <th>Fecha</th>
                          <th>Cliente</th>
                          <th class="text-center">Canal</th>
                          <th class="text-center">Estado</th>
                          <th class="text-right">Monto Bruto</th>
                          <th class="text-right">Devolución</th>
                          <th class="text-right">Monto Neto</th>
                        </tr>
                      </thead>
                      <tbody>
            `;

            (r.sales || []).forEach(s => {
              const sRetVal = parseVal(s.returned_amount || "$0.00");
              const retBadge = s.has_return
                ? `<span class="text-danger font-weight-bold">-${s.returned_amount}</span>${s.return_type ? ` <span class="badge badge-warning text-dark">${s.return_type}</span>` : ''}`
                : `<span class="text-muted">$0.00</span>`;

              html += `
                <tr>
                  <td><strong>${s.sale_code}</strong></td>
                  <td>${s.date}</td>
                  <td>${s.client_name}</td>
                  <td class="text-center"><span class="badge badge-${s.channel === 'En Línea' ? 'primary' : 'success'}">${s.channel}</span></td>
                  <td class="text-center"><span class="badge badge-info">${s.status}</span></td>
                  <td class="text-right">${s.total_amount}</td>
                  <td class="text-right">${retBadge}</td>
                  <td class="text-right font-weight-bold text-info">${s.net_amount || s.total_amount}</td>
                </tr>
              `;
            });

            html += `
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            `;
          });

          detailedContainer.innerHTML = html;
        }

      } else if (data.report_type === "logistics") {
        thead.innerHTML = `<tr>
          <th>Método de Entrega</th>
          <th class="text-center">Total de Pedidos</th>
