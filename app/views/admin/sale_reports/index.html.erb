                          <th class="text-center">Estado</th>
                          <th class="text-right">Monto Bruto</th>
                          <th class="text-right">Devolución</th>
                          <th class="text-right">Monto Neto</th>
                        </tr>
                      </thead>
                      <tbody>
            `;

            (r.sales || []).forEach(s => {
              const sRetVal = parseVal(s.returned_amount || "$0.00");
              const retBadge = s.has_return
                ? `<span class="text-danger font-weight-bold">-${s.returned_amount}</span>${s.return_type ? ` <span class="badge badge-warning text-dark">${s.return_type}</span>` : ''}`
                : `<span class="text-muted">$0.00</span>`;

              html += `
                <tr>
                  <td><strong>${s.sale_code}</strong></td>
                  <td>${s.date}</td>
                  <td>${s.client_name}</td>
                  <td class="text-center"><span class="badge badge-${s.channel === 'En Línea' ? 'primary' : 'success'}">${s.channel}</span></td>
                  <td class="text-center"><span class="badge badge-info">${s.status}</span></td>
                  <td class="text-right">${s.total_amount}</td>
                  <td class="text-right">${retBadge}</td>
                  <td class="text-right font-weight-bold text-success">${s.net_amount || s.total_amount}</td>
                </tr>
              `;
            });

            html += `
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            `;
          });

          detailedContainer.innerHTML = html;
        }
        
      }
    }


    function renderChart(data) {
      const ctx = document.getElementById("myReportChart").getContext("2d");

      if (reportChart) {
        reportChart.destroy();
      }

      let chartType = 'bar';
      if (data.report_type === 'payment_methods' || data.report_type === 'logistics') {
        chartType = 'doughnut';
      }

      reportChart = new Chart(ctx, {
        type: chartType,
        data: data.chart_data,
        options: {
          responsive: true,
          maintainAspectRatio: false,
          animation: false, // Desactivar animación para captura limpia en PDF
          plugins: {
            legend: { position: 'top' }
          }
        }
      });
    }

    // 🟢 EXCEL CON ENCABEZADO Y HOJAS CON DATOS Y MÉTRICAS
    // 🟢 EXCEL GENERADO DESDE EL BACKEND (RAILS / CAXLSX)
    function generateExcelReport() {
      const reportType = document.getElementById("report_type").value;
      const saleChannel = document.getElementById("sale_channel").value;
      const startDate = document.getElementById("start_date").value;
      const endDate = document.getElementById("end_date").value;

      // Redirección directa al endpoint de Rails para descargar el archivo .xlsx
      window.location.href = `/admin/sale_reports/export_excel.xlsx?report_type=${reportType}&sale_channel=${saleChannel}&start_date=${startDate}&end_date=${endDate}`;
    }

    // 🔴 PDF CON ENCABEZADO Y CAPTURA DEL GRÁFICO
    function generatePDFReport() {
      if (!currentReportData || !currentReportData.rows) {
        alert("Primero genera un reporte para poder exportar.");
        return;
      }

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF('p', 'pt', 'letter');

      const title = document.getElementById("report_type").options[document.getElementById("report_type").selectedIndex].text;
      const startDate = document.getElementById("start_date").value;
      const endDate = document.getElementById("end_date").value;
      const generationDate = new Date().toLocaleString();

      // Encabezado
      doc.setFontSize(14);
      doc.setTextColor(40);
      doc.text(title.toUpperCase(), 40, 40);

      doc.setFontSize(9);
      doc.setTextColor(100);
      doc.text(`Fecha de Generación: ${generationDate}`, 40, 54);
      doc.text(`Rango Consultado: ${startDate} al ${endDate}`, 40, 66);

      // Tabla
      doc.autoTable({
        html: "#report-table",
        startY: 80,
        theme: 'grid',
        headStyles: { fillColor: [78, 115, 223] },
        footStyles: { fillColor: [240, 240, 240], textColor: [0, 0, 0], fontStyle: 'bold' }
      });

      // Captura del Gráfico
      if (reportChart) {
        const canvas = document.getElementById("myReportChart");
        const canvasImg = canvas.toDataURL("image/png", 1.0);
        const finalY = doc.lastAutoTable.finalY || 200;

        let imgY = finalY + 30;
        if (imgY + 200 > doc.internal.pageSize.getHeight()) {
          doc.addPage();
          imgY = 40;
        }

        doc.setFontSize(11);
        doc.setTextColor(40);
        doc.text("Gráfico de Resumen:", 40, imgY - 10);
        doc.addImage(canvasImg, 'PNG', 40, imgY, 500, 200);
      }

      const fileName = `Reporte_${currentReportData.report_type}_${new Date().toISOString().slice(0,10)}.pdf`;
      doc.save(fileName);
    }
  });
</script>