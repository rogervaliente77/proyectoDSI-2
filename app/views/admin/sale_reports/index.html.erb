            (r.sales || []).forEach(s => {
              const retBadge = s.has_return
                ? `<span class="text-danger font-weight-bold">-${s.returned_amount}</span>${s.return_type ? ` <span class="badge badge-warning text-dark">${s.return_type}</span>` : ''}`
                : `<span class="text-muted">$0.00</span>`;

              html += `
                <tr>
                  <td><strong>${s.sale_code}</strong></td>
                  <td>${s.date}</td>
                  <td>${s.client_name}</td>
                  <td class="text-center"><span class="badge badge-info">${s.status}</span></td>
                  <td class="text-right">${s.total_amount}</td>
                  <td class="text-right">${retBadge}</td>
                  <td class="text-right font-weight-bold text-primary">${s.net_amount || s.total_amount}</td>
                </tr>
              `;
            });

            html += `
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            `;
          });

          detailedContainer.innerHTML = html;
        }

      } else if (data.report_type === "by_cashier") {
        thead.innerHTML = `<tr>
          <th>Cajero / Usuario</th>
          <th class="text-center">Transacciones Realizadas</th>
          <th class="text-right">Total Bruto</th>
          <th class="text-right">Devoluciones</th>
          <th class="text-right">Total Neto</th>
        </tr>`;
        let sumCount = 0, sumTotal = 0, sumReturned = 0;

        data.rows.forEach(r => {
          const retVal = parseVal(r.returned_amount || "$0.00");
          const grossVal = parseVal(r.total);
          const netVal = parseVal(r.net_total || r.total);

          sumCount += r.count;
          sumTotal += grossVal;
          sumReturned += retVal;

          tbody.innerHTML += `<tr>
            <td>${r.cashier}</td>
            <td class="text-center">${r.count}</td>
            <td class="text-right">${r.total}</td>
            <td class="text-right ${retVal > 0 ? 'text-danger font-weight-bold' : 'text-muted'}">${retVal > 0 ? '-' + r.returned_amount : '$0.00'}</td>
            <td class="text-right font-weight-bold text-success">$${netVal.toFixed(2)}</td>
          </tr>`;
        });

        const sumNetCashier = sumTotal - sumReturned;

        tfoot.innerHTML = `
          <tr>
            <td class="text-uppercase text-dark font-weight-bold">TOTALES BRUTOS / DEVOLUCIONES</td>
            <td class="text-center text-dark">${sumCount}</td>
            <td class="text-right text-dark">$${sumTotal.toFixed(2)}</td>
            <td class="text-right text-danger font-weight-bold">-$${sumReturned.toFixed(2)}</td>
            <td class="text-right text-success font-weight-bold">$${sumTotal.toFixed(2)}</td>
          </tr>
          <tr class="table-active">
            <td colspan="4" class="text-right text-uppercase text-dark font-weight-bold">TOTAL NETO (DESCONTANDO DEVOLUCIONES):</td>
            <td class="text-right text-primary font-weight-bold" style="font-size: 1.05rem;">$${sumNetCashier.toFixed(2)}</td>
          </tr>
        `;

        // Desglose de ventas por cada cajero
        if (detailedContainer) {
          let html = `<h5 class="font-weight-bold text-gray-800 mb-3 mt-4"><i class="fas fa-user-check mr-1"></i> Desglose de Ventas por Cajero / Usuario</h5>`;

          data.rows.forEach(r => {
            html += `
              <div class="card shadow-sm mb-3 border-left-success">
                <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
