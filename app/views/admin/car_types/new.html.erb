<div class="container-fluid">

  <!-- Encabezado -->
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      <i class="fas fa-plus-circle me-2"></i> Crear Tipo de Vehículo
    </h1>
    <%= link_to admin_car_types_path, class: "btn btn-sm btn-outline-secondary shadow-sm", data: { turbo: false } do %>
      <i class="fas fa-arrow-left me-1"></i> Regresar
    <% end %>
  </div>

  <!-- Formulario Card -->
  <div class="card shadow-sm rounded-3 border-0 col-lg-8 col-xl-6 p-0">
    <div class="card-header bg-white py-3">
      <h6 class="m-0 fw-bold text-primary">Información del Tipo de Vehículo</h6>
    </div>
    <div class="card-body p-4">
      <%= render 'form' %>
    </div>
  </div>

</div>