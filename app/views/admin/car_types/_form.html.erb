<%= simple_form_for [:admin, @car_type],
                          html: { 
                            class: "needs-validation", 
                            id: "form-car-type", 
                            novalidate: false, 
                            data: { turbo: false } 
                          } do |form| %>

  <div class="mb-3">
    <%= form.input :name, 
                   label: "Nombre del Tipo (Ej. SEDAN, PICKUP, CAMIONETA)", 
                   required: true, 
                   placeholder: "SEDAN",
                   input_html: { class: "form-control form-control-lg text-uppercase" } %>
  </div>

  <div class="mb-3">
    <%= form.input :description, 
                   as: :text, 
                   label: "Descripción", 
                   required: false,
                   placeholder: "Detalles opcionales o notas sobre este tipo de carrocería...",
                   input_html: { class: "form-control", rows: 3, style: "resize: vertical;" } %>
  </div>

  <div class="d-flex justify-content-start gap-2 pt-2">
    <%= form.submit 'Guardar', class: 'btn btn-success px-4' %>
    <%= link_to 'Cancelar', admin_car_types_path, data: { turbo: false }, class: 'btn btn-secondary px-4' %>
  </div>

<% end %>