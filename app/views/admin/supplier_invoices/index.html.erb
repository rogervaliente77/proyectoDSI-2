<div class="container-fluid min-vh-100 py-4">
  <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-4 gap-2">
    <div>
      <h1 class="h3 text-gray-800 mb-0"><i class="fas fa-file-invoice-dollar me-2 text-primary"></i>Facturas de Proveedores</h1>
      <p class="text-muted small mb-0">Gestión de cuentas por pagar, vencimientos y créditos</p>
    </div>
    <%= link_to new_admin_supplier_invoice_path, class: "btn btn-primary shadow-sm text-nowrap", data: { turbo: false } do %>
      <i class="fas fa-plus me-1"></i> Nueva Factura
    <% end %>
  </div>

  <% if flash[:notice] %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= flash[:notice] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <%# Tarjetas de Estadísticas %>
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-3 bg-white h-100 border-start border-4 border-danger">
        <div class="card-body p-3 d-flex align-items-center justify-content-between">
          <div>
            <span class="text-uppercase text-muted fw-bold small">Deuda Total Pendiente</span>
            <h3 class="mb-0 fw-bold text-danger"><%= number_to_currency(@stats_total_debt) %></h3>
          </div>
          <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger">
            <i class="fas fa-hand-holding-usd fa-2x"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-3 bg-white h-100 border-start border-4 border-warning">
        <div class="card-body p-3 d-flex align-items-center justify-content-between">
          <div>
            <span class="text-uppercase text-muted fw-bold small">Deuda Vencida</span>
            <h3 class="mb-0 fw-bold text-warning"><%= number_to_currency(@stats_overdue_debt) %></h3>
          </div>
          <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
            <i class="fas fa-exclamation-circle fa-2x"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-3 bg-white h-100 border-start border-4 border-info">
        <div class="card-body p-3 d-flex align-items-center justify-content-between">
          <div>
            <span class="text-uppercase text-muted fw-bold small">Por Vencer (Este Mes)</span>
            <h3 class="mb-0 fw-bold text-info"><%= number_to_currency(@stats_due_this_month) %></h3>
          </div>
          <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info">
            <i class="fas fa-calendar-alt fa-2x"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-3 bg-white h-100 border-start border-4 border-success">
        <div class="card-body p-3 d-flex align-items-center justify-content-between">
          <div>
            <span class="text-uppercase text-muted fw-bold small">Pagado Este Mes</span>
            <h3 class="mb-0 fw-bold text-success"><%= number_to_currency(@stats_total_paid_month) %></h3>
          </div>
          <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
            <i class="fas fa-check-double fa-2x"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Formulario de Filtros %>
  <div class="card p-3 mb-4 shadow-sm rounded-3 border-0 bg-white">
    <%= form_with url: admin_supplier_invoices_path, method: :get, local: true, class: "row g-3 align-items-end", data: { turbo: false } do %>
      <div class="col-12 col-md-3">
        <label class="form-label small text-dark fw-semibold"><i class="fas fa-search me-1"></i> Factura / CCF</label>
        <%= text_field_tag :query, params[:query], placeholder: "Ej. FAC-10293...", class: "form-control filter-input w-100" %>
      </div>

      <div class="col-12 col-sm-6 col-md-3">
        <label class="form-label small text-dark fw-semibold"><i class="fas fa-truck me-1"></i> Proveedor</label>
        <%= select_tag :supplier_id, options_from_collection_for_select(@suppliers, :id, :name, params[:supplier_id]), include_blank: "Todos los proveedores", class: "form-select filter-select w-100" %>
      </div>

      <div class="col-12 col-sm-6 col-md-2">
        <label class="form-label small text-dark fw-semibold"><i class="fas fa-filter me-1"></i> Estado</label>
        <%= select_tag :status, options_for_select([["Al Día", "al_dia"], ["Próxima a Vencer", "proxima_vencer"], ["Vencida", "vencida"], ["Pagada", "pagada"]], params[:status]), include_blank: "Todos", class: "form-select filter-select w-100" %>
      </div>

      <div class="col-12 col-md-2">
        <label class="form-label small text-dark fw-semibold"><i class="fas fa-calendar me-1"></i> Desde</label>
        <input type="date" name="start_date" value="<%= params[:start_date] %>" class="form-control filter-input">
      </div>
      <div class="col-12 col-md-2">
        <label class="form-label small text-dark fw-semibold"><i class="fas fa-calendar me-1"></i> Hasta</label>
        <input type="date" name="end_date" value="<%= params[:end_date] %>" class="form-control filter-input">
      </div>

      <div class="col-12 d-flex gap-2 justify-content-end mt-3">
        <%= submit_tag "Aplicar Filtros", class: "btn btn-primary btn-md" %>
        <%= link_to admin_supplier_invoices_path, class: "btn btn-outline-secondary btn-md" do %>
          <i class="fas fa-sync-alt me-1"></i> Limpiar
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Tabla de Registros %>
  <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-dark small text-uppercase fw-bold text-white-50">
            <tr>
              <th class="ps-3">N° Factura / CCF</th>
              <th>Proveedor</th>
              <th>Emisión</th>
              <th>Vencimiento</th>
              <th class="text-center">Cuotas</th>
              <th class="text-end">Monto Total</th>
              <th class="text-end">Abonado</th>
              <th class="text-end">Saldo Pendiente</th>
              <th class="text-center">Estado</th>
              <th class="text-center pe-3">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if @invoices.present? %>
              <% @invoices.each do |inv| %>
                <tr>
                  <td class="ps-3 fw-bold text-dark">
                    <%= link_to inv.invoice_number, admin_supplier_invoice_path(inv), class: "text-decoration-none text-primary" %>
                    <% if inv.voucher_number.present? %>
                      <br><small class="text-muted fw-normal"><%= inv.voucher_number %></small>
                    <% end %>
                  </td>
                  <td>
                    <span class="fw-semibold text-dark"><%= inv.supplier&.name || "N/A" %></span>
                  </td>
                  <td><%= inv.issue_date&.strftime("%d/%m/%Y") %></td>
                  <td>
                    <span class="<%= 'text-danger fw-bold' if inv.status == 'vencida' %>">
                      <%= inv.due_date&.strftime("%d/%m/%Y") %>
                    </span>
                  </td>
                  <td class="text-center">
                    <span class="badge bg-light text-dark border">
                      <%= inv.respond_to?(:payment_installments) && inv.payment_installments.present? ? inv.payment_installments.size : 1 %>
                    </span>
                  </td>
                  <td class="text-end fw-semibold"><%= number_to_currency(inv.total_amount) %></td>
                  <td class="text-end text-success"><%= number_to_currency(inv.paid_amount) %></td>
                  <td class="text-end fw-bold <%= (inv.balance || 0) > 0 ? 'text-danger' : 'text-muted' %>">
                    <%= number_to_currency(inv.balance) %>
                  </td>
                  <td class="text-center">
                    <% case inv.status %>
                    <% when "pagada" %>
                      <span class="badge bg-success-subtle text-success border border-success px-2 py-1">
                        <i class="fas fa-check-circle me-1"></i> Pagada
                      </span>
                    <% when "vencida" %>
                      <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">
                        <i class="fas fa-exclamation-triangle me-1"></i> Vencida
                      </span>
                    <% when "proxima_vencer" %>
                      <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1">
                        <i class="fas fa-clock me-1"></i> Próx. a Vencer
                      </span>
                    <% else %>
                      <span class="badge bg-info-subtle text-info border border-info px-2 py-1">
                        <i class="fas fa-calendar-check me-1"></i> Al Día
                      </span>
                    <% end %>
                  </td>
                  <td class="text-center pe-3">
                    <div class="d-flex gap-1 justify-content-center">
                      <%= link_to admin_supplier_invoice_path(inv), class: "btn btn-light btn-sm border", data: { turbo: false }, title: "Ver Detalle / Abonar" do %>
                        <i class="fas fa-eye text-primary"></i>
                      <% end %>
                      <%= link_to edit_admin_supplier_invoice_path(inv), class: "btn btn-light btn-sm border", data: { turbo: false }, title: "Editar" do %>
                        <i class="fas fa-edit text-secondary"></i>
                      <% end %>
                      <%= link_to admin_supplier_invoice_path(inv), class: "btn btn-light btn-sm border", data: { turbo_method: :delete, turbo_confirm: "¿Eliminar factura?" }, title: "Eliminar" do %>
                        <i class="fas fa-trash text-danger"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="10" class="text-center py-5 text-muted">
                  <i class="fas fa-receipt fa-3x mb-3 text-secondary opacity-50 d-block"></i>
                  No se encontraron facturas registradas.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <%# Paginación %>
    <% if @invoices.present? %>
      <div class="card-footer bg-white d-flex flex-column flex-md-row justify-content-between align-items-center py-3 gap-2">
        <small class="text-muted">
          Mostrando <strong><%= @invoices.offset_value + 1 %></strong> - 
          <strong><%= [@invoices.offset_value + @invoices.length, @total_invoices].min %></strong> 
          de <strong><%= @total_invoices %></strong> registros
        </small>
        
        <div data-turbo="false">
          <%= paginate @invoices %>
        </div>
      </div>
    <% end %>
  </div>
</div>