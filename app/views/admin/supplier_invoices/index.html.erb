<div class="container-fluid min-vh-100 py-4">
  <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-4 gap-2">
    <div>
      <h1 class="h3 text-gray-800 mb-0"><i class="fas fa-file-invoice-dollar me-2 text-primary"></i>Facturas de Proveedores</h1>
      <p class="text-muted small mb-0">Gestión de cuentas por pagar, vencimientos y créditos</p>
    </div>
    <%= link_to new_admin_supplier_invoice_path, class: "btn btn-primary shadow-sm text-nowrap", data: { turbo: false } do %>
      <i class="fas fa-plus me-1"></i> Nueva Factura
    <% end %>
  </div>

  <% if flash[:notice] %>
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
      <%= flash[:notice] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <%# Tarjetas de Estadísticas %>
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-3 bg-white h-100 border-start border-4 border-danger">
        <div class="card-body p-3 d-flex align-items-center justify-content-between">
          <div>
            <span class="text-uppercase text-muted fw-bold small">Deuda Total Pendiente</span>
            <h3 class="mb-0 fw-bold text-danger"><%= number_to_currency(@stats_total_debt) %></h3>
          </div>
          <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger">
            <i class="fas fa-hand-holding-usd fa-2x"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-3 bg-white h-100 border-start border-4 border-warning">
        <div class="card-body p-3 d-flex align-items-center justify-content-between">
          <div>
            <span class="text-uppercase text-muted fw-bold small">Deuda Vencida</span>
            <h3 class="mb-0 fw-bold text-warning"><%= number_to_currency(@stats_overdue_debt) %></h3>
          </div>
          <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning">
            <i class="fas fa-exclamation-circle fa-2x"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-3 bg-white h-100 border-start border-4 border-info">
        <div class="card-body p-3 d-flex align-items-center justify-content-between">
          <div>
            <span class="text-uppercase text-muted fw-bold small">Por Vencer (Este Mes)</span>
            <h3 class="mb-0 fw-bold text-info"><%= number_to_currency(@stats_due_this_month) %></h3>
          </div>
          <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info">
            <i class="fas fa-calendar-alt fa-2x"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm rounded-3 bg-white h-100 border-start border-4 border-success">
        <div class="card-body p-3 d-flex align-items-center justify-content-between">
          <div>
            <span class="text-uppercase text-muted fw-bold small">Pagado Este Mes</span>
            <h3 class="mb-0 fw-bold text-success"><%= number_to_currency(@stats_total_paid_month) %></h3>
          </div>
          <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success">
            <i class="fas fa-check-double fa-2x"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Formulario de Filtros %>
  <div class="card p-3 mb-4 shadow-sm rounded-3 border-0 bg-white">
    <%= form_with url: admin_supplier_invoices_path, method: :get, local: true, class: "row g-3 align-items-end", data: { turbo: false } do %>
      <div class="col-12 col-md-3">
        <label class="form-label small text-dark fw-semibold"><i class="fas fa-search me-1"></i> Factura / CCF / N° Interno</label>
        <%= text_field_tag :query, params[:query], placeholder: "Ej. FAC-10293, INT-001...", class: "form-control filter-input w-100" %>
      </div>

      <div class="col-12 col-sm-6 col-md-3">
        <label class="form-label small text-dark fw-semibold"><i class="fas fa-truck me-1"></i> Proveedor</label>
        <%= select_tag :supplier_id, options_from_collection_for_select(@suppliers, :id, :name, params[:supplier_id]), include_blank: "Todos los proveedores", class: "form-select filter-select w-100" %>
      </div>

      <div class="col-12 col-sm-6 col-md-2">
        <label class="form-label small text-dark fw-semibold"><i class="fas fa-circle me-1"></i> Estado</label>
        <%= select_tag :status, options_for_select([
          ["Al Día", "al_dia"], 
          ["Pago Parcial", "pago_parcial"], 
          ["Próxima a Vencer", "proxima_vencer"], 
          ["Vencida", "vencida"], 
          ["Pagada", "pagada"]
        ], params[:status]), include_blank: "Todos", class: "form-select filter-select w-100" %>
      </div>

      <div class="col-12 col-sm-6 col-md-2">
        <label class="form-label small text-dark fw-semibold"><i class="fas fa-calendar me-1"></i> Desde</label>
        <input type="date" name="start_date" value="<%= params[:start_date] %>" class="form-control filter-input">
      </div>
      <div class="col-12 col-sm-6 col-md-2">
        <label class="form-label small text-dark fw-semibold"><i class="fas fa-calendar me-1"></i> Hasta</label>
        <input type="date" name="end_date" value="<%= params[:end_date] %>" class="form-control filter-input">
      </div>

      <div class="col-12 d-flex gap-2 justify-content-end mt-3">
        <%= submit_tag "Aplicar Filtros", class: "btn btn-primary btn-md" %>
        <%= link_to admin_supplier_invoices_path, class: "btn btn-outline-secondary btn-md" do %>
          <i class="fas fa-sync-alt me-1"></i> Limpiar
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Seccion Contenedora de Facturas %>
  <div class="card border-0 shadow-sm rounded mb-4 overflow-hidden" style="background-color: #f8f9fc;">
    
    <%# Barra Superior / Encabezado de la Sección %>
    <div class="card-header bg-white border-bottom py-3 px-3 d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center">
        <div class="bg-primary text-white rounded p-2 mr-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
          <i class="fas fa-list-alt"></i>
        </div>
        <div>
          <h5 class="mb-0 font-weight-bold text-dark">Listado de Facturas</h5>
          <span class="text-muted small">
            Registros encontrados: <strong><%= @total_invoices || @invoices.size %></strong>
          </span>
        </div>
      </div>

      <div>
        <span class="badge badge-pill badge-light border text-secondary px-3 py-2 d-none d-sm-inline-block">
          <i class="fas fa-filter mr-1 text-primary"></i> Vista Detallada
        </span>
      </div>
    </div>

    <%# Cuerpo con el Listado de Facturas %>
    <div class="card-body p-3">
      <% if @invoices.present? %>
        <% @invoices.each do |inv| %>
          <%# Determinación del color de la barra lateral %>
          <% border_class = if inv.paid?
                              'border-left-success'
                            elsif inv.date_status == 'vencida'
                              'border-left-danger'
                            elsif inv.date_status == 'proxima_vencer'
                              'border-left-warning'
                            elsif inv.payment_status == 'pago_parcial'
                              'border-left-primary'
                            else
                              'border-left-secondary'
                            end %>

          <div class="card border-0 shadow-sm rounded bg-white <%= border_class %> overflow-hidden mb-3">
            <div class="card-body p-3">
              <div class="row align-items-center">
                
                <!-- Columna 1: Números de Control, Proveedor y Badges -->
                <div class="col-12 col-lg-4 mb-3 mb-lg-0 border-right-lg">
                  <div class="d-flex align-items-center mb-1 flex-wrap">
                    <!-- Número Interno -->
                    <span class="badge badge-dark font-weight-bold px-2 py-1 mr-2 mb-1">
                      <i class="fas fa-hashtag mr-1"></i><%= inv.internal_number %>
                    </span>
                    <!-- Número de Factura del Proveedor -->
                    <%= link_to admin_supplier_invoice_path(inv), class: "font-weight-bold text-primary text-decoration-none h6 mb-1 mr-2" do %>
                      <%= inv.invoice_number %>
                    <% end %>
                    <% if inv.voucher_number.present? %>
                      <span class="text-muted small mb-1">(<%= inv.voucher_number %>)</span>
                    <% end %>
                  </div>

                  <!-- Proveedor -->
                  <div class="text-dark font-weight-bold mb-2">
                    <i class="fas fa-truck text-muted mr-1"></i><%= inv.supplier&.name || "N/A" %>
                  </div>

                  <!-- Badges de Estado -->
                  <div class="d-flex flex-wrap">
                    <% case inv.payment_status %>
                    <% when "pagada" %>
                      <span class="badge badge-success px-2 py-1 mr-1 mb-1">
                        <i class="fas fa-check-circle mr-1"></i> Pagada
                      </span>
                    <% when "pago_parcial" %>
                      <span class="badge badge-primary px-2 py-1 mr-1 mb-1">
                        <i class="fas fa-adjust mr-1"></i> Pago Parcial
                      </span>
                    <% when "sin_pago" %>
                      <span class="badge badge-secondary px-2 py-1 mr-1 mb-1">
                        <i class="fas fa-minus-circle mr-1"></i> Sin Pago
                      </span>
                    <% end %>

                    <% unless inv.paid? %>
                      <% case inv.date_status %>
                      <% when "vencida" %>
                        <span class="badge badge-danger px-2 py-1 mr-1 mb-1">
                          <i class="fas fa-exclamation-triangle mr-1"></i> Vencida
                        </span>
                      <% when "proxima_vencer" %>
                        <span class="badge badge-warning text-dark px-2 py-1 mr-1 mb-1">
                          <i class="fas fa-clock mr-1"></i> Próx. a Vencer
                        </span>
                      <% when "al_dia" %>
                        <span class="badge badge-info px-2 py-1 mr-1 mb-1">
                          <i class="fas fa-calendar-check mr-1"></i> Al Día
                        </span>
                      <% end %>
                    <% end %>
                  </div>
                </div>

                <!-- Columna 2: Fechas y Modalidad -->
                <div class="col-12 col-sm-6 col-lg-3 mb-3 mb-lg-0">
                  <div class="small text-muted mb-1">
                    <i class="fas fa-calendar-alt mr-1 text-secondary"></i><strong>Emisión:</strong> <%= inv.issue_date&.strftime("%d/%m/%Y") %>
                  </div>
                  <div class="small text-muted mb-1">
                    <i class="fas fa-hourglass-half mr-1 text-secondary"></i><strong>Vencimiento:</strong> 
                    <% if inv.is_credit %>
                      <span class="<%= 'text-danger font-weight-bold' if inv.date_status == 'vencida' %>">
                        <%= inv.due_date&.strftime("%d/%m/%Y") %>
                      </span>
                    <% else %>
                      <span>N/A (Contado)</span>
                    <% end %>
                  </div>
                  <div class="small text-muted">
                    <i class="fas fa-layer-group mr-1 text-secondary"></i><strong>Modalidad:</strong> 
                    <%= inv.is_credit ? "Crédito" : "Contado" %>
                    <span class="badge badge-light border ml-1">
                      <%= inv.respond_to?(:payment_installments) && inv.payment_installments.present? ? "#{inv.payment_installments.size} cuota(s)" : "1 cuota" %>
                    </span>
                  </div>
                </div>

                <!-- Columna 3: Montos Totales, Abonado y Saldo -->
                <div class="col-12 col-sm-6 col-lg-3 mb-3 mb-lg-0">
                  <div class="d-flex justify-content-between align-items-center mb-1 small">
                    <span class="text-muted">Monto Total:</span>
                    <span class="font-weight-bold text-dark"><%= number_to_currency(inv.total_amount) %></span>
                  </div>
                  <div class="d-flex justify-content-between align-items-center mb-1 small">
                    <span class="text-muted">Abonado:</span>
                    <span class="text-success font-weight-bold"><%= number_to_currency(inv.paid_amount) %></span>
                  </div>
                  <div class="d-flex justify-content-between align-items-center pt-1 border-top">
                    <span class="font-weight-bold small text-dark">Saldo Pendiente:</span>
                    <span class="font-weight-bold h6 mb-0 <%= (inv.balance || 0) > 0 ? 'text-danger' : 'text-muted' %>">
                      <%= number_to_currency(inv.balance) %>
                    </span>
                  </div>
                </div>

                <!-- Columna 4: Botones de Acción -->
                <div class="col-12 col-lg-2 d-flex justify-content-end align-items-end h-100">
                  <div class="btn-group shadow-sm" role="group" aria-label="Acciones">
                    <%= link_to admin_supplier_invoice_path(inv), class: "btn btn-outline-primary btn-sm", data: { turbo: false }, title: "Ver Detalle / Abonar" do %>
                      <i class="fas fa-eye"></i>
                    <% end %>
                    <%= link_to edit_admin_supplier_invoice_path(inv), class: "btn btn-outline-secondary btn-sm", data: { turbo: false }, title: "Editar" do %>
                      <i class="fas fa-edit"></i>
                    <% end %>
                    <%= link_to admin_supplier_invoice_path(inv), class: "btn btn-outline-danger btn-sm", data: { turbo_method: :delete, turbo_confirm: "¿Eliminar factura?" }, title: "Eliminar" do %>
                      <i class="fas fa-trash"></i>
                    <% end %>
                  </div>
                </div>

              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="card border-0 shadow-sm rounded bg-white text-center py-5">
          <div class="card-body">
            <i class="fas fa-receipt fa-3x mb-3 text-secondary" style="opacity: 0.5;"></i>
            <h5 class="text-muted">No se encontraron facturas registradas</h5>
            <p class="text-muted small mb-0">Intenta ajustar los filtros de búsqueda o crea una nueva factura.</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Paginación %>
  <% if @invoices.present? %>
    <div class="card border-0 shadow-sm rounded-3 bg-white d-flex flex-column flex-md-row justify-content-between align-items-center py-2 px-3 gap-2 small">
      <span class="text-muted">
        Mostrando <strong><%= @invoices.offset_value + 1 %></strong> - 
        <strong><%= [@invoices.offset_value + @invoices.length, @total_invoices].min %></strong> 
        de <strong><%= @total_invoices %></strong> registros
      </span>
      
      <div data-turbo="false">
        <%= paginate @invoices %>
      </div>
    </div>
  <% end %>

</div>