<%= form_with(
      model: @invoice, 
      url: @invoice&.new_record? ? admin_supplier_invoices_path : admin_supplier_invoice_path(@invoice), 
      local: true, 
      data: { turbo: false }
) do |f| %>
  <% if @invoice.errors.any? %>
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
      <h6 class="alert-heading fw-bold">
        <i class="fas fa-exclamation-triangle me-2"></i> No se pudo guardar la factura debido a <%= pluralize(@invoice.errors.count, "error", "errores") %>:
      </h6>
      <ul class="mb-0 ps-3">
        <% @invoice.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <!-- Datos Generales de la Factura -->
  <div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-header bg-light py-3">
      <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-file-invoice me-2"></i>Información General de la Factura</h6>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6 mb-3">
          <%= f.label :supplier_id, "Proveedor *", class: "form-label fw-bold" %>
          <%= f.collection_select :supplier_id, Supplier.order_by(name: :asc), :id, :name, { prompt: "Seleccione un Proveedor" }, { class: "form-select", required: true } %>
        </div>

        <div class="col-md-3 mb-3">
          <%= f.label :voucher_type, "Tipo de Comprobante", class: "form-label fw-bold" %>
          <%= f.select :voucher_type, [["Comprobante de Crédito Fiscal (CCF)", "ccf"], ["Factura de Consumidor Final", "factura"], ["Sujeto Excluido", "sujeto_excluido"]], {}, { class: "form-select" } %>
        </div>

        <div class="col-md-3 mb-3">
          <%= f.label :invoice_number, "Número de Factura *", class: "form-label fw-bold" %>
          <%= f.text_field :invoice_number, class: "form-control", placeholder: "Ej. FAC-10294", required: true %>
        </div>

        <div class="col-md-3 mb-3">
          <%= f.label :voucher_number, "Número de CCF / Registro", class: "form-label fw-bold" %>
          <%= f.text_field :voucher_number, class: "form-control", placeholder: "Ej. CCF-88121" %>
        </div>

        <div class="col-md-3 mb-3">
          <%= f.label :issue_date, "Fecha de Emisión *", class: "form-label fw-bold" %>
          <%= f.date_field :issue_date, class: "form-control", required: true, id: "supplier_invoice_issue_date" %>
        </div>

        <!-- Campo de Fecha de Vencimiento Agregado -->
        <div class="col-md-3 mb-3" id="due_date_container">
          <%= f.label :due_date, "Fecha de Vencimiento", class: "form-label fw-bold" %>
          <%= f.date_field :due_date, class: "form-control", id: "supplier_invoice_due_date" %>
        </div>

        <div class="col-md-3 mb-3">
          <%= f.label :total_amount, "Monto Total ($) *", class: "form-label fw-bold" %>
          <%= f.number_field :total_amount, step: "0.01", min: "0.01", class: "form-control", placeholder: "0.00", required: true %>
        </div>

        <div class="col-md-3 mb-3">
          <%= f.label :is_credit, "Modalidad de Pago", class: "form-label fw-bold" %>
          <%= f.select :is_credit, [["Crédito", true], ["Contado", false]], {}, { class: "form-select", id: "supplier_invoice_is_credit" } %>
        </div>

        <div class="col-12 mb-3">
          <%= f.label :description, "Descripción / Detalle de la Compra", class: "form-label fw-bold" %>
          <%= f.text_area :description, rows: 2, class: "form-control", placeholder: "Detalle opcional sobre los bienes o servicios adquiridos..." %>
        </div>
      </div>
    </div>
  </div>

  <!-- Condición de Crédito y Plan de Pagos -->
  <div class="card shadow-sm border-0 rounded-3 mb-4" id="credit_fields_container">
    <div class="card-header bg-light py-3">
      <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-calendar-alt me-2"></i>Condiciones de Crédito y Frecuencia de Pago</h6>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-3 mb-3">
          <%= f.label :term_type, "Frecuencia de Pago", class: "form-label fw-bold" %>
          <%= f.select :term_type, 
                [
                  ['Diario', 'diario'], 
                  ['Semanal', 'semanal'], 
                  ['Mensual', 'mensual'], 
                  ['Bimestral', 'bimestral'], 
                  ['Trimestral', 'trimestral'], 
                  ['Semestral', 'semestral']
                ], 
                {}, { class: "form-select", id: "supplier_invoice_term_type" } %>
        </div>

        <div class="col-md-3 mb-3">
          <%= f.label :installments_count, "Número de Cuotas", class: "form-label fw-bold" %>
          <%= f.number_field :installments_count, min: 1, class: "form-control", id: "supplier_invoice_installments_count" %>
        </div>

        <div class="col-md-3 mb-3" id="payment_day_container">
          <%= f.label :payment_day, "Día Fijo de Pago (1-31)", class: "form-label fw-bold" %>
          <%= f.number_field :payment_day, in: 1..31, class: "form-control", placeholder: "Ej. 15 (opcional)", id: "supplier_invoice_payment_day" %>
          <small class="form-text text-muted">Aplica si se deja vacío usará el día de emisión.</small>
        </div>

        <div class="col-md-3 mb-3" id="credit_term_days_container">
          <%= f.label :credit_term_days, "Días Totales de Plazo", class: "form-label fw-bold" %>
          <%= f.number_field :credit_term_days, class: "form-control", placeholder: "Ej. 30, 60, 90" %>
        </div>
      </div>
    </div>
  </div>

  <div class="d-flex justify-content-end gap-2 mb-4">
    <%= link_to "Cancelar", admin_supplier_invoices_path, class: "btn btn-outline-secondary" %>
    <%= f.submit "Guardar Factura", class: "btn btn-primary px-4" %>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const isCreditSelect = document.getElementById('supplier_invoice_is_credit');
    const creditContainer = document.getElementById('credit_fields_container');
    const dueDateContainer = document.getElementById('due_date_container');
    const termTypeSelect = document.getElementById('supplier_invoice_term_type');
    const paymentDayContainer = document.getElementById('payment_day_container');
    const creditDaysContainer = document.getElementById('credit_term_days_container');

    function toggleCreditFields() {
      const isCredit = isCreditSelect.value === 'true';
      creditContainer.style.display = isCredit ? 'block' : 'none';
      
      // Ocultar/mostrar el campo de fecha de vencimiento según si es Crédito o Contado
      if (dueDateContainer) {
        dueDateContainer.style.display = isCredit ? 'none' : 'block';
      }
    }

    function togglePaymentDay() {
      const term = termTypeSelect.value;
      const requiresPaymentDay = ['mensual', 'bimestral', 'trimestral', 'semestral'].includes(term);
      
      if (requiresPaymentDay) {
        paymentDayContainer.style.display = 'block';
        creditDaysContainer.style.display = 'none';
      } else {
        paymentDayContainer.style.display = 'none';
        creditDaysContainer.style.display = 'block';
        document.getElementById('supplier_invoice_payment_day').value = '';
      }
    }

    if (isCreditSelect) {
      isCreditSelect.addEventListener('change', toggleCreditFields);
      toggleCreditFields();
    }

    if (termTypeSelect) {
      termTypeSelect.addEventListener('change', togglePaymentDay);
      togglePaymentDay();
    }
  });
</script>