<div class="container-fluid">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      Nueva Orden para: <%= @client_car.marca %> <%= @client_car.modelo %> (<%= @client_car.placa %>)
    </h1>
    <%= link_to admin_client_path(@client_car.client), data: { turbo: false }, class: "d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm" do %>
      <i class="fas fa-arrow-left fa-sm text-white-50"></i> Volver al cliente
    <% end %>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card shadow mb-4">
        <div class="card-header py-3">
          <h6 class="m-0 font-weight-bold text-primary">Generación de Cotización / Trabajo</h6>
        </div>
        <div class="card-body">
          <%= render 'form' %>
        </div>
      </div>
    </div>
  </div>
</div>