<div class="container-fluid">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      Editar Orden N° <%= @service_order.numero_orden.presence || @service_order.id %>
    </h1>
    <div>
      <%= link_to admin_service_order_path(@service_order), data: { turbo: false }, class: "btn btn-sm btn-info text-white shadow-sm me-1" do %>
        <i class="fas fa-eye fa-sm me-1"></i> Ver Orden
      <% end %>
      <%= link_to admin_client_path(@service_order.client_car.client), data: { turbo: false }, class: "btn btn-sm btn-secondary shadow-sm" do %>
        <i class="fas fa-arrow-left fa-sm text-white-50 me-1"></i> Volver al Cliente
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card shadow mb-4">
        <div class="card-header py-3 border-left-warning">
          <h6 class="m-0 font-weight-bold text-warning">
            Modificar Datos de la Orden / Cotización (<%= @service_order.client_car.marca %> <%= @service_order.client_car.modelo %> - <%= @service_order.client_car.placa %>)
          </h6>
        </div>
        
        <div class="card-body">
          <% if flash[:alert].present? %>
            <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
              <i class="fas fa-exclamation-triangle me-2"></i>
              <%= flash[:alert] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>

          <% if @service_order.errors.any? %>
            <div class="alert alert-danger shadow-sm mb-4">
              <h5 class="alert-heading h6 fw-bold"><i class="fas fa-ban me-2"></i> Por favor corrige los siguientes errores:</h5>
              <ul class="mb-0 mt-2 style-none" style="font-size: 0.9rem;">
                <% @service_order.errors.full_messages.each do |message| %>
                  <li><i class="fas fa-angle-right me-1 text-danger"></i> <%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= render 'form' %>
        </div>
      </div>
    </div>
  </div>
</div>