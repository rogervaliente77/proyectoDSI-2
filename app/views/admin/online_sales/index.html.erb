<!-- Audio elements para ringtone continuo y campanita corta -->
<audio id="persistent-ringtone" loop>
  <source src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" type="audio/mpeg">
</audio>
<audio id="short-bell">
  <source src="https://assets.mixkit.co/active_storage/sfx/2868/2868-preview.mp3" type="audio/mpeg">
</audio>

<div class="container-fluid">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Admin / Órdenes en Línea</h1>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
          <h6 class="m-0 font-weight-bold text-primary">Gestión y Seguimiento de Pedidos Web</h6>
        </div>

        <div class="card-body">
          <% if flash[:notice] %><div class="alert alert-success"><%= flash[:notice] %></div><% end %>
          <% if flash[:alert] %><div class="alert alert-danger"><%= flash[:alert] %></div><% end %>

          <div class="table-responsive">
            <table class="table table-bordered" id="onlineSalesTable">
              <thead class="thead-light">
                <tr>
                  <th>No</th>
                  <th>Código</th>
                  <th>Cliente</th>
                  <th>Total</th>
                  <th>Pago</th>
                  <th>Entrega</th>
                  <th>Estado Pedido</th>
                  <th>Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% @online_sales.each_with_index do |sale, index| %>
                  <% 
                    is_pending_action = !sale.admin_acknowledged
                    is_pulse = ['pending_payment_comprob', 'pending_check_payment_comprob'].include?(sale.status)
                  %>
                  <tr id="sale-row-<%= sale.id %>" class="<%= 'pulse-animation-row' if is_pulse %>">
                    <td><%= index + 1 %></td>
                    <td>
                      <strong><%= sale.code %></strong>
                      <% if is_pending_action %>
                        <br><button onclick="acknowledgeSale('<%= sale.id %>')" class="btn btn-warning btn-xs mt-1 shadow-sm font-weight-bold" style="font-size: 0.7rem;"><i class="fas fa-bell"></i> Atender / Silenciar</button>
                      <% end %>
                    </td>
                    <td><%= sale.client_name %></td>
                    <td>$<%= '%.2f' % sale.total_amount %></td>
                    <td>
                      <span class="badge badge-<%= sale.payment_status == 'paid' ? 'success' : 'warning' %>">
                        <%= sale.payment_status.titleize %>
                      </span>
                    </td>
                    <td>
                      <span class="badge badge-secondary">
                        <%= sale.delivery_method == 'delivery' ? 'Domicilio' : 'Pickup' %>
                      </span>
                    </td>
                    <td>
                      <span id="badge-status-<%= sale.id %>" class="badge badge-info">
                        <%= sale.status.titleize %>
                      </span>
                    </td>
                    <td>
                      <button type="button" class="btn btn-primary btn-sm shadow-sm" data-toggle="modal" data-target="#timelineModal-<%= sale.id %>">
                        <i class="fas fa-timeline"></i> <span>Ver Estado</span>
                      </button>
                    </td>
                  </tr>

                  <!-- MODAL DE GESTIÓN Y TRANSICIÓN DE ESTADOS -->
                  <div class="modal fade" id="timelineModal-<%= sale.id %>" tabindex="-1" role="dialog" aria-hidden="true">
                    <div class="modal-dialog modal-lg" role="document">
                      <div class="modal-content shadow">
                        <div class="modal-header bg-dark text-white">
                          <h5 class="modal-title font-weight-bold">Seguimiento y Control: <%= sale.code %></h5>
                          <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                          </button>
                        </div>
                        <div class="modal-body">
                          
                          <% if sale.transfer_proof_path.present? %>
                            <div class="mb-4 p-3 bg-light border rounded">
                              <h6 class="font-weight-bold text-dark mb-2"><i class="fas fa-receipt text-primary"></i> Comprobante Subido:</h6>
                              <a href="<%= sale.transfer_proof_path %>" target="_blank" class="btn btn-sm btn-info shadow-sm" data-turbolinks="false">
                                <i class="fas fa-eye"></i> Ver Comprobante
                              </a>
                            </div>
                          <% end %>

                          <div class="timeline-container mb-4">
                            <h6 class="font-weight-bold text-dark mb-3">Historial de Bitácora</h6>
                            <ul class="list-group" id="timeline-list-<%= sale.id %>">
                              <% (sale.status_logs || []).reverse.each do |log| %>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                  <div>
                                    <span class="font-weight-bold text-primary"><%= log['status']&.titleize %></span>
                                    <p class="mb-0 text-muted small"><%= log['comment'] %></p>
                                  </div>
                                  <small class="text-secondary"><%= Time.parse(log['changed_at'].to_s).strftime("%d/%m/%Y %H:%M") %></small>
                                </li>
                              <% end %>
                            </ul>
                          </div>

                          <!-- SELECTOR INTELIGENTE DE ESTADOS -->
                          <div class="p-3 bg-light rounded border">
                            <h6 class="font-weight-bold text-dark mb-2">Avanzar Estado del Pedido</h6>
                            <%= form_with url: update_status_admin_online_sale_path(sale), method: :patch, local: true, class: "form-row align-items-center" do %>
                              <div class="col-md-8 mb-2 mb-md-0">
                                <select name="new_status" class="form-control form-control-sm">
                                  <% if sale.status == 'pending_check_payment_comprob' %>
                                    <option value="payment_approved">Aprobar Pago (Payment Approved)</option>
                                  <% elsif sale.status == 'payment_approved' || sale.status == 'preparing' %>
                                    <% if sale.delivery_method == 'pickup' %>
                                      <option value="pending_to_pickup">Listo para Recoger en Taller (Pending to Pickup)</option>
                                    <% else %>
                                      <option value="preparing">En Preparación (Preparing)</option>
                                      <option value="assigned">Asignar a Mensajero (Assigned)</option>
                                    <% end %>
                                  <% elsif sale.status == 'assigned' %>
                                    <option value="on_route">En Camino (On Route)</option>
                                  <% elsif sale.status == 'on_route' %>
                                    <option value="on_place">En el Lugar de Destino (On Place)</option>
                                  <% elsif sale.status == 'on_place' || sale.status == 'pending_to_pickup' %>
                                    <option value="delivered">Marcar Pagado y Entregado (Delivered)</option>
                                  <% end %>
                                  <option value="cancelled">Cancelar Orden</option>
                                </select>
                              </div>
                              <div class="col-md-4">
                                <button type="submit" class="btn btn-success btn-sm btn-block shadow-sm">Aplicar Cambio</button>
                              </div>
                            <% end %>
                          </div>

                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </tbody>
            </table>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes pulseGlowTable {
    0% { background-color: rgba(254, 243, 199, 0.5); }
    50% { background-color: rgba(254, 193, 7, 0.4); }
    100% { background-color: rgba(254, 243, 199, 0.5); }
  }
  .pulse-animation-row {
    animation: pulseGlowTable 1.5s infinite ease-in-out;
  }
</style>

<div id="toast-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999; display: flex; flex-direction: column; gap: 10px;"></div>

<script src="https://cdn.jsdelivr.net/npm/@rails/actioncable@7.1.2/app/assets/javascripts/actioncable.js"></script>
<script>
  function acknowledgeSale(saleId) {
    fetch(`/admin/online_sales/${saleId}/acknowledge`, {
      method: 'PATCH',
      headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content }
    }).then(response => {
      if (response.ok) {
        localStorage.setItem(`acknowledged_${saleId}`, 'true');
        
        const ringtone = document.getElementById('persistent-ringtone');
        if (ringtone) {
          ringtone.pause();
          ringtone.currentTime = 0;
        }
        window.location.reload();
      }
    });
  }

  document.addEventListener("DOMContentLoaded", function() {
    const ringtone = document.getElementById('persistent-ringtone');
    const shortBell = document.getElementById('short-bell');

    const pendingRows = document.querySelectorAll('.pulse-animation-row');
    if (pendingRows.length > 0 && ringtone) {
      let shouldRing = false;
      
      pendingRows.forEach(row => {
        const saleId = row.id.replace('sale-row-', '');
        if (localStorage.getItem(`acknowledged_${saleId}`) !== 'true') {
          shouldRing = true;
        }
      });

      if (shouldRing) {
        ringtone.play().catch(e => console.log("Audio autoplay bloqueado por políticas del navegador"));
      }
    }

    function showFloatingAlert(title, message, type = 'info') {
      const container = document.getElementById('toast-container');
      if (!container) return;

      const toast = document.createElement('div');
      toast.className = `alert alert-${type} shadow-lg border-left-primary py-2 px-3 m-0`;
      toast.style.minWidth = '300px';
      toast.style.transition = 'all 0.5s ease';
      toast.innerHTML = `
        <div class="d-flex justify-content-between align-items-center">
          <strong><i class="fas fa-bell mr-1"></i> ${title}</strong>
          <button type="button" class="close ml-2" onclick="this.parentElement.parentElement.remove()">&times;</button>
        </div>
        <p class="mb-0 small">${message}</p>
      `;

      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 500);
      }, 60000);
    }

    const consumer = ActionCable.createConsumer();
    consumer.subscriptions.create({ channel: "SaleChannel" }, {
      received(data) {
        if (data.action === "new_sale") {
          if (ringtone) ringtone.play().catch(e => {});
          showFloatingAlert("¡Nueva Orden En Línea!", `Pedido <b>${data.code}</b> por $${parseFloat(data.total_amount || 0).toFixed(2)}`, "warning");
          setTimeout(() => window.location.reload(), 10000);
        } else {
          if (shortBell) shortBell.play().catch(e => {});
          showFloatingAlert("Actualización de Pedido", `La orden ${data.code || ''} cambió de estado.`, "success");
          setTimeout(() => window.location.reload(), 10000);
        }
      }
    });
  });
</script>
