<div class="container-fluid py-4">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      <i class="fas fa-plus-circle me-2 text-primary"></i>Nuevo Tema de Correo
    </h1>
    <%= link_to admin_email_themes_path, class: "btn btn-secondary btn-sm shadow-sm", data: { turbo: false } do %>
      <i class="fas fa-arrow-left me-1"></i> Volver a temas
    <% end %>
  </div>

  <%# Renderiza la partial con el formulario y la vista previa en vivo %>
  <%= render "form", theme: @theme %>
</div>