<div class="container-fluid py-4">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      <i class="fas fa-palette me-2 text-primary"></i>Detalles del Tema: <%= @theme.name %>
    </h1>
    <div class="d-flex gap-2">
      <%= link_to edit_admin_email_theme_path(@theme), class: "btn btn-warning btn-sm shadow-sm", data: { turbo: false } do %>
        <i class="fas fa-edit me-1"></i> Editar Tema
      <% end %>
      <%= link_to admin_email_themes_path, class: "btn btn-secondary btn-sm shadow-sm", data: { turbo: false } do %>
        <i class="fas fa-arrow-left me-1"></i> Volver al listado
      <% end %>
    </div>
  </div>

  <div class="row">
    <!-- Muestra de Colores e Información -->
    <div class="col-lg-5 mb-4">
      <div class="card shadow border-0 mb-4">
        <div class="card-header bg-white py-3">
          <h6 class="m-0 font-weight-bold text-primary">Configuración de Estilos</h6>
        </div>
        <div class="card-body">
          <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span>Color Primario (Borde)</span>
              <div class="d-flex align-items-center">
                <span class="badge rounded-pill me-2" style="background-color: <%= @theme.primary_color %>;">&nbsp;&nbsp;&nbsp;</span>
                <code><%= @theme.primary_color %></code>
              </div>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span>Fondo General</span>
              <div class="d-flex align-items-center">
                <span class="badge rounded-pill me-2 border" style="background-color: <%= @theme.background_color %>;">&nbsp;&nbsp;&nbsp;</span>
                <code><%= @theme.background_color %></code>
              </div>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span>Fondo Tarjeta</span>
              <div class="d-flex align-items-center">
                <span class="badge rounded-pill me-2 border" style="background-color: <%= @theme.card_bg_color %>;">&nbsp;&nbsp;&nbsp;</span>
                <code><%= @theme.card_bg_color %></code>
              </div>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
              <span>Color Texto</span>
              <div class="d-flex align-items-center">
                <span class="badge rounded-pill me-2 border" style="background-color: <%= @theme.text_color %>;">&nbsp;&nbsp;&nbsp;</span>
                <code><%= @theme.text_color %></code>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <!-- Plantillas asociadas a este tema -->
      <div class="card shadow border-0">
        <div class="card-header bg-white py-3">
          <h6 class="m-0 font-weight-bold text-dark">Plantillas que usen este tema</h6>
        </div>
        <div class="card-body p-0">
          <% if @theme.email_templates.any? %>
            <div class="list-group list-group-flush">
              <% @theme.email_templates.each do |template| %>
                <%= link_to admin_email_template_path(template), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center", data: { turbo: false } do %>
                  <span><%= template.name %></span>
                  <i class="fas fa-chevron-right text-muted small"></i>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <p class="text-muted small p-3 mb-0">No hay ninguna plantilla asignada a este tema por el momento.</p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Previsualización Visual -->
    <div class="col-lg-7 mb-4">
      <div class="card shadow border-0">
        <div class="card-header bg-dark text-white py-3">
          <h6 class="m-0 font-weight-bold"><i class="fas fa-desktop me-2"></i>Renderizado de Muestra</h6>
        </div>
        <div class="card-body p-4" style="background-color: <%= @theme.background_color %>; min-height: 400px;">
          <div class="p-4 rounded shadow-sm mx-auto" style="max-width: 600px; background-color: <%= @theme.card_bg_color %>; border-top: 5px solid <%= @theme.primary_color %>; color: <%= @theme.text_color %>;">
            
            <% if @theme.header_html.present? %>
              <div class="mb-3 pb-2 border-bottom">
                <%= @theme.header_html.html_safe %>
              </div>
            <% end %>

            <div class="py-4">
              <h5 class="fw-bold mb-2">Estimado/a Juan Pérez,</h5>
              <p>Este es un texto de ejemplo para observar cómo lucirá la tipografía, el contraste del texto y el fondo asignado al contenedor dentro del correo electrónico.</p>
              <p class="mb-0">Gracias por tu preferencia.</p>
            </div>

            <% if @theme.footer_html.present? %>
              <div class="mt-3 pt-2 border-top">
                <%= @theme.footer_html.html_safe %>
              </div>
            <% end %>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>