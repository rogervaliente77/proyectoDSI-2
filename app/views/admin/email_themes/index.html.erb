<div class="container-fluid py-4">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      <i class="fas fa-palette me-2 text-primary"></i>Temas de Correo
    </h1>
    <%= link_to new_admin_email_theme_path, class: "btn btn-primary shadow-sm", data: { turbo: false } do %>
      <i class="fas fa-plus fa-sm text-white-50 me-1"></i> Nuevo Tema
    <% end %>
  </div>

  <% if notice.present? %>
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
      <i class="fas fa-check-circle me-2"></i><%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <div class="row">
    <% @themes.each do |theme| %>
      <div class="col-md-6 col-lg-4 mb-4">
        <div class="card shadow-sm border-0 h-100">
          <div class="card-header bg-white d-flex align-items-center justify-content-between py-3">
            <h6 class="m-0 font-weight-bold text-dark"><%= theme.name %></h6>
            <span class="badge bg-light text-dark border">
              <%= theme.email_templates.count %> Plantillas
            </span>
          </div>
          
          <!-- Previsualización en tarjeta -->
          <div class="card-body p-3" style="background-color: <%= theme.background_color %>;">
            <div class="p-3 rounded shadow-sm" style="background-color: <%= theme.card_bg_color %>; border-top: 4px solid <%= theme.primary_color %>; color: <%= theme.text_color %>;">
              <div class="border-bottom pb-2 mb-2 small"><%= theme.header_html.to_s.html_safe %></div>
              <p class="small text-muted mb-0" style="font-size: 11px;">[Cuerpo de la plantilla...]</p>
              <div class="border-top pt-2 mt-2 small"><%= theme.footer_html.to_s.html_safe %></div>
            </div>
          </div>

          <div class="card-footer bg-white border-0 d-flex justify-content-end gap-2 py-2">
            <%= link_to edit_admin_email_theme_path(theme), class: "btn btn-sm btn-outline-warning", title: "Editar", data: { turbo: false } do %>
              <i class="fas fa-edit"></i>
            <% end %>
            <%= link_to admin_email_theme_path(theme), data: { turbo_method: :delete, turbo_confirm: "¿Deseas eliminar este tema?" }, class: "btn btn-sm btn-outline-danger", title: "Eliminar" do %>
              <i class="fas fa-trash-alt"></i>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>