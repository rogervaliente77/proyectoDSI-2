<%# app/views/admin/asistencias/reporte_cortes.html.erb %>
<div class="container-fluid">
  <h1 class="h3 mb-4 text-gray-800">Seguimiento de Asistencia para Corte</h1>
  
  <div class="row">
    <% @empleados.each do |emp| %>
      <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
          <div class="card-body">
            <div class="row no-gutters align-items-center">
              <div class="col mr-2">
                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                  <%= emp.full_name %>
                </div>
                <div class="row no-gutters align-items-center">
                  <div class="col-auto">
                    <%# Cálculo en tiempo real %>
                    <% porcentaje = emp.porcentaje_pago_actual * 100 %>
                    <div class="h5 mb-0 mr-3 font-weight-bold text-gray-800"><%= porcentaje.to_i %>%</div>
                  </div>
                  <div class="col">
                    <div class="progress progress-sm mr-2">
                      <div class="progress-bar bg-info" role="progressbar" 
                           style="width: <%= porcentaje %>%" aria-valuenow="<%= porcentaje %>" 
                           aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                  </div>
                </div>
                <small class="text-muted">Corte proyectado: 10/25 del mes</small>
              </div>
              <div class="col-auto">
                <i class="fas fa-calendar-check fa-2x text-gray-300"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>