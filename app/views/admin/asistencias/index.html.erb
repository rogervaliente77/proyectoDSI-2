<div class="container-fluid">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
    <div>
      <h1 class="h3 mb-0 text-gray-800">Control de Asistencia</h1>
      <p class="text-muted mb-0">Empleado: <span class="fw-bold text-primary"><%= @empleado.full_name %></span> (<%= @empleado.cargo_name %>)</p>
    </div>
    <%= link_to admin_empleados_path, class: "btn btn-sm btn-secondary shadow-sm" do %>
      <i class="fas fa-arrow-left me-1"></i> Regresar a Empleados
    <% end %>
  </div>

  <% if flash[:notice] %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= flash[:notice] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <ul class="nav nav-tabs mb-4" id="asistenciaTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= 'active' unless ['calendario', 'preview'].include?(params[:vista]) %>" id="semana-tab" data-bs-toggle="tab" data-bs-target="#semana-pane" type="button" role="tab" aria-controls="semana-pane" aria-selected="<%= !['calendario', 'preview'].include?(params[:vista]) %>">
        <i class="fas fa-calendar-week me-1"></i> Control Semanal (Editar)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= 'active' if params[:vista] == 'calendario' %>" id="calendario-tab" data-bs-toggle="tab" data-bs-target="#calendario-pane" type="button" role="tab" aria-controls="calendario-pane" aria-selected="<%= params[:vista] == 'calendario' %>">
        <i class="fas fa-calendar-alt me-1"></i> Vista Calendario Mensual
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link <%= 'active' if params[:vista] == 'preview' %>" id="preview-tab" data-bs-toggle="tab" data-bs-target="#preview-pane" type="button" role="tab" aria-controls="preview-pane" aria-selected="<%= params[:vista] == 'preview' %>">
        <i class="fas fa-chart-line me-1"></i> Métricas y Preview de Planilla
      </button>
    </li>
  </ul>

  <div class="tab-content" id="asistenciaTabsContent">
    
    <div class="tab-pane fade <%= 'show active' unless ['calendario', 'preview'].include?(params[:vista]) %>" id="semana-pane" role="tabpanel" aria-labelledby="semana-tab">
      <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-3 gap-2">
        <h5 class="mb-0 text-gray-700">Planilla de Registro Quincenal / Semanal</h5>
        <div class="btn-group shadow-sm">
          <%= link_to admin_empleado_asistencias_path(@empleado, fecha: @inicio_semana - 1.week, vista: 'semana'), class: "btn btn-outline-secondary btn-sm" do %>
            <i class="fas fa-chevron-left me-1"></i> Semana Anterior
          <% end %>
          <span class="btn btn-light btn-sm disabled text-dark fw-bold px-3">
            <%= @inicio_semana.strftime("%d/%m/%Y") %> al <%= @fin_semana.strftime("%d/%m/%Y") %>
          </span>
          <%= link_to admin_empleado_asistencias_path(@empleado, fecha: @inicio_semana + 1.week, vista: 'semana'), class: "btn btn-outline-secondary btn-sm" do %>
            Semana Siguiente <i class="fas fa-chevron-right ms-1"></i>
          <% end %>
        </div>
      </div>

      <%= form_with url: actualizar_semana_admin_empleado_asistencias_path(@empleado), method: :post, local: true do |f| %>
        <%= hidden_field_tag :fecha_base, @inicio_semana %>
        
        <div class="card shadow mb-4">
          <div class="table-responsive">
            <table class="table table-hover table-bordered align-middle mb-0">
              <thead class="table-dark">
                <tr>
                  <th style="width: 15%;">Día</th>
                  <th style="width: 15%;">Fecha</th>
                  <th style="width: 20%;">Estado / Tipo de Día</th>
                  <th style="width: 15%;">Hora Entrada</th>
                  <th style="width: 15%;">Hora Salida</th>
                  <th style="width: 20%;">Observaciones / Permisos</th>
                </tr>
              </thead>
              <tbody>
                <% dias_laborales_empleado = @empleado.dias_laborales 
                   hoy = Date.today %>
                <% @dias_semana.each do |dia| %>
                  <% asistencia = @asistencias_hash[dia] || Asistencia.new(fecha: dia)
                     es_futuro = dia > hoy
                     wday_ajustado = (dia.wday == 0) ? 7 : dia.wday
                     es_laboral = dias_laborales_empleado.include?(wday_ajustado)
                     deshabilitado = es_futuro || !es_laboral
                     clase_fila = es_futuro ? "table-light text-muted opacity-75" : (!es_laboral ? "table-warning text-dark font-italic" : "") %>

                  <tr class="<%= clase_fila %>">
                    <td class="fw-bold">
                      <%= t('date.day_names')[dia.wday].capitalize %>
                      <% if !es_laboral %><small class="d-block text-danger font-monospace">(No Laboral)</small><% end %>
                      <% if es_futuro %><small class="d-block text-muted font-monospace">(Futuro)</small><% end %>
                    </td>
                    <td class="text-nowrap"><%= dia.strftime("%d/%m/%Y") %></td>
                    <td>
                      <%= select_tag "asistencias[#{dia}][estado]", 
                          options_for_select(['Asistió', 'Falta', 'Permiso Con Goce', 'Permiso Sin Goce', 'Incapacidad', 'Vacación'], asistencia.estado), 
                          class: "form-select form-control form-control-sm", disabled: deshabilitado %>
                    </td>
                    <td>
                      <input type="time" name="asistencias[<%= dia %>][hora_entrada]" value="<%= asistencia.hora_entrada&.strftime('%H:%M') %>" class="form-control form-control-sm" <%= 'disabled' if deshabilitado %>>
                    </td>
                    <td>
                      <input type="time" name="asistencias[<%= dia %>][hora_salida]" value="<%= asistencia.hora_salida&.strftime('%H:%M') %>" class="form-control form-control-sm" <%= 'disabled' if deshabilitado %>>
                    </td>
                    <td>
                      <input type="text" name="asistencias[<%= dia %>][observaciones]" value="<%= asistencia.observaciones %>" placeholder="<%= !es_laboral ? 'Día de descanso asignado' : 'Ej: Permiso médico' %>" class="form-control form-control-sm" <%= 'disabled' if deshabilitado %>>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <div class="card-footer text-end bg-light">
            <%= f.submit "Guardar Cambios de la Semana", class: "btn btn-success shadow-sm btn-sm px-4" %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="tab-pane fade <%= 'show active' if params[:vista] == 'calendario' %>" id="calendario-pane" role="tabpanel" aria-labelledby="calendario-tab">
      <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-3 gap-2">
        <h5 class="mb-0 text-gray-700">Monitoreo General: <span class="text-capitalize text-primary fw-bold"><%= l(@mes_base, format: "%B %Y") %></span></h5>
        <div class="btn-group shadow-sm">
          <%= link_to admin_empleado_asistencias_path(@empleado, mes: @mes_base - 1.month, vista: 'calendario'), class: "btn btn-outline-secondary btn-sm" do %>
            <i class="fas fa-chevron-left me-1"></i> Mes Anterior
          <% end %>
          <%= link_to admin_empleado_asistencias_path(@empleado, mes: @mes_base + 1.month, vista: 'calendario'), class: "btn btn-outline-secondary btn-sm" do %>
            Mes Siguiente <i class="fas fa-chevron-right ms-1"></i>
          <% end %>
        </div>
      </div>

      <div class="card shadow border-0 overflow-hidden mb-4">
        <div class="table-responsive">
          <table class="table table-bordered m-0 text-center" style="table-layout: fixed; width: 100%; min-width: 700px;">
            <thead class="table-dark">
              <tr>
                <th style="width: 14.28%;">Lunes</th>
                <th style="width: 14.28%;">Martes</th>
                <th style="width: 14.28%;">Miércoles</th>
                <th style="width: 14.28%;">Jueves</th>
                <th style="width: 14.28%;">Viernes</th>
                <th style="width: 14.28%;">Sábado</th>
                <th style="width: 14.28%;">Domingo</th>
              </tr>
            </thead>
            <tbody>
              <% @todas_semanas_mes.each do |semana| %>
                <tr style="min-height: 110px; height: 110px;">
                  <% semana.each do |dia| %>
                    <% asistencia = @asistencias_mes_hash[dia]
                       fuera_de_mes = dia.month != @mes_base.month
                       bg_box = "bg-white"
                       badge_color = "badge bg-light text-dark shadow-sm"
                       if fuera_de_mes
                         bg_box = "bg-light text-muted opacity-50"
                       elsif asistencia.present?
                         case asistencia.estado
                         when 'Asistió'
                           bg_box = "bg-success-subtle text-success-emphasis"
                           badge_color = "badge bg-success shadow-sm"
                         when 'Falta'
                           bg_box = "bg-danger-subtle text-danger-emphasis"
                           badge_color = "badge bg-danger shadow-sm"
                         when 'Permiso Con Goce', 'Permiso Sin Goce', 'Incapacidad', 'Vacación'
                           bg_box = "bg-info-subtle text-info-emphasis"
                           badge_color = "badge bg-info text-dark shadow-sm"
                         end
                       end %>
                    <td class="<%= bg_box %> p-2 text-start align-top position-relative h-100">
                      <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold fs-6 <%= 'text-muted' if fuera_de_mes %>"><%= dia.day %></span>
                        <% if dia == Date.today %><span class="badge bg-primary text-white" style="font-size: 0.65rem;">Hoy</span><% end %>
                      </div>
                      <% if asistencia.present? && !fuera_de_mes %>
                        <div class="mt-2">
                          <span class="<%= badge_color %> d-block text-truncate text-center py-1 w-100" style="font-size: 0.72rem;" title="<%= asistencia.estado %>"><%= asistencia.estado %></span>
                          <% if asistencia.hora_entrada.present? %>
                            <small class="d-block text-muted text-center mt-1" style="font-size: 0.68rem; font-weight: 500;"><i class="far fa-clock me-1"></i><%= asistencia.hora_entrada.strftime("%I:%M%p") %></small>
                          <% end %>
                        </div>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="tab-pane fade <%= 'show active' if params[:vista] == 'preview' %>" id="preview-pane" role="tabpanel" aria-labelledby="preview-tab">
      
      <div class="card shadow-sm mb-4 bg-light border-0">
        <div class="card-body">
          <%= form_with url: admin_empleado_asistencias_path(@empleado), method: :get, local: true, class: "row g-3 align-items-end" do %>
            <%= hidden_field_tag :vista, 'preview' %>
            <div class="col-sm-4">
              <label class="form-label fw-bold text-secondary fs-7">Fecha Inicio Consulta</label>
              <%= date_field_tag :fecha_inicio_preview, @fecha_inicio_preview, class: "form-control form-control-sm border-secondary" %>
            </div>
            <div class="col-sm-4">
              <label class="form-label fw-bold text-secondary fs-7">Fecha Fin Consulta</label>
              <%= date_field_tag :fecha_fin_preview, @fecha_fin_preview, class: "form-control form-control-sm border-secondary" %>
            </div>
            <div class="col-sm-4">
              <button type="submit" class="btn btn-primary btn-sm w-100 shadow-sm">
                <i class="fas fa-search me-1"></i> Calcular Vista Previa de Asistencia
              </button>
            </div>
          <% end %>
        </div>
      </div>

      <div class="row mb-4">
        <div class="col-md-4 mb-3">
          <div class="card shadow h-100 border-start border-4 border-success p-3">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <span class="text-xs text-uppercase fw-bold text-success d-block mb-1">Rendimiento de Asistencia</span>
                <span class="h3 fw-bold text-gray-800"><%= @porcentaje_asistencia %>%</span>
              </div>
              <i class="fas fa-percentage fa-2x text-gray-300"></i>
            </div>
            <div class="progress mt-3" style="height: 6px;">
              <div class="progress-bar bg-success" role="progressbar" style="width: <%= @porcentaje_asistencia %>%"></div>
            </div>
            <small class="text-muted mt-2 d-block">Asistió a <strong><%= @asistencias_efectivas %></strong> de <strong><%= @dias_que_debio_asistir %></strong> días que le correspondían.</small>
          </div>
        </div>

        <div class="col-md-4 mb-3">
          <% 
            excede_gracia = @total_minutos_retraso_periodo > @limite_gracia
            color_retraso = excede_gracia ? "danger" : "warning"
          %>
          <div class="card shadow h-100 border-start border-4 border-<%= color_retraso %> p-3">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <span class="text-xs text-uppercase fw-bold text-<%= color_retraso %> d-block mb-1">Bolsa de Minutos Tarde</span>
                <span class="h3 fw-bold text-gray-800"><%= @total_minutos_retraso_periodo %> min</span>
              </div>
              <i class="fas fa-stopwatch fa-2x text-gray-300"></i>
            </div>
            <div class="progress mt-3" style="height: 6px;">
              <% porc_gracia = [((@total_minutos_retraso_periodo.to_f / @limite_gracia) * 100), 100].min %>
              <div class="progress-bar bg-<%= color_retraso %>" role="progressbar" style="width: <%= porc_gracia %>%"></div>
            </div>
            <small class="text-muted mt-2 d-block">
              <% if excede_gracia %>
                <span class="text-danger fw-bold"><i class="fas fa-exclamation-triangle me-1"></i>Excedió por <%= @total_minutos_retraso_periodo - @limite_gracia %> mins</span> la gracia permitida (<%= @limite_gracia %> min).
              <% else %>
                <span class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i>A salvo</span>, le restan <%= @limite_gracia - @total_minutos_retraso_periodo %> mins de tolerancia general.
              <% end %>
            </small>
          </div>
        </div>

        <div class="col-md-4 mb-3">
          <div class="card shadow h-100 border-start border-4 border-danger p-3">
            <div class="d-flex align-items-center justify-content-between">
              <div>
                <span class="text-xs text-uppercase fw-bold text-danger d-block mb-1">Días de Falta/Inasistencia</span>
                <span class="h3 fw-bold text-gray-800"><%= @faltas_detectadas %> días</span>
              </div>
              <i class="fas fa-user-times fa-2x text-gray-300"></i>
            </div>
            <small class="text-muted mt-4 d-block">Estos días se descontarán en su totalidad de manera ordinaria al procesar la planilla final.</small>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-100">
          <div class="card shadow mb-4">
            <div class="card-header bg-white py-3">
              <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-chart-bar me-1"></i>Historial del Consumo de Minutos Tarde vs Salidas Tempranas</h6>
            </div>
            <div class="card-body">
              <% if @fechas_grafica.any? %>
                <div style="position: relative; height:300px; width:100%">
                  <canvas id="retrasosChart"></canvas>
                </div>
              <% else %>
                <div class="text-center py-5 text-muted">
                  <i class="fas fa-star fa-2x text-warning mb-2"></i>
                  <p class="mb-0">¡Excelente! El empleado no registra retrasos de entrada ni salidas anticipadas en este rango de fechas.</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    <% if @fechas_grafica.any? %>
      var ctx = document.getElementById('retrasosChart').getContext('2d');
      var retrasosChart = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: <%= raw @fechas_grafica.to_json %>,
          datasets: [
            {
              label: 'Minutos Tarde (Entrada)',
              data: <%= raw @valores_grafica_entrada.to_json %>,
              backgroundColor: 'rgba(231, 74, 59, 0.75)',
              borderColor: 'rgba(231, 74, 59,  1)',
              borderWidth: 1
            },
            {
              label: 'Minutos Salida Anticipada',
              data: <%= raw @valores_grafica_salida.to_json %>,
              backgroundColor: 'rgba(246, 194, 62, 0.75)',
              borderColor: 'rgba(246, 194, 62, 1)',
              borderWidth: 1
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true,
              title: {
                display: true,
                text: 'Cantidad de Minutos'
              }
            },
            x: {
              title: {
                display: true,
                text: 'Días de Asistencia Registrados'
              }
            }
          },
          plugins: {
            legend: {
              position: 'top',
            }
          }
        }
      });
    <% end %>
  });
</script>