<!-- Begin Page Content -->
<div class="container-fluid min-vh-100 py-4">
  <!-- Page Heading -->
  <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-4 gap-2 gap-md-3">
    <h1 class="h3 text-gray-800 mb-0">Admin / Categorías de producto</h1>
    <%= link_to new_admin_category_path, data: { turbo: false }, class: "btn btn-primary shadow-sm text-nowrap flex-shrink-0" do %>
      <i class="fas fa-plus me-1"></i> Crear Categoría
    <% end %>
  </div>

  <!-- Card Principal con Pestañas -->
  <div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <h6 class="m-0 fw-bold text-primary">Gestión de Categorías</h6>
      
      <!-- Navegación de Pestañas (Tabs) Responsiva -->
      <ul class="nav nav-pills card-header-pills w-100 w-md-auto flex-column flex-sm-row gap-2 gap-sm-0" id="categoryTabs" role="tablist">
        <li class="nav-item me-sm-1" role="presentation">
          <button class="nav-link active w-100" id="table-tab" data-bs-toggle="tab" data-bs-target="#table-view" type="button" role="tab" aria-controls="table-view" aria-selected="true">
            <i class="fas fa-list me-1"></i> Vista Tabla
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link w-100" id="cards-tab" data-bs-toggle="tab" data-bs-target="#cards-view" type="button" role="tab" aria-controls="cards-view" aria-selected="false">
            <i class="fas fa-th-large me-1"></i> Vista Tarjetas
          </button>
        </li>
      </ul>
    </div>

    <!-- Card Body -->
    <div class="card-body p-3 p-md-4">
      <% if flash[:notice] %>
        <div class="alert alert-success rounded-3 mb-4"><%= flash[:notice] %></div>
      <% elsif flash[:alert] %>
        <div class="alert alert-danger rounded-3 mb-4"><%= sanitize(flash[:alert]) %></div>
      <% end %>

      <div class="tab-content" id="categoryTabsContent">
        
        <!-- ================= TAB 1: VISTA DE TABLA ================= -->
        <div class="tab-pane fade show active" id="table-view" role="tabpanel" aria-labelledby="table-tab">
          <div class="table-responsive">
            <table class="table table-bordered align-middle" id="categoriesTable">
              <thead class="thead-light">
                <tr>
                  <th style="width: 80px;">Imagen</th>
                  <th>Nombre</th>
                  <th>Depende de</th>
                  <th>Descripción</th>
                  <th>Creado en</th>
                  <th style="width: 120px;">Acción</th>
                </tr>
              </thead>
              <tbody>
                <% @categories.each do |category| %>
                  <tr>
                    <td class="text-center">
                      <% if category.image_url.present? %>
                        <%= image_tag category.image_url, class: "rounded", style: "width: 50px; height: 50px; object-fit: cover;" %>
                      <% else %>
                        <span class="badge bg-light text-secondary border">Sin foto</span>
                      <% end %>
                    </td>
                    <td class="fw-bold"><%= category.name %></td>
                    <td>
                      <% if category.parent.present? %>
                        <span class="badge bg-info text-dark">
                          <i class="fas fa-folder me-1"></i><%= category.parent.name %>
                        </span>
                      <% else %>
                        <span class="badge bg-secondary">Categoría Principal</span>
                      <% end %>
                    </td>
                    <td><%= category.description %></td>
                    <td><%= category.created_at.strftime("%d/%m/%Y") if category.created_at %></td>
                    <td>
                      <div class="d-flex flex-nowrap gap-1">
                        <%= link_to edit_admin_category_path(category), class: "btn btn-primary btn-sm", data: { turbo: false } do %>
                          <i class="fa fa-edit" title="Editar"></i> 
                        <% end %>

                        <%= link_to admin_category_path(category),
                                    class: "btn btn-danger btn-sm",
                                    data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro de eliminar esta categoría?" } do %>
                          <i class="fa fa-trash" title="Eliminar"></i>
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- ================= TAB 2: VISTA DE CARDS INTERACTIVAS ================= -->
        <div class="tab-pane fade" id="cards-view" role="tabpanel" aria-labelledby="cards-tab">
          
          <!-- Migas de Pan (Breadcrumb) de Navegación -->
          <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb bg-light p-3 rounded" id="category-breadcrumb">
              <li class="breadcrumb-item active fw-bold text-primary" aria-current="page" data-category-id="root">
                <i class="fas fa-home me-1"></i> Categorías Principales
              </li>
            </ol>
          </nav>

          <!-- Grid de Tarjetas -->
          <div class="row g-4" id="cards-grid">
            <% @categories.each do |category| %>
              <% 
                parent_id_val = category.parent_id.present? ? category.parent_id.to_s : "root"
                subcategories_count = category.subcategories.count
              %>
              <div class="col-12 col-sm-6 col-md-4 col-lg-3 category-card-wrapper" 
                   data-id="<%= category.id %>" 
                   data-parent-id="<%= parent_id_val %>"
                   data-name="<%= category.name %>">
                
                <!-- Card extendida verticalmente con flex column -->
                <div class="card h-100 shadow-sm border-0 hover-shadow transition custom-category-card">
                  <% if category.image_url.present? %>
                    <img src="<%= category.image_url %>" class="card-img-top card-img-height" alt="<%= category.name %>">
                  <% else %>
                    <div class="bg-light d-flex align-items-center justify-content-center text-muted card-img-top card-img-height">
                      <i class="fas fa-image fa-3x"></i>
                    </div>
                  <% end %>

                  <div class="card-body d-flex flex-column p-3 p-xl-4">
                    <h5 class="card-title fw-bold text-dark mb-2"><%= category.name %></h5>
                    
                    <p class="card-text text-muted small flex-grow-1 mb-3">
                      <%= category.description.present? ? truncate(category.description, length: 110) : "Sin descripción disponible." %>
                    </p>

                    <!-- Sección inferior de botones (Responsiva en columna para pantallas muy chicas, row para medianas/grandes) -->
                    <div class="pt-3 border-top mt-auto d-flex flex-column flex-xl-row align-items-stretch align-items-xl-center justify-content-between gap-2">
                      <div class="d-flex gap-1 justify-content-start">
                        <%= link_to edit_admin_category_path(category), class: "btn btn-outline-primary btn-sm flex-fill text-center", data: { turbo: false } do %>
                          <i class="fa fa-edit"></i>
                        <% end %>

                        <%= link_to admin_category_path(category),
                                    class: "btn btn-outline-danger btn-sm flex-fill text-center",
                                    data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro de eliminar esta categoría?" } do %>
                          <i class="fa fa-trash"></i>
                        <% end %>
                      </div>

                      <div class="w-100 w-xl-auto">
                        <% if subcategories_count > 0 %>
                          <button type="button" class="btn btn-primary btn-sm view-subcategories-btn w-100 text-truncate" data-id="<%= category.id %>" data-name="<%= category.name %>">
                            Subcategorías (<%= subcategories_count %>) <i class="fas fa-chevron-right ms-1"></i>
                          </button>
                        <% else %>
                          <span class="badge bg-light text-secondary border w-100 py-2 d-block text-center">Sin subcategorías</span>
                        <% end %>
                      </div>
                    </div>

                  </div>
                </div>

              </div>
            <% end %>
          </div>

        </div>

      </div>
    </div>
  </div>
</div>

<!-- Estilos para Altura Ajustada y Efecto Hover -->
<style>
  .custom-category-card {
    min-height: 500px; /* Asegura una altura mínima vertical más larga */
  }
  .card-img-height {
    height: 350px; /* Altura incrementada de las imágenes */
    object-fit: cover;
  }
  .hover-shadow {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .hover-shadow:hover {
    transform: translateY(-4px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
  }
</style>

<!-- Script de Navegación entre Niveles -->
<script>
document.addEventListener("DOMContentLoaded", function() {
  const cardsGrid = document.getElementById("cards-grid");
  const breadcrumb = document.getElementById("category-breadcrumb");
  
  // Historial de navegación: [{ id: 'root', name: 'Categorías Principales' }]
  let navigationHistory = [{ id: 'root', name: 'Categorías Principales' }];

  // Renderiza las tarjetas según la categoría padre actual
  function renderCurrentLevel(parentId) {
    const allWrappers = cardsGrid.querySelectorAll(".category-card-wrapper");
    let countVisible = 0;

    allWrappers.forEach(wrapper => {
      if (wrapper.dataset.parentId === parentId) {
        wrapper.classList.remove("d-none");
        countVisible++;
      } else {
        wrapper.classList.add("d-none");
      }
    });

    // Muestra alerta si no hay categorías registradas en el nivel
    let noCategoriesAlert = document.getElementById("no-subcategories-alert");
    if (countVisible === 0) {
      if (!noCategoriesAlert) {
        noCategoriesAlert = document.createElement("div");
        noCategoriesAlert.id = "no-subcategories-alert";
        noCategoriesAlert.className = "col-12 text-center py-5 text-muted";
        noCategoriesAlert.innerHTML = '<i class="fas fa-folder-open fa-3x mb-3"></i><h5>No existen categorías en este nivel.</h5>';
        cardsGrid.appendChild(noCategoriesAlert);
      }
    } else if (noCategoriesAlert) {
      noCategoriesAlert.remove();
    }

    renderBreadcrumb();
  }

  // Actualiza la barra de navegación (Breadcrumb)
  function renderBreadcrumb() {
    breadcrumb.innerHTML = "";
    navigationHistory.forEach((item, index) => {
      const isLast = index === navigationHistory.length - 1;
      const li = document.createElement("li");
      li.className = `breadcrumb-item ${isLast ? "active fw-bold text-primary" : ""}`;
      
      if (isLast) {
        li.textContent = item.name;
      } else {
        const a = document.createElement("a");
        a.href = "#";
        a.className = "text-decoration-none";
        a.textContent = item.name;
        a.addEventListener("click", function(e) {
          e.preventDefault();
          // Retrocede hasta el nivel cliqueado
          navigationHistory = navigationHistory.slice(0, index + 1);
          renderCurrentLevel(item.id);
        });
        li.appendChild(a);
      }
      breadcrumb.appendChild(li);
    });
  }

  // Event listener delegado para los botones "Subcategorías"
  cardsGrid.addEventListener("click", function(e) {
    const btn = e.target.closest(".view-subcategories-btn");
    if (btn) {
      const catId = btn.dataset.id;
      const catName = btn.dataset.name;

      navigationHistory.push({ id: catId, name: catName });
      renderCurrentLevel(catId);
    }
  });

  // Inicializa mostrando el nivel principal ('root')
  renderCurrentLevel("root");
});
</script>