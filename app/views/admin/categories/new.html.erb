<!-- Begin Page Content -->
<div class="container-fluid py-4">
  <!-- Page Heading -->
  <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between mb-4">
    <h1 class="h3 text-gray-800 mb-3 mb-md-0">Crear nueva categoría</h1>
    <%= link_to admin_categories_path, data: { turbo: false }, class: "btn btn-primary shadow-sm" do %>
      <i class="fas fa-arrow-left me-1"></i> Volver a categorías
    <% end %>
  </div>

  <!-- Card -->
  <div class="card shadow-sm rounded-3 border-0">
    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
      <h6 class="m-0 fw-bold text-primary">Formulario de categoría</h6>
    </div>

    <div class="card-body p-4">
      <% if flash[:notice] %>
        <div class="alert alert-success rounded-3"><%= flash[:notice] %></div>
      <% elsif flash[:alert] %>
        <div class="alert alert-danger rounded-3"><%= flash[:alert] %></div>
      <% end %>

      <%= simple_form_for [:admin, @category],
                          html: { 
                            class: "needs-validation", 
                            id: "form-category", 
                            multipart: true,
                            novalidate: false, 
                            data: { turbo: false } 
                          } do |form| %>
              
        <div class="mb-3">
          <%= form.input :name, label: "Nombre", required: true, input_html: { class: "form-control form-control-lg" } %>
        </div>

        <div class="mb-3">
          <%= form.input :parent_id,
                        collection: Category.options_for_select,
                        include_blank: "Ninguna (Es una Categoría Principal)",
                        label: "Categoría Padre",
                        required: false,
                        input_html: { class: "form-select" } %>
        </div>

        <!-- Campo de Imagen -->
        <div class="mb-3">
          <label class="form-label fw-bold">Imagen de la Categoría</label>
          <%= form.file_field :image_file, class: "form-control", accept: "image/*" %>
        </div>

        <div class="mb-3">
          <%= form.input :description, as: :text, label: "Descripción", required: false,
                          input_html: { class: "form-control", rows: 4, style: "resize: vertical;" } %>
        </div>

        <div class="d-flex justify-content-start gap-2">
          <%= form.submit 'Guardar', class: 'btn btn-success' %>
          <%= link_to 'Cancelar', admin_categories_path, data: { turbo: false }, class: 'btn btn-secondary' %>
        </div>

      <% end %>
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const form = document.getElementById("form-category");
  form.addEventListener("submit", function (event) {
    if (!form.checkValidity()) {
      event.preventDefault();
      event.stopPropagation();
    }
    form.classList.add("was-validated");
  });
});
</script>