<div class="container-fluid py-4">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Editar Lista de Clientes</h1>
    <%= link_to admin_customer_lists_path, class: "btn btn-sm btn-secondary shadow-sm", data: { turbo: false } do %>
      <i class="fas fa-arrow-left fa-sm me-1"></i> Volver a Listas
    <% end %>
  </div>

  <div class="card shadow border-0 col-lg-10 mx-auto">
    <div class="card-header py-3 bg-white">
      <h6 class="m-0 font-weight-bold text-primary">Modificar "<%= @customer_list.name %>"</h6>
    </div>
    <div class="card-body p-4">
      <%= render 'form' %>
    </div>
  </div>
</div>