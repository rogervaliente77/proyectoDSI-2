<div class="container-fluid py-4">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      <i class="fas fa-users me-2 text-primary"></i><%= @customer_list.name %>
    </h1>
    <div class="d-flex gap-2">
      <%= link_to edit_admin_customer_list_path(@customer_list), class: "btn btn-warning btn-sm shadow-sm", data: { turbo: false } do %>
        <i class="fas fa-edit me-1"></i> Editar Lista
      <% end %>
      <%= link_to admin_customer_lists_path, class: "btn btn-secondary btn-sm shadow-sm", data: { turbo: false } do %>
        <i class="fas fa-arrow-left me-1"></i> Volver a Listas
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-4 mb-4">
      <div class="card shadow border-0">
        <div class="card-header bg-white py-3">
          <h6 class="m-0 font-weight-bold text-primary">Información General</h6>
        </div>
        <div class="card-body">
          <p class="mb-2"><strong>Descripción:</strong><br><%= @customer_list.description.presence || "Sin descripción" %></p>
          <hr>
          <p class="mb-0"><strong>Total Integrantes:</strong> <span class="badge bg-primary fs-6"><%= @customer_list.clients_data.size %></span></p>
        </div>
      </div>
    </div>

    <div class="col-lg-8 mb-4">
      <div class="card shadow border-0">
        <div class="card-header bg-white py-3">
          <h6 class="m-0 font-weight-bold text-primary">Clientes Almacenados en esta Lista</h6>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light">
                <tr>
                  <th>Cliente</th>
                  <th>Correo Electrónico</th>
                </tr>
              </thead>
              <tbody>
                <% if @customer_list.clients_data.any? %>
                  <% @customer_list.clients_data.each do |data| %>
                    <tr>
                      <td class="fw-bold font-monospace"><%= data['name'] || data[:name] %></td>
                      <td><i class="fas fa-envelope text-muted me-2"></i><%= data['email'] || data[:email] %></td>
                    </tr>
                  <% end %>
                <% else %>
                  <tr>
                    <td colspan="2" class="text-center py-4 text-muted">No hay clientes agregados a esta lista.</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>