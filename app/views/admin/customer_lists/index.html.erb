<div class="container-fluid py-4">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      <i class="fas fa-users-cog me-2 text-primary"></i>Listas de Clientes (Destinatarios)
    </h1>
    <%= link_to new_admin_customer_list_path, class: "btn btn-sm btn-primary shadow-sm", data: { turbo: false } do %>
      <i class="fas fa-plus fa-sm text-white-50 me-1"></i> Nueva Lista
    <% end %>
  </div>

  <% if flash[:notice] %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <i class="fas fa-check-circle me-2"></i><%= flash[:notice] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <div class="card shadow border-0 mb-4">
    <div class="card-header py-3 bg-white">
      <h6 class="m-0 font-weight-bold text-primary">Listas Registradas</h6>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Nombre</th>
              <th>Descripción</th>
              <th class="text-center">Total Clientes</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if @customer_lists.any? %>
              <% @customer_lists.each do |list| %>
                <tr>
                  <td class="fw-bold text-dark"><%= list.name %></td>
                  <td><%= list.description.presence || "Sin descripción" %></td>
                  <td class="text-center">
                    <span class="badge rounded-pill bg-primary fs-6"><%= list.clients_data.size %></span>
                  </td>
                  <td class="text-end">
                    <%= link_to admin_customer_list_path(list), class: "btn btn-sm btn-info text-white me-1", title: "Ver detalles", data: { turbo: false } do %>
                      <i class="fas fa-eye"></i>
                    <% end %>
                    <%= link_to edit_admin_customer_list_path(list), class: "btn btn-sm btn-warning me-1", title: "Editar", data: { turbo: false } do %>
                      <i class="fas fa-edit"></i>
                    <% end %>
                    
                    <!-- Botón Eliminar Corregido -->
                    <%= link_to admin_customer_list_path(list), 
                                data: { turbo_method: :delete, turbo_confirm: "¿Estás seguro de eliminar esta lista?" }, 
                                class: "btn btn-sm btn-danger", 
                                title: "Eliminar" do %>
                      <i class="fas fa-trash"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="4" class="text-center py-4 text-muted">
                  <i class="fas fa-info-circle me-1"></i> No hay listas de clientes creadas aún.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>