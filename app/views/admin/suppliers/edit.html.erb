<div class="container-fluid min-vh-100 py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-lg-8">
      <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
          <h5 class="m-0 fw-bold text-primary"><i class="fas fa-edit me-2"></i>Editar Proveedor: <%= @supplier.name %></h5>
          <%= link_to admin_suppliers_path, class: "btn btn-outline-secondary btn-sm" do %>
            <i class="fas fa-arrow-left me-1"></i> Volver
          <% end %>
        </div>
        <div class="card-body p-4">
          <%= render 'form', supplier: @supplier %>
        </div>
      </div>
    </div>
  </div>
</div>