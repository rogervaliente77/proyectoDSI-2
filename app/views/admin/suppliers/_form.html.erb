<%= form_with(model: [:admin, supplier], local: true, data: { turbo: false }) do |f| %>
  <% if supplier.errors.any? %>
    <div class="alert alert-danger rounded-3 mb-4">
      <h6 class="fw-bold mb-1"><i class="fas fa-exclamation-triangle me-2"></i>Corrige los siguientes errores:</h6>
      <ul class="mb-0 ps-3">
        <% supplier.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3">
    <div class="col-12 col-md-6">
      <%= f.label :name, "Nombre Comercial *", class: "form-label fw-semibold text-dark" %>
      <%= f.text_field :name, class: "form-control", placeholder: "Ej. Super Repuestos", required: true %>
    </div>
    <div class="col-12 col-md-6">
      <%= f.label :business_name, "Razón Social", class: "form-label fw-semibold text-dark" %>
      <%= f.text_field :business_name, class: "form-control", placeholder: "Ej. Super Repuestos S.A. de C.V." %>
    </div>
    <div class="col-12 col-md-4">
      <%= f.label :nit_nrc, "NIT / NRC", class: "form-label fw-semibold text-dark" %>
      <%= f.text_field :nit_nrc, class: "form-control", placeholder: "0614-XXXXXX-XXX-X" %>
    </div>
    <div class="col-12 col-md-4">
      <%= f.label :phone, "Teléfono", class: "form-label fw-semibold text-dark" %>
      <%= f.text_field :phone, class: "form-control", placeholder: "2222-0000" %>
    </div>
    <div class="col-12 col-md-4">
      <%= f.label :email, "Correo Electrónico", class: "form-label fw-semibold text-dark" %>
      <%= f.email_field :email, class: "form-control", placeholder: "ventas@proveedor.com" %>
    </div>
    <div class="col-12 col-md-6">
      <%= f.label :contact_person, "Persona de Contacto / Vendedor", class: "form-label fw-semibold text-dark" %>
      <%= f.text_field :contact_person, class: "form-control", placeholder: "Ej. Juan Pérez" %>
    </div>
    <div class="col-12 col-md-3">
      <%= f.label :credit_days, "Días de Crédito", class: "form-label fw-semibold text-dark" %>
      <%= f.number_field :credit_days, class: "form-control", placeholder: "30", min: 0 %>
    </div>
    <div class="col-12 col-md-3">
      <%= f.label :credit_limit, "Límite de Crédito ($)", class: "form-label fw-semibold text-dark" %>
      <%= f.number_field :credit_limit, step: "0.01", class: "form-control", placeholder: "5000.00", min: 0 %>
    </div>
    <div class="col-12">
      <%= f.label :address, "Dirección Física", class: "form-label fw-semibold text-dark" %>
      <%= f.text_area :address, rows: 2, class: "form-control", placeholder: "Calle o Sucursal principal..." %>
    </div>
    <div class="col-12 ms-4">
      <div class="form-check form-switch mt-2">
        <%= f.check_box :active, class: "form-check-input", id: "supplierActiveSwitch" %>
        <%= f.label :active, "Proveedor Activo", class: "form-check-label fw-semibold text-dark", for: "supplierActiveSwitch" %>
      </div>
    </div>
    <div class="col-12 d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
      <%= link_to "Cancelar", admin_suppliers_path, class: "btn btn-outline-secondary px-4" %>
      <%= f.submit supplier.new_record? ? "Crear Proveedor" : "Actualizar Proveedor", class: "btn btn-success px-4" %>
    </div>
  </div>
<% end %>