<div class="container-fluid min-vh-100 py-4">
  <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-4 gap-2">
    <div>
      <h1 class="h3 text-gray-800 mb-0"><i class="fas fa-truck me-2 text-primary"></i>Proveedores</h1>
      <p class="text-muted small mb-0">Gestión de casas comerciales y condiciones de crédito</p>
    </div>
    <%= link_to new_admin_supplier_path, class: "btn btn-primary shadow-sm text-nowrap" do %>
      <i class="fas fa-plus me-1"></i> Crear Proveedor
    <% end %>
  </div>

  <% if flash[:notice] %>
    <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
      <i class="fas fa-check-circle me-2"></i><%= flash[:notice] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% elsif flash[:alert] %>
    <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
      <i class="fas fa-exclamation-triangle me-2"></i><%= flash[:alert] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% end %>

  <div class="card p-3 mb-4 shadow-sm rounded-3 border-0">
    <%= form_with url: admin_suppliers_path, method: :get, local: true, class: "row g-3 align-items-end" do %>
      <div class="col-12 col-md-6 col-lg-4">
        <label class="form-label small text-dark fw-semibold"><i class="fas fa-search me-1"></i> Buscar Proveedor</label>
        <%= text_field_tag :query, params[:query], placeholder: "Nombre, NIT/NRC, Teléfono...", class: "form-control filter-input w-100" %>
      </div>
      <div class="col-auto d-flex gap-2">
        <%= submit_tag "Buscar", class: "btn btn-primary" %>
        <%= link_to admin_suppliers_path, class: "btn btn-outline-secondary" do %>
          <i class="fas fa-sync-alt me-1"></i> Limpiar
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light text-secondary small text-uppercase fw-bold">
            <tr>
              <th class="ps-3">Nombre Comercial</th>
              <th>Contacto / Teléfono</th>
              <th>Días Crédito</th>
              <th class="text-end">Deuda Pendiente</th>
              <th class="text-center">Estado</th>
              <th class="text-center pe-3">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if @suppliers.any? %>
              <% @suppliers.each do |sup| %>
                <tr>
                  <td class="ps-3">
                    <span class="fw-bold text-dark d-block"><%= sup.name %></span>
                    <small class="text-muted"><%= sup.business_name.presence || "NIT: #{sup.nit_nrc}" %></small>
                  </td>
                  <td>
                    <span class="d-block text-dark"><%= sup.contact_person.presence || "Sin contacto" %></span>
                    <small class="text-muted"><i class="fas fa-phone me-1"></i><%= sup.phone.presence || "N/A" %></small>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border px-2 py-1">
                      <i class="fas fa-clock me-1 text-muted"></i><%= sup.credit_days %> Días
                    </span>
                  </td>
                  <td class="text-end fw-bold <%= sup.total_debt > 0 ? 'text-danger' : 'text-success' %>">
                    <%= number_to_currency(sup.total_debt) %>
                  </td>
                  <td class="text-center">
                    <% if sup.active %>
                      <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Activo</span>
                    <% else %>
                      <span class="badge bg-secondary-subtle text-secondary border border-secondary px-2 py-1">Inactivo</span>
                    <% end %>
                  </td>
                  <td class="text-center pe-3">
                    <div class="d-flex gap-1 justify-content-center">
                      <%= link_to admin_supplier_path(sup), class: "btn btn-light btn-sm border", title: "Ver Estadísticas / Facturas" do %>
                        <i class="fas fa-eye text-primary"></i>
                      <% end %>
                      <%= link_to edit_admin_supplier_path(sup), class: "btn btn-light btn-sm border", title: "Editar" do %>
                        <i class="fas fa-edit text-secondary"></i>
                      <% end %>
                      <%= link_to admin_supplier_path(sup), class: "btn btn-light btn-sm border", data: { turbo_method: :delete, turbo_confirm: "¿Eliminar proveedor?" }, title: "Eliminar" do %>
                        <i class="fas fa-trash text-danger"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="text-center py-4 text-muted">
                  <i class="fas fa-truck fa-2x mb-2 d-block"></i> No se encontraron proveedores registrados.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
      <small class="text-muted">Mostrando <%= @suppliers.count %> registros</small>
      <div><%= paginate @suppliers rescue nil %></div>
    </div>
  </div>
</div>