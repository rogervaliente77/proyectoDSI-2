<!-- app/views/admin/site_configurations/show.html.erb -->
<div class="container-fluid py-4">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      <i class="fas fa-cogs me-2 text-primary"></i>Configuraciones Generales del Sitio
    </h1>
    <%= link_to admin_home_path, class: "btn btn-sm btn-secondary shadow-sm", data: { turbo: false } do %>
      <i class="fas fa-arrow-left fa-sm text-white-50 me-1"></i> Volver al panel
    <% end %>
  </div>

  <div class="row">
    <div class="col-lg-12">
      <div class="card shadow mb-4 border-0">
        <div class="card-header py-3 bg-white border-bottom">
          <h6 class="m-0 font-weight-bold text-primary">Ajustes del Sistema</h6>
        </div>

        <div class="card-body p-4">
          <% if flash[:notice] %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              <i class="fas fa-check-circle me-2"></i><%= flash[:notice] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% elsif flash[:alert] %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <i class="fas fa-exclamation-circle me-2"></i><%= flash[:alert] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>

          <%= simple_form_for @config,
              url: admin_site_configuration_path,
              method: :patch,
              html: { class: "needs-validation", id: "form-configuracion-general" },
              data: { turbo: false } do |f| %>

            <!-- SECCIÓN 1: SISTEMA Y SEGURIDAD -->
            <h5 class="text-secondary mb-3 border-bottom pb-2">
              <i class="fas fa-sliders-h me-2"></i>Ajustes Generales y Sesión
            </h5>
            <div class="row mb-3">
              <div class="col-md-4 mb-3">
                <%= f.input :company_name,
                    label: "Nombre de la empresa",
                    input_html: { class: "form-control" } %>
              </div>

              <div class="col-md-2 mb-3">
                <%= f.input :currency_symbol,
                    label: "Símbolo Moneda",
                    input_html: { class: "form-control", maxlength: 5 } %>
              </div>

              <div class="col-md-3 mb-3">
                <%= f.input :timezone,
                    label: "Zona Horaria",
                    collection: ActiveSupport::TimeZone.all.map(&:name),
                    prompt: "Seleccione zona horaria",
                    input_html: { class: "form-control" } %>
              </div>

              <div class="col-md-3 mb-3">
                <%= f.input :session_timeout,
                    label: "Inactividad sesión (min)",
                    required: true,
                    input_html: { class: "form-control", min: 1 } %>
              </div>
            </div>

            <!-- SECCIÓN 2: INFORMACIÓN DE CONTACTO -->
            <h5 class="text-secondary mb-3 border-bottom pb-2 mt-4">
              <i class="fas fa-address-card me-2"></i>Información de Contacto y Ubicación
            </h5>
            <div class="row mb-3">
              <div class="col-md-3 mb-3">
                <%= f.input :tel,
                    label: "Teléfono PBX/Fijo",
                    input_html: { class: "form-control" } %>
              </div>

              <div class="col-md-3 mb-3">
                <%= f.input :phone,
                    label: "Teléfono Secundario/Móvil",
                    input_html: { class: "form-control" } %>
              </div>
              
              <div class="col-md-3 mb-3">
                <%= f.input :company_email,
                    label: "Correo",
                    input_html: { class: "form-control" } %>
              </div>
              
              <div class="col-md-3 mb-3">
                <%= f.input :short_address,
                    label: "Dirección Corta (Ej: San Salvador, El Salvador)",
                    input_html: { class: "form-control" } %>
              </div>

              <div class="col-md-12 mb-3">
                <%= f.input :address,
                    label: "Dirección Completa",
                    as: :string,
                    input_html: { class: "form-control" } %>
              </div>
            </div>

            <!-- SECCIÓN 3: REDES SOCIALES -->
            <h5 class="text-secondary mb-3 border-bottom pb-2 mt-4">
              <i class="fas fa-share-alt me-2"></i>Redes Sociales y WhatsApp
            </h5>
            <div class="row mb-3">
              <div class="col-md-3 mb-3">
                <%= f.input :wsp_number,
                    label: "WhatsApp",
                    placeholder: "50300000000",
                    input_html: { class: "form-control" } %>
              </div>

              <div class="col-md-3 mb-3">
                <%= f.input :fb_url,
                    label: "Facebook URL",
                    placeholder: "https://facebook.com/...",
                    input_html: { class: "form-control" } %>
              </div>

              <div class="col-md-3 mb-3">
                <%= f.input :inst_url,
                    label: "Instagram URL",
                    placeholder: "https://instagram.com/...",
                    input_html: { class: "form-control" } %>
              </div>

              <div class="col-md-3 mb-3">
                <%= f.input :tiktok_url,
                    label: "TikTok URL",
                    placeholder: "https://tiktok.com/@...",
                    input_html: { class: "form-control" } %>
              </div>
            </div>

            <!-- SECCIÓN 4: SECCIONES DE LANDING PAGE -->
            <h5 class="text-secondary mb-3 border-bottom pb-2 mt-4">
              <i class="fas fa-desktop me-2"></i>Contenido de Landing Page
            </h5>
            <strong>-------------------SECTION HEADER-------------------</strong>
            <div class="row mb-3 mt-3">
              <div class="col-md-4 mb-3">
                <%= f.input :etiqueta_superior,
                    label: "Etiqueta Superior (Header Badge)",
                    input_html: { class: "form-control" } %>
              </div>

              <div class="col-md-4 mb-3">
                <%= f.input :header_title_part1,
                    label: "Título Principal (Parte 1)",
                    input_html: { class: "form-control" } %>
              </div>

              <div class="col-md-4 mb-3">
                <%= f.input :header_title_part2,
                    label: "Título Principal (Parte 2 - Destacado)",
                    input_html: { class: "form-control" } %>
              </div>

              <div class="col-md-12 mb-3">
                <%= f.input :header_description,
                    label: "Descripción Principal del Banner",
                    as: :text,
                    input_html: { class: "form-control", rows: 2 } %>
              </div>
            </div>

            <strong>-------------------SECTION SERVICIOS-------------------</strong>
            <div class="row mb-3 mt-3">
              <div class="col-md-6 mb-3">
                <%= f.input :services_title,
                    label: "Título Sección Servicios",
                    input_html: { class: "form-control" } %>
              </div>

              <div class="col-md-6 mb-3">
                <%= f.input :services_description,
                    label: "Descripción Sección Servicios",
                    as: :text,
                    input_html: { class: "form-control", rows: 2 } %>
              </div>
            </div>

            <strong>-------------------SECTION CATEGORIAS-------------------</strong>
            <div class="row mb-3 mt-3">
              <div class="col-md-6 mb-3">
                <%= f.input :categories_title,
                    label: "Título Sección Categorías",
                    input_html: { class: "form-control" } %>
              </div>

              <div class="col-md-6 mb-3">
                <%= f.input :categories_description,
                    label: "Descripción Sección Categorías",
                    as: :text,
                    input_html: { class: "form-control", rows: 2 } %>
              </div>
            </div>

            <!-- SECCIÓN 5: CONFIGURACIÓN DE PIE DE PÁGINA (FOOTER) -->
            <h5 class="text-secondary mb-3 border-bottom pb-2 mt-4">
              <i class="fas fa-shoe-prints me-2"></i>Contenido del Pie de Página (Footer)
            </h5>
            <div class="row mb-3">
              <div class="col-md-6 mb-3">
                <%= f.input :footer_company_description,
                    label: "Descripción Empresa en Footer",
                    as: :text,
                    input_html: { class: "form-control", rows: 3 } %>
              </div>

              <div class="col-md-6 mb-3">
                <%= f.input :footer_services,
                    label: "Texto / Lista de Servicios en Footer",
                    as: :text,
                    input_html: { class: "form-control", rows: 3 } %>
              </div>
            </div>

            <!-- SECCIÓN 6: SERVIDOR DE CORREO (SMTP) -->
            <h5 class="text-secondary mb-3 border-bottom pb-2 mt-4">
              <i class="fas fa-envelope-open-text me-2"></i>Configuración de Envío de Correos
            </h5>
            <div class="row mb-3">
              <div class="col-md-6 mb-3">
                <%= f.input :email_sender,
                    label: "Correo Emisor (SMTP / Gmail)",
                    placeholder: "ejemplo@gmail.com",
                    input_html: { class: "form-control" } %>
              </div>

              <div class="col-md-6 mb-3">
                <label for="site_configuration_app_password_sender" class="form-label">Contraseña de Aplicación</label>
                <div class="input-group">
                  <%= f.input_field :app_password_sender,
                      as: :password,
                      class: "form-control",
                      id: "app_password_input",
                      placeholder: "•••• •••• •••• ••••" %>
                  <button class="btn btn-outline-secondary" type="button" id="toggleAppPassword">
                    <i class="fas fa-eye" id="togglePasswordIcon"></i>
                  </button>
                </div>
              </div>
            </div>

            <!-- BOTÓN GUARDAR -->
            <div class="row mt-4">
              <div class="col-md-12 text-end">
                <%= f.submit '💾 Guardar Cambios', class: 'btn btn-primary px-4 shadow-sm' %>
              </div>
            </div>

          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggleBtn = document.getElementById('toggleAppPassword');
    const passwordInput = document.getElementById('app_password_input');
    const icon = document.getElementById('togglePasswordIcon');

    if (toggleBtn && passwordInput && icon) {
      toggleBtn.addEventListener('click', function() {
        const isPassword = passwordInput.getAttribute('type') === 'password';
        
        // Cambia el tipo de input
        passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
        
        // Cambia el ícono entre el ojo abierto y cerrado
        icon.classList.toggle('fa-eye', !isPassword);
        icon.classList.toggle('fa-eye-slash', isPassword);
      });
    }
  });
</script>