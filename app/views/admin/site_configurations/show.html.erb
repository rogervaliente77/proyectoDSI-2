<!-- app/views/admin/site_configurations/show.html.erb -->
<div class="container-fluid py-4">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      <i class="fas fa-cogs me-2 text-primary"></i>Configuraciones Generales del Sitio
    </h1>
    <%= link_to admin_home_path, class: "btn btn-sm btn-secondary shadow-sm", data: { turbo: false } do %>
      <i class="fas fa-arrow-left fa-sm text-white-50 me-1"></i> Volver al panel
    <% end %>
  </div>

  <div class="row">
    <div class="col-lg-12">
      <div class="card shadow mb-4 border-0">
        <div class="card-header py-3 bg-white border-bottom">
          <h6 class="m-0 font-weight-bold text-primary">Ajustes del Sistema</h6>
        </div>

        <div class="card-body p-4">
          <% if flash[:notice] %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              <i class="fas fa-check-circle me-2"></i><%= flash[:notice] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% elsif flash[:alert] %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <i class="fas fa-exclamation-circle me-2"></i><%= flash[:alert] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>

          <!-- FORMULARIO 1: SUBIDA DE NUEVA LÁMINA CON TEXTOS -->
          <!-- BOTÓN DISPARADOR PARA AGREGAR NUEVA LÁMINA -->
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="text-dark fw-bold font-weight-bold m-0">
              <i class="fas fa-images me-2 text-primary"></i>Gestión de Láminas del Slider (Header)
            </h5>
            <button class="btn btn-success shadow-sm" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSlideForm" aria-expanded="false" aria-controls="collapseSlideForm">
              <i class="fas fa-plus me-1"></i> Agregar nueva lámina
            </button>
          </div>

          <!-- FORMULARIO 1: CREAR NUEVA LÁMINA (OCULTO POR DEFECTO) -->
          <div class="collapse mb-4" id="collapseSlideForm">
            <div class="card bg-light p-3 border shadow-sm">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <label class="form-label font-weight-bold text-dark m-0">
                  <i class="fas fa-upload me-1 text-primary"></i> Nueva Lámina para el Slider
                </label>
                <button type="button" class="btn-close" data-bs-toggle="collapse" data-bs-target="#collapseSlideForm" aria-label="Cerrar"></button>
              </div>

              <%= form_with url: upload_slide_admin_site_configuration_path, method: :post, multipart: true, class: "row g-3", data: { turbo: false } do |sf| %>
                <div class="col-md-6">
                  <label class="form-label small font-weight-bold">Imagen del Banner *</label>
                  <%= sf.file_field :slide_image, class: "form-control", accept: "image/*", required: true %>
                </div>
                <div class="col-md-6">
                  <label class="form-label small font-weight-bold">Etiqueta Superior (Badge)</label>
                  <%= sf.text_field :badge_text, class: "form-control", placeholder: "Ej: Garantía & Confianza" %>
                </div>
                <div class="col-md-6">
                  <label class="form-label small font-weight-bold">Título Principal (Parte 1)</label>
                  <%= sf.text_field :title_part1, class: "form-control", placeholder: "Ej: Mantenimiento Preventivo" %>
                </div>
                <div class="col-md-6">
                  <label class="form-label small font-weight-bold">Título Destacado (Parte 2)</label>
                  <%= sf.text_field :title_part2, class: "form-control", placeholder: "Ej: & Correctivo" %>
                </div>
                <div class="col-md-12">
                  <label class="form-label small font-weight-bold">Descripción del Slide</label>
                  <%= sf.text_area :description, class: "form-control", rows: 2, placeholder: "Breve descripción..." %>
                </div>
                <div class="col-md-12 text-end">
                  <button type="button" class="btn btn-secondary me-2" data-bs-toggle="collapse" data-bs-target="#collapseSlideForm">Cancelar</button>
                  <%= sf.submit "Subir y Guardar Lámina", class: "btn btn-success shadow-sm px-4" %>
                </div>
              <% end %>
            </div>
          </div>

          <!-- FORMULARIO 2: CONFIGURACIÓN GENERAL Y EDICIÓN DE LÁMINAS -->
          <%= simple_form_for @config,
              url: admin_site_configuration_path,
              method: :patch,
              html: { class: "needs-validation", id: "form-configuracion-general" },
              data: { turbo: false } do |f| %>

            <!-- SECCIÓN SLIDER DEL HEADER (EDICIÓN, GALERÍA Y REORDENAMIENTO) -->
            <h5 class="text-dark fw-bold font-weight-bold mb-3 border-bottom pb-2 mt-4">
              Láminas guardadas del Slider (Header)
            </h5>

            <p class="text-muted small">
              <i class="fas fa-info-circle me-1"></i>Puedes editar los textos directamente en cada tarjeta o reordenar las láminas arrastrándolas.
            </p>

            <div id="slider-grid" class="row mb-4">
              <%= f.fields_for :header_slides do |slide_f| %>
                <% slide = slide_f.object %>
                <div class="col-md-6 col-lg-4 mb-4 slide-card-item" data-id="<%= slide.id %>">
                  <div class="card h-100 shadow-sm border position-relative">
                    <span class="position-absolute top-0 start-0 badge bg-dark m-2 drag-handle" style="cursor: move; z-index: 10;">
                      <i class="fas fa-grip-vertical me-1"></i> Mover
                    </span>
                    
                    <img src="<%= slide.image_url %>" class="card-img-top" style="height: 160px; object-fit: cover;" alt="Slide">
                    
                    <div class="card-body p-3 bg-white">
                      <%= slide_f.hidden_field :id %>
                      
                      <div class="mb-2">
                        <label class="form-label small text-muted mb-0">Etiqueta</label>
                        <%= slide_f.input_field :badge_text, class: "form-control form-control-sm", placeholder: "Badge" %>
                      </div>

                      <div class="row g-2 mb-2">
                        <div class="col-6">
                          <label class="form-label small text-muted mb-0">Título Parte 1</label>
                          <%= slide_f.input_field :title_part1, class: "form-control form-control-sm", placeholder: "Parte 1" %>
                        </div>
                        <div class="col-6">
                          <label class="form-label small text-muted mb-0">Título Parte 2</label>
                          <%= slide_f.input_field :title_part2, class: "form-control form-control-sm", placeholder: "Parte 2" %>
                        </div>
                      </div>

                      <div class="mb-3">
                        <label class="form-label small text-muted mb-0">Descripción</label>
                        <%= slide_f.text_area :description, class: "form-control form-control-sm", rows: 2, placeholder: "Descripción..." %>
                      </div>

                      <%= link_to destroy_slide_admin_site_configuration_path(slide_id: slide.id),
                                  method: :delete,
                                  data: { turbo_method: :delete, turbo_confirm: "¿Deseas eliminar esta lámina de Cloudinary y la base de datos?" },
                                  class: "btn btn-sm btn-outline-danger w-100" do %>
                        <i class="fas fa-trash me-1"></i>Eliminar Lámina
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>

            <!-- SECCIÓN 1: SISTEMA Y SEGURIDAD -->
            <h5 class="text-dark fw-bold font-weight-bold mb-3 border-bottom pb-2">
              <i class="fas fa-sliders-h me-2 text-primary"></i>Ajustes Generales y Sesión
            </h5>
            <div class="row mb-3">
              <div class="col-md-4 mb-3">
                <%= f.input :company_name, label: "Nombre de la empresa", input_html: { class: "form-control" } %>
              </div>
              <div class="col-md-2 mb-3">
                <%= f.input :currency_symbol, label: "Símbolo Moneda", input_html: { class: "form-control", maxlength: 5 } %>
              </div>
              <div class="col-md-3 mb-3">
                <%= f.input :timezone, label: "Zona Horaria", collection: ActiveSupport::TimeZone.all.map(&:name), prompt: "Seleccione zona horaria", input_html: { class: "form-control" } %>
              </div>
              <div class="col-md-3 mb-3">
                <%= f.input :session_timeout, label: "Inactividad sesión (min)", required: true, input_html: { class: "form-control", min: 1 } %>
              </div>
            </div>

            <!-- SECCIÓN 2: INFORMACIÓN DE CONTACTO -->
            <h5 class="text-dark fw-bold font-weight-bold mb-3 border-bottom pb-2 mt-4">
              <i class="fas fa-address-card me-2 text-primary"></i>Información de Contacto y Ubicación
            </h5>
            <div class="row mb-3">
              <div class="col-md-3 mb-3">
                <%= f.input :tel, label: "Teléfono PBX/Fijo", input_html: { class: "form-control" } %>
              </div>
              <div class="col-md-3 mb-3">
                <%= f.input :phone, label: "Teléfono Secundario/Móvil", input_html: { class: "form-control" } %>
              </div>
              <div class="col-md-3 mb-3">
                <%= f.input :company_email, label: "Correo", input_html: { class: "form-control" } %>
              </div>
              <div class="col-md-3 mb-3">
                <%= f.input :short_address, label: "Dirección Corta", input_html: { class: "form-control" } %>
              </div>
              <div class="col-md-12 mb-3">
                <%= f.input :address, label: "Dirección Completa", as: :string, input_html: { class: "form-control" } %>
              </div>
            </div>

            <!-- SECCIÓN 3: REDES SOCIALES -->
            <h5 class="text-dark fw-bold font-weight-bold mb-3 border-bottom pb-2 mt-4">
              <i class="fas fa-share-alt me-2 text-primary"></i>Redes Sociales y WhatsApp
            </h5>
            <div class="row mb-3">
              <div class="col-md-3 mb-3">
                <%= f.input :wsp_number, label: "WhatsApp", placeholder: "50300000000", input_html: { class: "form-control" } %>
              </div>
              <div class="col-md-3 mb-3">
                <%= f.input :fb_url, label: "Facebook URL", placeholder: "https://facebook.com/...", input_html: { class: "form-control" } %>
              </div>
              <div class="col-md-3 mb-3">
                <%= f.input :inst_url, label: "Instagram URL", placeholder: "https://instagram.com/...", input_html: { class: "form-control" } %>
              </div>
              <div class="col-md-3 mb-3">
                <%= f.input :tiktok_url, label: "TikTok URL", placeholder: "https://tiktok.com/@...", input_html: { class: "form-control" } %>
              </div>
            </div>

            <!-- SECCIÓN 4: SECCIONES DE LANDING PAGE -->
            <h5 class="text-dark fw-bold font-weight-bold mb-3 border-bottom pb-2 mt-4">
              <i class="fas fa-desktop me-2 text-primary"></i>Contenido de Landing Page (Secciones secundarias)
            </h5>
            <div class="row mb-3 mt-3">
              <div class="col-md-6 mb-3">
                <%= f.input :services_title, label: "Título Sección Servicios", input_html: { class: "form-control" } %>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.input :services_description, label: "Descripción Sección Servicios", as: :text, input_html: { class: "form-control", rows: 2 } %>
              </div>
            </div>
            <div class="row mb-3 mt-3">
              <div class="col-md-6 mb-3">
                <%= f.input :categories_title, label: "Título Sección Categorías", input_html: { class: "form-control" } %>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.input :categories_description, label: "Descripción Sección Categorías", as: :text, input_html: { class: "form-control", rows: 2 } %>
              </div>
            </div>

            <!-- SECCIÓN 5: CONFIGURACIÓN DE PIE DE PÁGINA (FOOTER) -->
            <h5 class="text-dark fw-bold font-weight-bold mb-3 border-bottom pb-2 mt-4">
              <i class="fas fa-shoe-prints me-2 text-primary"></i>Contenido del Pie de Página (Footer)
            </h5>
            <div class="row mb-3">
              <div class="col-md-6 mb-3">
                <%= f.input :footer_company_description, label: "Descripción Empresa en Footer", as: :text, input_html: { class: "form-control", rows: 3 } %>
              </div>
              <div class="col-md-6 mb-3">
                <%= f.input :footer_services, label: "Texto / Lista de Servicios en Footer", as: :text, input_html: { class: "form-control", rows: 3 } %>
              </div>
            </div>

            <!-- SECCIÓN 6: SERVIDOR DE CORREO (SMTP) -->
            <h5 class="text-dark fw-bold font-weight-bold mb-3 border-bottom pb-2 mt-4">
              <i class="fas fa-envelope-open-text me-2 text-primary"></i>Configuración de Envío de Correos
            </h5>
            <div class="row mb-3">
              <div class="col-md-6 mb-3">
                <%= f.input :email_sender, label: "Correo Emisor (SMTP / Gmail)", placeholder: "ejemplo@gmail.com", input_html: { class: "form-control" } %>
              </div>
              <div class="col-md-6 mb-3">
                <label for="app_password_input" class="form-label">Contraseña de Aplicación</label>
                <div class="input-group">
                  <%= f.input_field :app_password_sender, as: :password, class: "form-control", id: "app_password_input", placeholder: "•••• •••• •••• ••••" %>
                  <button class="btn btn-outline-secondary" type="button" id="toggleAppPassword">
                    <i class="fas fa-eye" id="togglePasswordIcon"></i>
                  </button>
                </div>
              </div>
            </div>

            <!-- BOTÓN GUARDAR CONFIGURACIÓN GENERAL -->
            <div class="row mt-4">
              <div class="col-md-12 text-end">
                <%= f.submit '💾 Guardar Cambios', class: 'btn btn-primary px-4 shadow-sm' %>
              </div>
            </div>

          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggleBtn = document.getElementById('toggleAppPassword');
    const passwordInput = document.getElementById('app_password_input');
    const icon = document.getElementById('togglePasswordIcon');

    if (toggleBtn && passwordInput && icon) {
      toggleBtn.addEventListener('click', function() {
        const isPassword = passwordInput.getAttribute('type') === 'password';
        passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
        icon.classList.toggle('fa-eye', !isPassword);
        icon.classList.toggle('fa-eye-slash', isPassword);
      });
    }

    const grid = document.getElementById('slider-grid');
    if (grid) {
      new Sortable(grid, {
        animation: 150,
        handle: '.drag-handle',
        onEnd: function() {
          const positions = Array.from(grid.querySelectorAll('.slide-card-item')).map(el => el.dataset.id);
          const csrfToken = document.querySelector("meta[name='csrf-token']").getAttribute("content");

          fetch('<%= reorder_slides_admin_site_configuration_path %>', {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken
            },
            body: JSON.stringify({ positions: positions })
          });
        }
      });
    }
  });
</script>