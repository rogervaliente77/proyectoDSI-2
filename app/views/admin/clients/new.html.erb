<div class="container-fluid">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Control de Clientes</h1>
    <%= link_to admin_clients_path, data: { turbo: false }, class: "d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm" do %>
      <i class="fas fa-arrow-left fa-sm text-white-50"></i> Volver a clientes
    <% end %>
  </div>

  <div class="row">
    <div class="col-12">
      <div class="card shadow mb-4">
        <div class="card-header py-3">
          <h6 class="m-0 font-weight-bold text-primary">Registro de Nuevo Cliente</h6>
        </div>
        <div class="card-body">
          <% if flash[:alert].present? %>
            <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
              <i class="fas fa-exclamation-triangle me-2"></i>
              <%= flash[:alert] %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% end %>

          <% if @client.errors.any? %>
            <div class="alert alert-danger shadow-sm mb-4">
              <h5 class="alert-heading h6 fw-bold"><i class="fas fa-ban me-2"></i> Por favor corrige los siguientes errores:</h5>
              <ul class="mb-0 mt-2 style-none" style="font-size: 0.9rem;">
                <% @client.errors.full_messages.each do |message| %>
                  <li><i class="fas fa-angle-right me-1 text-danger"></i> <%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <%= render 'form', client: @client %>
        </div>
      </div>
    </div>
  </div>
</div>