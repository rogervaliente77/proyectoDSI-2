<div class="login-container">

  <div class="logo">
    <!-- Usamos asset_path o image_tag apuntando a tu carpeta de imágenes o assets -->
    <%= image_tag "logo login.jpg.jpeg", alt: "Logo RRHH" rescue "<img src='https://res.cloudinary.com/dk9edvvmw/image/upload/v1782358861/logo_nuy1am.jpg' alt='Logo RRHH'>".html_safe %>
  </div>

  <!-- Alertas de Rails para credenciales incorrectas -->
  <% if flash[:notice] %>
    <div class="alert alert-success"><%= flash[:notice] %></div>
  <% elsif flash[:alert] %>
    <div class="alert alert-danger"><%= flash[:alert] %></div>
  <% end %>
  
  <div id="error-message" class="alert alert-danger" style="display: none;"></div>

  <%= simple_form_for :user, url: admin_new_login_path, method: :post, html: { class: "login-form", id: "login-form" }, data: { turbo: false } do |form| %>
    <h3>Iniciar Sesión</h3>

    <div class="form-group-field">
      <label>Correo Electrónico</label>
      <%= form.input_field :email, required: true, placeholder: "Ingrese usuario o correo", autocomplete: "email" %>
    </div>

    <div class="form-group-field">
      <label>Contraseña</label>
      <%= form.input_field :password, required: true, placeholder: "Ingrese contraseña", autocomplete: "current-password" %>
    </div>

    <%= form.button :submit, "Ingresar", class: "btn-submit-custom" %>
  <% end %>

  <div class="footer">
    <p>© 2026 RRHH</p>
    <p>Todos los derechos reservados</p>
    <p>Acceso restringido - Solo personal autorizado</p>
  </div>

</div>

<!-- Conservamos tu validación rápida por JS nativo -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("login-form");
    const emailInput = document.querySelector("input[type='text']");
    const passwordInput = document.querySelector("input[type='password']");
    const errorMessage = document.getElementById("error-message");

    if (form) {
      form.addEventListener("submit", function (event) {
        const email = emailInput.value.trim();
        const password = passwordInput.value.trim();

        if (!email || !password) {
          event.preventDefault();
          errorMessage.textContent = "Todos los campos son obligatorios";
          errorMessage.style.display = "block";
        } else {
          errorMessage.style.display = "none";
        }
      });
    }
  });
</script>