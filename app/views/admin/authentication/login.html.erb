<div class="login-container">

  <div class="logo">
    <!-- Usamos asset_path o image_tag apuntando a tu carpeta de imágenes o assets -->
    <%= image_tag "logo_bimers.png", alt: "Logo RRHH" rescue "<img src='https://res.cloudinary.com/dk9edvvmw/image/upload/v1782358861/logo_nuy1am.jpg' alt='Logo RRHH'>".html_safe %>
  </div>

  <!-- TÍTULO DE LA APLICACIÓN -->
  <div class="brand-header">
    <h1 class="brand-title">Bimers <span>Admin</span></h1>
    <div class="brand-divider"></div>
  </div>

  <!-- Alertas de Rails para credenciales incorrectas -->
  <% if flash[:notice] %>
    <div class="alert alert-success"><%= flash[:notice] %></div>
  <% elsif flash[:alert] %>
    <div class="alert alert-danger"><%= flash[:alert] %></div>
  <% end %>
  
  <div id="error-message" class="alert alert-danger" style="display: none;"></div>

  <%= simple_form_for :user, url: admin_new_login_path, method: :post, html: { class: "login-form", id: "login-form" }, data: { turbo: false } do |form| %>
    <h3>Iniciar Sesión</h3>

    <div class="form-group-field">
      <label>Correo Electrónico</label>
      <%= form.input_field :email, required: true, placeholder: "Ingrese usuario o correo", autocomplete: "email" %>
    </div>

    <div class="form-group-field">
      <label>Contraseña</label>
      <%= form.input_field :password, required: true, placeholder: "Ingrese contraseña", autocomplete: "current-password" %>
    </div>

    <%= form.button :submit, "Ingresar", class: "btn-submit-custom" %>
  <% end %>

  <div class="footer">
    <p>© 2026 ferrepro</p>
    <p>Todos los derechos reservados</p>
    <p>Acceso restringido - Solo personal autorizado</p>
  </div>

</div>

<style>
/* ==========================================================================
   TÍTULO DE LA MARCA (Bimers Admin)
   ========================================================================== */
.brand-header {
    text-align: center;
    margin-bottom: 20px;
}

.brand-title {
    color: #ffffff;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin: 0;
    text-transform: uppercase;
}

/* Resalta la palabra 'Admin' con el azul del tema y un sutil resplandor */
.brand-title span {
    color: #3f6cff;
    font-weight: 300;
    text-shadow: 0 0 10px rgba(63, 108, 255, 0.5);
}

/* Línea divisora sutil neón */
.brand-divider {
    width: 50px;
    height: 2px;
    background: linear-gradient(90deg, transparent, #2d5bff, transparent);
    margin: 10px auto 0;
}
</style>