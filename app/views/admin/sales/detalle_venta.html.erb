<!-- Begin Page Content -->
<div class="container-fluid">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Detalle de Venta</h1>
    <%= link_to @back_path, class: "btn btn-sm btn-primary shadow-sm", data: { turbo: false } do %>
      <i class="fas fa-arrow-left fa-sm text-white-50"></i> Volver a ventas
    <% end %>
  </div>

  <%
    # Obtenemos el movimiento de caja asociado a esta venta si existe
    movimiento = @sale.head_movimiento_caja || HeadMovimientoCaja.where(origen_id: @sale.id).first

    # Método de pago desde el código guardado en @sale.forma_pago (o movimiento)
    forma_pago_code = @sale.forma_pago.presence || movimiento&.forma_pago
    forma_pago_obj  = forma_pago_code.present? ? FormaPago.where(codigo: forma_pago_code).first : nil
    metodo_pago_label = forma_pago_obj&.name.presence || (forma_pago_code.present? ? "Código: #{forma_pago_code}" : "No especificado")

    # Condición tributaria
    condicion_tributaria_label = (@sale.condicion_tributaria.presence || @sale.tipo_impuesto.presence || "N/A").to_s.capitalize
  %>

  <div class="row">
    <div class="col-12">
      <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
          <h6 class="m-0 font-weight-bold text-primary">Información General de la Venta</h6>
          <span class="badge badge-success"><%= @sale.code %></span>
        </div>
        <div class="card-body">
          <% if flash[:notice] %>
            <div class="alert alert-success"><%= flash[:notice] %></div>
          <% elsif flash[:alert] %>
            <div class="alert alert-danger"><%= flash[:alert] %></div>
          <% end %>

          <div class="row">
            <!-- Cliente -->
            <div class="col-sm-4 mb-3">
              <label><strong>Cliente</strong></label>
              <input type="text" class="form-control" value="<%= movimiento&.client_name || @sale.client_name %>" readonly>
            </div>

            <!-- Tipo de Comprobante -->
            <div class="col-sm-4 mb-3">
              <label><strong>Tipo de Comprobante</strong></label>
              <input type="text" class="form-control" value="<%= movimiento&.tipo_documento_dte&.name || @sale.tipo_documento_dte&.name || 'Venta Interna' %>" readonly>
            </div>

            <!-- Método de Pago -->
            <div class="col-sm-4 mb-3">
              <label><strong>Método de Pago</strong></label>
              <input type="text" class="form-control font-weight-bold" value="<%= metodo_pago_label %>" readonly>
            </div>

            <!-- Sucursal -->
            <div class="col-sm-4 mb-3">
              <label><strong>Sucursal</strong></label>
              <input type="text" class="form-control" value="<%= movimiento&.sucursal&.name || @sale.sucursal&.name || 'Matriz' %>" readonly>
            </div>

            <!-- Cajero / Caja -->
            <div class="col-sm-4 mb-3">
              <label><strong>Cajero / Caja</strong></label>
              <input type="text" class="form-control" value="<%= "#{movimiento&.cajero&.nombre || @sale.cajero&.nombre} (#{movimiento&.caja&.nombre || @sale.caja&.nombre})" %>" readonly>
            </div>

            <!-- Condición Tributaria -->
            <div class="col-sm-4 mb-3">
              <label><strong>Condición Tributaria</strong></label>
              <input type="text" class="form-control" value="<%= condicion_tributaria_label %>" readonly>
            </div>
          </div>

          <!-- Tabla de productos -->
          <h5 class="mb-3 mt-4">Productos Vendidos</h5>
          <div class="table-responsive">
            <table class="table table-bordered">
              <thead class="thead-light">
                <tr>
                  <th>Producto</th>
                  <th>Cantidad</th>
                  <th>Precio Unitario</th>
                  <th>Oferta</th>
                  <th>Descuento</th>
                  <th>Subtotal</th>
                </tr>
              </thead>
              <tbody>
                <% @product_sales.each do |ps| %>
                  <%
                    unit_price = (ps.unit_price || 0).to_f
                    qty        = (ps.quantity || 0).to_f
                    discount_amount = if ps.respond_to?(:discount) && !ps.discount.nil?
                                        ps.discount.to_f
                                      elsif ps.respond_to?(:discount_porcentage) && ps.discount_porcentage.to_f > 0
                                        (unit_price * qty) * (ps.discount_porcentage.to_f / 100.0)
                                      else
                                        0.0
                                      end
                    subtotal = if ps.respond_to?(:subtotal) && !ps.subtotal.nil?
                                 ps.subtotal.to_f
                               else
                                 (unit_price * qty) - discount_amount
                               end
                  %>
                  <tr>
                    <td><%= ps.product&.name || ps.product_name %></td>
                    <td><%= ps.quantity %></td>
                    <td>$<%= number_with_precision(unit_price, precision: 2) %></td>
                    <td>
                      <% if ps.offer_type.present? %>
                        <span class="badge badge-info">
                          <%= ps.offer_type %><%= ps.respond_to?(:discount_porcentage) && ps.discount_porcentage.to_f > 0 ? " (#{ps.discount_porcentage.to_i}%)" : "" %>
                        </span>
                      <% else %>
                        <span class="badge badge-secondary">N/A</span>
                      <% end %>
                    </td>
                    <td>$<%= number_with_precision(discount_amount, precision: 2) %></td>
                    <td>$<%= number_with_precision(subtotal, precision: 2) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <div class="text-right mt-3">
            <h4>Total de la venta: $<%= number_with_precision(@sale.total_amount || 0, precision: 2) %></h4>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>