<!-- Begin Page Content -->
<div class="container-fluid">

  <!-- Page Heading -->
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Dashboard</h1>
    <%= link_to new_admin_sale_path, 
      class: "d-none d-sm-inline-block btn btn-sm btn-primary shadow-sm", data: { turbo: false } do %>
      <i class="fas fa-plus fa-sm text-white-50"></i> Crear venta
    <% end %>
  </div>

  <!-- Card: Gestión de Ventas -->
  <div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
      <h6 class="m-0 font-weight-bold text-primary">Gestión de ventas</h6>
    </div>

    <!-- Card Body -->
    <div class="card-body">

      <%# Toast Devoluciones %>
      <% if @pending_devoluciones_count.to_i > 0 %>
        <div class="position-fixed top-0 end-0 p-3" style="z-index: 1100;">
          <div id="pendingDevolucionesToast" class="toast align-items-center text-bg-warning border-0 shadow" role="alert">
            <div class="d-flex">
              <div class="toast-body">
                🔔 Hay <%= @pending_devoluciones_count %> devoluciones pendientes de autorizar.
              </div>
              <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Filtros -->
      <div class="row g-2 mb-3">
        <%= form_with url: admin_sales_path, method: :get, local: true, class: "col-12 d-flex flex-wrap gap-2 align-items-end" do |f| %>

          <div class="filter-card flex-fill">
            <%= f.label :code, "Código de Venta", class: "form-label small" %>
            <%= f.text_field :code, value: params[:code], class: "form-control form-control-sm", placeholder: "Ej: V-2026..." %>
          </div>

          <div class="filter-card flex-fill">
            <%= f.label :start_date, "Desde", class: "form-label small" %>
            <%= f.date_field :start_date, value: params[:start_date], class: "form-control form-control-sm" %>
          </div>

          <div class="filter-card flex-fill">
            <%= f.label :end_date, "Hasta", class: "form-label small" %>
            <%= f.date_field :end_date, value: params[:end_date], class: "form-control form-control-sm" %>
          </div>

          <div class="d-flex gap-2 mt-2">
            <%= f.submit "Buscar", class: "btn btn-primary btn-sm" %>
            <%= link_to "Limpiar", admin_sales_path, class: "btn btn-secondary btn-sm" %>
          </div>

        <% end %>
      </div>

      <!-- Tabla de Ventas con Scroll Horizontal -->
      <div class="table-responsive shadow-sm rounded border">
        <table class="table table-bordered table-hover table-striped table-sm compact-sales-table mb-0">
          <thead class="table-dark">
            <tr>
              <th class="text-center">#</th>
              <th>F. Venta</th>
              <th>Código Venta</th>
              <th>Documento</th>
              <th>Condición</th>
              <th>Sucursal</th>
              <th>Cliente</th>
              <th>Caja</th>
              <th>Monto</th>
              <th class="text-center">Devolución</th>
              <th class="text-center">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @sales.each_with_index do |sale, index| %>
              <tr>
                <td class="text-center fw-bold"><%= index + 1 %></td>
                <td><%= sale.sold_at&.strftime('%d/%m/%Y %H:%M') %></td>
                <td><span class="badge bg-dark font-xs"><%= sale.code %></span></td>
                <td>
                  <% if sale.tipo_documento_dte.present? %>
                    <span class="badge bg-info text-dark font-xs"><%= sale.tipo_documento_dte.name %></span>
                  <% else %>
                    <span class="badge bg-secondary font-xs">Sin DTE</span>
                  <% end %>
                </td>
                <td>
                  <span class="badge bg-light text-dark font-xs border">
                    <%= (sale.condicion_tributaria || "gravado").capitalize %>
                  </span>
                </td>
                <td><%= sale.sucursal&.name || sale.caja&.sucursal&.name || "Matriz" %></td>
                <td><%= sale.client_name || "Sin cliente" %></td>
                <td><%= sale.caja&.nombre || "Sin caja" %></td>
                <td class="fw-bold">$<%= number_with_precision(sale.total_amount, precision: 2) %></td>
                <td class="text-center">
                  <% if sale.devoluciones.any? %>
                    <span class="badge bg-success font-xs">SÍ</span>
                  <% else %>
                    <span class="badge bg-secondary font-xs">NO</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <%= link_to detalle_venta_admin_sales_path(id: sale.id), class: "btn btn-xs btn-outline-primary" do %>
                    Ver detalle
                  <% end %>
                  <%= link_to generar_comprobante_admin_sales_path(id: sale.id), target: "_blank", class: "btn btn-xs btn-outline-secondary" do %>
                    <i class="fa fa-print"></i> Comprob
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

    </div>
  </div>

</div>

<!-- Estilos para compactar la tabla y habilitar scroll horizontal si se desborda -->
<style>
  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .compact-sales-table {
    font-size: 0.78rem;
    min-width: 1100px;
  }

  .compact-sales-table th, 
  .compact-sales-table td {
    padding: 0.25rem 0.4rem !important;
    vertical-align: middle;
    white-space: nowrap;
  }

  .btn-xs {
    padding: 0.15rem 0.35rem;
    font-size: 0.72rem;
    border-radius: 0.2rem;
    line-height: 1.2;
  }

  .font-xs {
    font-size: 0.68rem;
    padding: 0.2em 0.4em;
  }
</style>