<div class="modal-header bg-primary text-white">
  <h5 class="modal-title" id="movimientoDetailModalLabel">
    Detalle de Movimiento #<%= @movimiento.numero_control || @movimiento.comprobante_codigo || @movimiento.id %>
  </h5>
  <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
    <span aria-hidden="true">&times;</span>
  </button>
</div>

<div class="modal-body">
  <!-- Cabecera con datos generales -->
  <div class="row mb-3">
    <div class="col-md-6">
      <p class="mb-1">
        <strong><%= @movimiento.origen_tipo == "PagoProveedor" ? "Proveedor:" : "Cliente:" %></strong> 
        <%= @movimiento.client_name %>
      </p>
      <p class="mb-1">
        <strong>Tipo Documento:</strong> 
        <%= @movimiento.tipo_documento_dte&.name || (@movimiento.origen_tipo == "PagoProveedor" ? "Comprobante de Egreso / Pago" : "Venta Interna") %>
      </p>
      <p class="mb-1">
        <strong>Código de Generación (DTE):</strong> <%= @movimiento.codigo_generacion || 'N/A' %>
      </p>
      <% if @movimiento.origen_tipo == "PagoProveedor" && @supplier_payment.present? %>
        <p class="mb-1">
          <strong>Método de Pago:</strong> 
          <span class="badge badge-success"><%= @supplier_payment.payment_method.to_s.upcase %></span>
          <%= " (Ref: #{@supplier_payment.reference_number})" if @supplier_payment.reference_number.present? %>
        </p>
      <% end %>
    </div>
    <div class="col-md-6">
      <p class="mb-1"><strong>Fecha:</strong> <%= @movimiento.created_at.strftime("%d/%m/%Y %I:%M %p") %></p>
      <p class="mb-1"><strong>Caja / Sucursal:</strong> <%= "#{@movimiento.caja&.nombre} / #{@movimiento.sucursal&.name}" %></p>
      <p class="mb-1"><strong>Cajero:</strong> <%= @movimiento.cajero&.nombre %></p>
    </div>
  </div>

  <h6 class="font-weight-bold text-primary border-bottom pb-2">Ítems Registrados</h6>
  <div class="table-responsive">
    <table class="table table-sm table-bordered text-center">
      <thead class="thead-light">
        <tr>
          <th>Ítem / Concepto</th>
          <th>Tipo</th>
          <th>Cantidad</th>
          <th>Precio Unit.</th>
          <th>Descuento</th>
          <th>Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% if @movimiento.origen_tipo == "PagoProveedor" %>
          <!-- CASO 1: PAGO A PROVEEDOR (Usa det_movimientos_caja) -->
          <% if @movimiento.det_movimientos_caja.any? %>
            <% @movimiento.det_movimientos_caja.each do |det| %>
              <tr>
                <td class="text-left"><%= det.item_nombre %></td>
                <td><span class="badge badge-warning">Egreso / Pago</span></td>
                <td><%= det.cantidad %></td>
                <td>$<%= number_with_precision(det.precio_unitario, precision: 2) %></td>
                <td>$<%= number_with_precision(det.descuento || 0, precision: 2) %></td>
                <td>$<%= number_with_precision(det.subtotal, precision: 2) %></td>
              </tr>
            <% end %>
          <% elsif @supplier_payment.present? %>
            <tr>
              <td class="text-left"><%= @supplier_payment.notes.presence || "Pago a Factura #{@supplier_invoice&.invoice_number}" %></td>
              <td><span class="badge badge-warning">Egreso / Pago</span></td>
              <td>1</td>
              <td>$<%= number_with_precision(@supplier_payment.amount, precision: 2) %></td>
              <td>$0.00</td>
              <td>$<%= number_with_precision(@supplier_payment.amount, precision: 2) %></td>
            </tr>
          <% else %>
            <tr>
              <td colspan="6" class="text-center text-muted">Sin detalles registrados en el pago</td>
            </tr>
          <% end %>

        <% elsif @service_order.present? %>
          <!-- CASO 2: ORDEN DE SERVICIO -->
          <% @service_order.order_services.each do |serv| %>
            <% subtotal = (serv.cantidad || 0) * (serv.precio_unitario || 0) %>
            <tr>
              <td class="text-left"><%= serv.descripcion %></td>
              <td><span class="badge badge-info">Servicio</span></td>
              <td><%= serv.cantidad %></td>
              <td>$<%= number_with_precision(serv.precio_unitario, precision: 2) %></td>
              <td>$0.00</td>
              <td>$<%= number_with_precision(subtotal, precision: 2) %></td>
            </tr>
          <% end %>

          <% @service_order.order_items.each do |item| %>
            <% subtotal = (item.cantidad || 0) * (item.precio_unitario || 0) %>
            <tr>
              <td class="text-left"><%= item.descripcion %></td>
              <td><span class="badge badge-secondary"><%= item.tipo || 'Repuesto' %></span></td>
              <td><%= item.cantidad %></td>
              <td>$<%= number_with_precision(item.precio_unitario, precision: 2) %></td>
              <td>$0.00</td>
              <td>$<%= number_with_precision(subtotal, precision: 2) %></td>
            </tr>
          <% end %>

          <% if @service_order.order_services.empty? && @service_order.order_items.empty? %>
            <tr>
              <td colspan="6" class="text-center text-muted">Sin detalles registrados en la orden de servicio</td>
            </tr>
          <% end %>

        <% elsif @product_sales.present? %>
          <!-- CASO 3: VENTA DE PRODUCTOS -->
          <% @product_sales.each do |ps| %>
            <% 
              qty = ps.quantity || 0
              price = ps.unit_price || 0
              discount_decimal = (price * qty) * ((ps.discount || 0) / 100.0)
              subtotal = (price * qty) - discount_decimal 
              tipo_prod = ps.product&.kind&.capitalize || 'Producto'
            %>
            <tr>
              <td class="text-left"><%= ps.product&.name || ps.product_name %></td>
              <td>
                <span class="badge <%= tipo_prod == 'Servicio' ? 'badge-info' : 'badge-primary' %>">
                  <%= tipo_prod %>
                </span>
              </td>
              <td><%= qty %></td>
              <td>$<%= number_with_precision(price, precision: 2) %></td>
              <td>$<%= number_with_precision(discount_decimal, precision: 2) %></td>
              <td>$<%= number_with_precision(subtotal, precision: 2) %></td>
            </tr>
          <% end %>

        <% else %>
          <tr>
            <td colspan="6" class="text-center text-muted">Sin ítems detallados en el movimiento</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="text-right mt-3">
    <h4>
      Total: 
      <span class="<%= @movimiento.origen_tipo == 'PagoProveedor' ? 'text-danger' : 'text-success' %>">
        $<%= number_with_precision(@movimiento.monto_total || 0, precision: 2) %>
      </span>
    </h4>
  </div>
</div>

<div class="modal-footer">
  <%= link_to descargar_comprobante_admin_sale_path(@movimiento.id, format: :pdf), class: "btn btn-success", data: { turbo: false } do %>
    <i class="fas fa-download"></i> Descargar Comprobante
  <% end %>
  <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
</div>