<% if @movimientos.empty? %>
  <div class="alert alert-warning text-center mb-0">
    No se encontraron movimientos de caja con los criterios seleccionados.
  </div>
<% else %>
  <table class="table table-bordered table-striped text-center align-middle" width="100%" cellspacing="0">
    <thead class="thead-light">
      <tr>
        <th>Fecha / Hora</th>
        <th>Comprobante / N° Control</th>
        <th>Cliente</th>
        <th>Tipo Producto</th>
        <th>Caja / Sucursal</th>
        <th>Cajero</th>
        <th>Total</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% @movimientos.each do |mov| %>
        <% 
          # 1. Verificamos si es una Orden de Servicio
          if mov.service_order_id.present?
            badge_tipo = '<span class="badge badge-info"><i class="fas fa-tools mr-1"></i>Servicio</span>'
            monto_total_calc = mov.monto_total

          # 2. Verificamos si es una Venta (Sale)
          elsif mov.sale_id.present? || mov.sale.present?
            sale = mov.sale || Sale.where(id: mov.sale_id || mov.origen_id).first
            tipos_productos = sale ? sale.product_sales.map { |ps| ps.product&.kind }.compact.uniq : []

            badge_tipo = if tipos_productos.include?('producto') && tipos_productos.include?('servicio')
                           '<span class="badge badge-warning">Mixto</span>'
                         elsif tipos_productos.include?('servicio')
                           '<span class="badge badge-info">Servicio</span>'
                         else
                           '<span class="badge badge-primary">Producto</span>'
                         end
            monto_total_calc = mov.monto_total || sale&.total_amount

          # 3. Fallback para registros previos usando origen_id
          else
            service_order = ServiceOrder.where(id: mov.origen_id).first
            if service_order.present?
              badge_tipo = '<span class="badge badge-info"><i class="fas fa-tools mr-1"></i>Servicio</span>'
              monto_total_calc = mov.monto_total || service_order.total
            else
              sale = Sale.where(id: mov.origen_id).first
              badge_tipo = '<span class="badge badge-primary">Producto</span>'
              monto_total_calc = mov.monto_total || sale&.total_amount
            end
          end
        %>
        <tr>
          <td><%= mov.created_at.strftime("%d/%m/%Y %I:%M %p") %></td>
          <td>
            <strong><%= mov.numero_control || mov.comprobante_codigo || 'N/A' %></strong>
            <br>
            <small class="text-muted"><%= mov.tipo_documento_dte&.name || 'Venta Interna' %></small>
          </td>
          <td><%= mov.client_name || 'Cliente General' %></td>
          <td><%= badge_tipo.html_safe %></td>
          <td><%= "#{mov.caja&.nombre || 'N/A'} / #{mov.sucursal&.name || 'Matriz'}" %></td>
          <td><%= mov.cajero&.nombre || 'Desconocido' %></td>
          <td class="font-weight-bold text-success">$<%= number_with_precision(monto_total_calc || 0, precision: 2) %></td>
          <td>
            <div class="btn-group" role="group">
              <!-- Botón Ver Detalle (Modal) -->
              <button type="button" class="btn btn-sm btn-info btn-ver-detalle-movimiento" data-id="<%= mov.id %>" title="Ver Detalle">
                <i class="fas fa-eye"></i>
              </button>

              <!-- Botón Descargar Comprobante -->
              <%= link_to descargar_comprobante_admin_sale_path(mov.id, format: :pdf), class: "btn btn-sm btn-success", title: "Descargar Comprobante", data: { turbo: false } do %>
                <i class="fas fa-download"></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>