<% if @movimientos.empty? %>
  <div class="alert alert-warning text-center mb-0">
    No se encontraron movimientos de caja con los criterios seleccionados.
  </div>
<% else %>
  <table class="table table-bordered table-striped text-center align-middle" width="100%" cellspacing="0">
    <thead class="thead-light">
      <tr>
        <th>Fecha / Hora</th>
        <th>Comprobante / N° Control</th>
        <th>Cliente / Proveedor</th>
        <th>Tipo</th>
        <th>Caja / Sucursal</th>
        <th>Cajero</th>
        <th>Total</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% @movimientos.each do |mov| %>
        <% 
          # Identificación directa utilizando origen_tipo
          case mov.origen_tipo
          when 'VentaServicio'
            badge_tipo = '<span class="badge badge-info"><i class="fas fa-tools mr-1"></i>Fac. Servicios</span>'
            monto_class = 'text-success'
            monto_prefix = '+'
          when 'VentaProducto'
            badge_tipo = '<span class="badge badge-primary"><i class="fas fa-box mr-1"></i>Venta producto</span>'
            monto_class = 'text-success'
            monto_prefix = '+'
          when 'PagoProveedor'
            badge_tipo = '<span class="badge badge-danger"><i class="fas fa-truck mr-1"></i>Pago Proveedor</span>'
            monto_class = 'text-danger'
            monto_prefix = '-'
          else
            # Fallback en caso de que sea un registro viejo sin origen_tipo
            if mov.service_order_id.present?
              badge_tipo = '<span class="badge badge-info"><i class="fas fa-tools mr-1"></i>Fac. Servicio</span>'
            elsif mov.supplier_invoice_id.present?
              badge_tipo = '<span class="badge badge-danger"><i class="fas fa-truck mr-1"></i>Pago Proveedor</span>'
            else
              badge_tipo = '<span class="badge badge-secondary">General</span>'
            end
            monto_class = 'text-dark'
            monto_prefix = ''
          end
        %>
        <tr>
          <td><%= mov.created_at&.strftime("%d/%m/%Y %I:%M %p") %></td>
          <td>
            <strong><%= mov.numero_control.presence || mov.comprobante_codigo.presence || 'N/A' %></strong>
            <br>
            <small class="text-muted"><%= mov.tipo_documento_dte&.name || 'Venta Interna' %></small>
          </td>
          <td><%= mov.client_name || 'Cliente General' %></td>
          <td><%= badge_tipo.html_safe %></td>
          <td><%= "#{mov.caja&.nombre || 'N/A'} / #{mov.sucursal&.name || 'Matriz'}" %></td>
          <td><%= mov.cajero&.nombre || 'Desconocido' %></td>
          <td class="font-weight-bold <%= monto_class %>">
            <%= monto_prefix %>$<%= number_with_precision(mov.monto_total || 0, precision: 2) %>
          </td>
          <td>
            <div class="btn-group" role="group">
              <!-- Botón Ver Detalle (Modal) -->
              <button type="button" class="btn btn-sm btn-info btn-ver-detalle-movimiento" data-id="<%= mov.id %>" title="Ver Detalle">
                <i class="fas fa-eye"></i>
              </button>

              <!-- Botón Descargar Comprobante -->
              <%= link_to descargar_comprobante_admin_sale_path(mov.id, format: :pdf), class: "btn btn-sm btn-success", title: "Descargar Comprobante", data: { turbo: false } do %>
                <i class="fas fa-download"></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>