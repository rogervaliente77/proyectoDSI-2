<div class="container-fluid py-4">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      <i class="fas fa-edit me-2 text-warning"></i>Editar Plantilla: <%= @template.name %>
    </h1>
    <%= link_to admin_email_templates_path, class: "btn btn-secondary btn-sm shadow-sm", data: { turbo: false } do %>
      <i class="fas fa-arrow-left me-1"></i> Volver al listado
    <% end %>
  </div>

  <%# Renderiza el mismo formulario parcial con los datos existentes %>
  <%= render "form", template: @template %>
</div>