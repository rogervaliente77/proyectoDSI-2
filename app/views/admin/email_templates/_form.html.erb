<%= form_with(model: [:admin, template], local: true, data: { turbo: false }) do |f| %>
  <div class="row">
    <div class="col-lg-7">
      <div class="card shadow mb-4 border-0">
        <div class="card-body">
          
          <div class="mb-4">
            <label class="form-label font-weight-bold text-dark">1. Selecciona un Tema de la BD</label>
            <div class="row g-2">
              <% EmailTheme.all.each do |theme| %>
                <div class="col-4">
                  <input type="radio" 
                         name="email_template[email_theme_id]" 
                         id="theme_<%= theme.id %>" 
                         value="<%= theme.id %>" 
                         class="btn-check theme-radio" 
                         data-theme-config='<%= theme.to_json_config %>'
                         <%= 'checked' if template.email_theme_id == theme.id %>>
                  
                  <label class="btn btn-outline-light text-dark w-100 p-2 text-start border shadow-sm h-100 theme-card-label" for="theme_<%= theme.id %>">
                    <div class="d-flex align-items-center mb-1">
                      <span class="rounded-circle me-2" style="width: 14px; height: 14px; background-color: <%= theme.primary_color %>;"></span>
                      <small class="fw-bold"><%= theme.name %></small>
                    </div>
                  </label>
                </div>
              <% end %>
            </div>
          </div>

          <div class="mb-3">
            <%= f.label :name, "Nombre de la Plantilla", class: "form-label font-weight-bold" %>
            <%= f.text_field :name, class: "form-control", required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :subject, "Asunto", class: "form-label font-weight-bold" %>
            <%= f.text_field :subject, class: "form-control", id: "input_subject", required: true %>
          </div>

          <div class="mb-3">
            <%= f.label :body_html, "Cuerpo", class: "form-label font-weight-bold" %>
            <%= f.hidden_field :body_html, id: "body_html_input" %>
            <trix-editor input="body_html_input" class="form-control bg-white" style="min-height: 200px;"></trix-editor>
          </div>

          <div class="d-flex justify-content-end gap-2">
            <%= link_to "Cancelar", admin_email_templates_path, class: "btn btn-secondary", data: { turbo: false } %>
            <%= f.submit "Guardar Plantilla", class: "btn btn-primary" %>
          </div>

        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6 mb-3">
        <%= f.label :email_theme_id, "Tema de Correo", class: "form-label" %>
        <%= f.collection_select :email_theme_id, EmailTheme.all, :id, :name, { include_blank: "Seleccionar tema..." }, { class: "form-select" } %>
      </div>

      <div class="col-md-6 mb-3">
        <%= f.label :customer_list_id, "Lista de Destinatarios", class: "form-label" %>
        <%= f.collection_select :customer_list_id, CustomerList.all, :id, :name, { include_blank: "Seleccionar lista de clientes..." }, { class: "form-select" } %>
      </div>
    </div>

    <!-- Vista Previa Combinada (Tema BD + Contenido) -->
    <div class="col-lg-5">
      <div class="card shadow mb-4 border-0 sticky-top" style="top: 20px;">
        <div class="card-header py-3 bg-dark text-white">
          <span class="small font-weight-bold"><i class="fas fa-desktop me-2"></i>Vista Previa en Vivo</span>
        </div>
        <div id="preview_wrapper" class="card-body p-4">
          <h6 id="preview_subject" class="fw-bold mb-3"></h6>
          <div id="preview_card" class="p-4 rounded shadow-sm">
            <div id="preview_header" class="mb-2"></div>
            <div id="preview_body" class="trix-content"></div>
            <div id="preview_footer" class="mt-2"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const themeRadios = document.querySelectorAll('.theme-radio');
    const previewWrapper = document.getElementById('preview_wrapper');
    const previewCard = document.getElementById('preview_card');
    const previewHeader = document.getElementById('preview_header');
    const previewFooter = document.getElementById('preview_footer');
    const previewBody = document.getElementById('preview_body');
    const previewSubject = document.getElementById('preview_subject');
    const subjectInput = document.getElementById('input_subject');
    const trixInput = document.getElementById('body_html_input');

    function applyTheme(config) {
      previewWrapper.style.backgroundColor = config.background_color;
      previewCard.style.backgroundColor = config.card_bg_color;
      previewCard.style.color = config.text_color;
      previewCard.style.borderTop = `5px solid ${config.primary_color}`;
      previewHeader.innerHTML = config.header_html;
      previewFooter.innerHTML = config.footer_html;
    }

    themeRadios.forEach(radio => {
      radio.addEventListener('change', function() {
        if (this.checked) applyTheme(JSON.parse(this.dataset.themeConfig));
      });
      if (radio.checked) applyTheme(JSON.parse(radio.dataset.themeConfig));
    });

    if (subjectInput) {
      subjectInput.addEventListener('input', () => previewSubject.textContent = subjectInput.value);
      previewSubject.textContent = subjectInput.value;
    }

    document.addEventListener("trix-change", function() {
      previewBody.innerHTML = trixInput.value;
    });
    previewBody.innerHTML = trixInput.value;
  });
</script>