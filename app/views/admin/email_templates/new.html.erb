<div class="container-fluid py-4">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
      <i class="fas fa-plus-circle me-2 text-primary"></i>Nueva Plantilla de Correo
    </h1>
    <%= link_to admin_email_templates_path, class: "btn btn-secondary btn-sm shadow-sm", data: { turbo: false } do %>
      <i class="fas fa-arrow-left me-1"></i> Volver al listado
    <% end %>
  </div>

  <%# Renderiza el formulario parcial %>
  <%= render "form", template: @template %>
</div>