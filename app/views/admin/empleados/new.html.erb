
<div class="container-fluid">
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Recursos Humanos</h1>
        <%= link_to admin_empleados_path, data: { turbo: false }, class: "d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm" do %>
          <i class="fas fa-arrow-left fa-sm text-white-50"></i> Volver a empleados
        <% end %>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Registro de Nuevo Empleado</h6>
                </div>
                
                <%# app/views/admin/empleados/new.html.erb %>
                <div class="card-body">
                    <%= render 'form', empleado: @empleado %>
                </div>
            </div>
        </div>                     
    </div>
</div>

