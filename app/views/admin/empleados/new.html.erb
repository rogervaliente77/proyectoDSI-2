<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Recursos Humanos</h1>
        <%= link_to admin_empleados_path, data: { turbo: false }, class: "d-none d-sm-inline-block btn btn-sm btn-secondary shadow-sm" do %>
          <i class="fas fa-arrow-left fa-sm text-white-50"></i> Volver a empleados
        <% end %>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Registro de Nuevo Empleado</h6>
                </div>
                
                <div class="card-body">
                    <%# 1. CAPTURADOR DE ERREORES DEL FLASH %>
                    <% if flash[:alert].present? %>
                      <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <%= flash[:alert] %>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                      </div>
                    <% end %>

                    <%# 2. CAPTURADOR ESPECÍFICO DEL MODELO (Por si el flash no se pasa por Turbo) %>
                    <% if @empleado.errors.any? %>
                      <div class="alert alert-danger shadow-sm mb-4">
                        <h5 class="alert-heading h6 fw-bold"><i class="fas fa-ban me-2"></i> Por favor corrige los siguientes errores:</h5>
                        <ul class="mb-0 mt-2 style-none" style="font-size: 0.9rem;">
                          <% @empleado.errors.full_messages.each do |message| %>
                            <li><i class="fas fa-angle-right me-1 text-danger"></i> <%= message %></li>
                          <% end %>
                        </ul>
                      </div>
                    <% end %>

                    <%= render 'form', empleado: @empleado %>
                </div>
            </div>
        </div>                     
    </div>
</div>