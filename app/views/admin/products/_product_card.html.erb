<% 
  # Verificación de vigencia de la oferta
  exp_date = product.offer_expires_at
  offer_active = product.offer.present? && (exp_date.blank? || exp_date.to_date >= Date.current)
  offer = offer_active ? product.offer : nil
%>

<div class="card h-100 shadow-sm product-card position-relative border-0 rounded-3 overflow-hidden">

  <!-- Badges -->
  <% if product.quantity.to_i > 0 %>
    <span class="badge badge-top-right bg-success">
      <i class="fas fa-check-circle me-1"></i> Disponible
    </span>
  <% else %>
    <span class="badge badge-top-right bg-secondary">
      <i class="fas fa-times-circle me-1"></i> Agotado
    </span>
  <% end %>

  <!-- Badge de Oferta Asociada (solo si está activa y vigente) -->
  <% if offer.present? %>
    <span class="badge badge-top-left bg-warning text-dark">
      <i class="fas fa-gift me-1"></i> <%= offer.display_name %>
    </span>
  <% end %>

  <!-- Carrusel -->
  <div class="custom-carousel" data-current="0">
    <% images = product.product_images.select { |img| img.image_url.present? }.sort_by(&:image_index) rescue [] %>
    <% if images.any? %>
      <% images.each_with_index do |img, index| %>
        <img src="<%= img.image_url %>" 
             class="carousel-image <%= 'active' if index.zero? %>" 
             alt="<%= product.name %> imagen <%= index+1 %>">
      <% end %>
      <button type="button" class="prev" onclick="prevSlide(this)">‹</button>
      <button type="button" class="next" onclick="nextSlide(this)">›</button>
      <div class="carousel-indicators">
        <% images.each_with_index do |img, index| %>
          <span class="dot <%= 'active' if index.zero? %>" onclick="goToSlide(this, <%= index %>)"></span>
        <% end %>
      </div>
    <% else %>
      <img src="https://via.placeholder.com/300x240" class="carousel-image active" alt="Placeholder">
    <% end %>
  </div>

  <!-- Información -->
  <div class="card-body">
    <h5 class="card-title text-primary fw-bold mb-1"><%= product.name %></h5>
    <p class="card-text text-muted small mb-2"><%= truncate(product.description, length: 80) %></p>

    <!-- Detalle de Mayoreo -->
    <% if offer&.offer_type&.upcase == "MAYOREO" && product.wholesale_quantity.to_i > 0 %>
      <div class="p-2 mb-2 bg-light border rounded text-info small">
        <i class="fas fa-boxes me-1"></i>
        <strong>Mayoreo:</strong> A partir de <strong><%= product.wholesale_quantity %></strong> unidades
        <% if product.discount.to_f > 0 %>
          <span class="badge bg-info text-dark ms-1">-<%= product.discount.to_i %>% OFF</span>
        <% end %>
      </div>
    <% end %>

    <!-- Precios y Descuentos -->
    <p class="mb-2">
      <% offer_type_upcase = offer&.offer_type&.upcase %>
      
      <% if offer_type_upcase == "DESCUENTO" && product.discount.to_f > 0 %>
        <span class="text-muted text-decoration-line-through me-1"><%= number_to_currency(product.price) %></span>
        <span class="badge bg-danger ms-1 me-2">-<%= product.discount.to_i %>% OFF</span><br>
        <span class="fw-bold text-success fs-5"><%= number_to_currency(product.discounted_price.round(2)) %></span>

      <% elsif offer_type_upcase == "MAYOREO" && product.discount.to_f > 0 %>
        <span class="fw-bold text-success fs-5"><%= number_to_currency(product.price) %></span>
        <span class="badge bg-info text-dark ms-2">-<%= product.discount.to_i %>% OFF en mayoreo</span>

      <% elsif offer.present? %>
        <span class="fw-bold text-success fs-5"><%= number_to_currency(product.price) %></span>

      <% else %>
        <span class="fw-bold fs-5"><%= number_to_currency(product.price) %></span>
      <% end %>
    </p>

    <!-- FECHA DE EXPIRACIÓN DE OFERTA -->
    <% if offer.present? %> 
      <p class="mb-2 text-danger small">
        <i class="fas fa-clock me-1"></i>
        <strong>Oferta Expira:</strong> 
        <% if exp_date.present? %>
          <%= exp_date.respond_to?(:strftime) ? exp_date.strftime("%d/%m/%Y") : exp_date %>
        <% else %>
          <span>Por tiempo limitado</span>
        <% end %>
      </p>
    <% end %>

    <!-- PRECIO ADQUISICIÓN / COSTO -->
    <p class="mb-1 text-secondary small">
      <strong>Precio Adquisición:</strong> 
      <% if product.respond_to?(:cost_price) && product.cost_price.present? %>
        <span class="fw-bold text-dark"><%= number_to_currency(product.cost_price) %></span>
      <% else %>
        <span class="text-muted fst-italic">Sin precio de adquisición</span>
      <% end %>
    </p>

    <!-- PROVEEDOR -->
    <p class="mb-1 text-secondary small">
      <strong>Proveedor:</strong> 
      <% if product.respond_to?(:supplier) && product.supplier&.name.present? %>
        <span class="badge bg-info text-white text-uppercase"><%= product.supplier.name %></span>
      <% else %>
        <span class="text-muted fst-italic">Sin proveedor</span>
      <% end %>
    </p>

    <p class="mb-0"><strong>Disponibilidad:</strong> <%= product.quantity %></p>
    <p class="mb-0"><strong>Categoría:</strong> <%= product.category&.name&.upcase || "SIN CATEGORÍA" %></p>
    <p class="mb-0"><strong>Marca:</strong> <%= product.marca&.name&.upcase || "SIN MARCA" %></p>
    <p class="mb-0">
      <strong>Tipo Vehículo:</strong> 
      <% if product.respond_to?(:car_type) && product.car_type.present? %>
        <span class="badge bg-light text-dark border"><%= product.car_type.name.upcase %></span>
      <% elsif product.respond_to?(:car_type_id) && product.car_type_id.present? %>
        <span class="badge bg-light text-dark border"><%= product.car_type_id %></span>
      <% else %>
        <span class="text-muted">Universal</span>
      <% end %>
    </p>
    <p class="mb-0"><strong>Código:</strong> <%= product.code %></p>
  </div>

  <!-- Botones -->
  <% if @current_user&.role&.name.in?(["super_admin","admin"]) %>
    <div class="btn-group w-100 p-2">
      <%= link_to admin_edit_product_path(product_id: product.id), 
        class:"btn btn-primary btn-sm", data: { turbo: false } do %>
        <i class="fa fa-edit"></i> Editar
      <% end %>
      <%= link_to admin_destroy_product_path(product_id: product.id), class:"btn btn-danger btn-sm", data:{ turbo_method: :delete }, onclick:"return confirm('¿Eliminar producto?');" do %>
        <i class="fa fa-trash"></i> Eliminar
      <% end %>
    </div>
  <% end %>

</div>