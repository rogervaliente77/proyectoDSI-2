<div class="container-fluid py-4">

  <!-- Encabezado y Botón Excel -->
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 text-dark fw-bold mb-0">📦 Inventario de Productos</h1>
    
    <%= link_to url_for(params.to_unsafe_h.merge(format: :xlsx)), class: "btn btn-success fw-bold shadow-sm" do %>
      <i class="fas fa-file-excel me-1"></i> Exportar a Excel
    <% end %>
  </div>

  <!-- Filtro de búsqueda -->
  <div class="card p-3 mb-4 shadow-sm rounded">
    <%= form_with url: "/admin/productos/inventario", method: :get, local: true, class: "row g-3" do %>
      <%= hidden_field_tag :status, @current_status %>
      <div class="col-md-6">
        <%= text_field_tag :query, params[:query], placeholder: "🔍 Buscar por nombre o código...", class: "form-control form-control-lg shadow-sm" %>
      </div>
      <div class="col-md-3">
        <%= submit_tag "Buscar", class: "btn btn-primary btn-lg w-100 shadow-sm" %>
      </div>
      <div class="col-md-3">
        <%= link_to "Limpiar", "/admin/productos/inventario?status=#{@current_status}", class: "btn btn-outline-secondary btn-lg w-100 shadow-sm" %>
      </div>
    <% end %>
  </div>

  <!-- Pestañas de estado (Tabs) -->
  <ul class="nav nav-tabs mb-3 border-bottom-0">
    <li class="nav-item">
      <%= link_to "/admin/productos/inventario?status=stock_bajo#{'&query=' + params[:query] if params[:query].present?}", 
                  class: "nav-link fw-bold #{'active text-danger border-bottom-0' if @current_status == 'stock_bajo'}" do %>
        ⚠️ Stock Bajo (≤ 15)
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to "/admin/productos/inventario?status=todos#{'&query=' + params[:query] if params[:query].present?}", 
                  class: "nav-link fw-bold #{'active text-primary border-bottom-0' if @current_status == 'todos'}" do %>
        📋 Todos los Productos
      <% end %>
    </li>
  </ul>

  <!-- Tabla de inventario -->
  <div class="card shadow-sm rounded">
    <div class="table-responsive">
      <table id="tabla-inventario" class="table table-hover table-bordered align-middle mb-0">
        <thead class="table-dark text-white">
          <tr>
            <th class="fw-semibold text-uppercase text-center" style="width: 60px;">No</th>
            <th class="fw-semibold text-uppercase text-center">Código</th>
            <th class="fw-semibold text-uppercase">Nombre</th>
            <th class="fw-semibold text-uppercase">Categoría</th>
            <th class="fw-semibold text-uppercase">Marca</th>
            <th class="fw-semibold text-uppercase text-center">Precio Compra</th>
            <th class="fw-semibold text-uppercase text-center">Precio Venta</th>
            <th class="fw-semibold text-uppercase text-center">Stock</th>
          </tr>
        </thead>
        <tbody>
          <% if @products.present? %>
            <% offset = (@products.current_page - 1) * @products.limit_value %>
            <% total_costo_pagina = 0 %>
            <% total_venta_pagina = 0 %>

            <% @products.each_with_index do |product, index| %>
              <% qty = product.quantity.to_i %>
              <% total_costo_pagina += (product&.cost_price.to_f * qty) %>
              <% total_venta_pagina += (product.price.to_f * qty) %>

              <tr class="align-middle">
                <td class="text-center fw-bold text-muted"><%= offset + index + 1 %></td>
                <td class="text-muted text-center"><%= product.code %></td>
                <td class="fw-semibold"><%= product.name %></td>
                <td><%= product.category&.name || "—" %></td>
                <td><%= product.marca&.name || "—" %></td>
                <td class="text-center">
                  <span class="badge bg-light text-dark px-3 py-2 shadow-sm">
                    <%= number_to_currency(product&.cost_price) %>
                  </span>
                </td>
                <td class="text-center">
                  <span class="badge bg-light text-dark px-3 py-2 shadow-sm">
                    <%= number_to_currency(product.price) %>
                  </span>
                </td>
                <td class="text-center">
                  <% if qty > 25 %>
                    <span class="badge px-3 py-2 shadow-sm" style="background-color:#d4edda; color:#155724;">
                      ✅ <%= qty %>
                    </span>
                  <% elsif qty > 15 %>
                    <span class="badge px-3 py-2 shadow-sm" style="background-color:#fff3cd; color:#856404;">
                      ⚠️ <%= qty %>
                    </span>
                  <% else %>
                    <span class="badge px-3 py-2 shadow-sm" style="background-color:#f8d7da; color:#721c24;">
                      ❌ <%= qty %>
                    </span>
                  <% end %>
                </td>
              </tr>
            <% end %>

            <!-- Filas resumen de la página actual -->
            <!-- Filas de Totales Globales de la Búsqueda / Filtro -->
            <tr class="table-light fw-bold text-dark border-top border-2">
              <td colspan="5" class="text-end">Total Valor Adquisición (Todos los productos filtrados):</td>
              <td colspan="3" class="text-start text-primary ps-4">
                <%= number_to_currency(@total_cost_all) %>
              </td>
            </tr>
            <tr class="table-secondary fw-bold text-dark">
              <td colspan="5" class="text-end">Total Valor Venta (Todos los productos filtrados):</td>
              <td colspan="3" class="text-start text-success ps-4">
                <%= number_to_currency(@total_sale_all) %>
              </td>
            </tr>
          <% else %>
            <tr>
              <td colspan="8" class="text-center text-muted py-4">
                No hay productos en esta sección
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Paginación -->
    <% if @products.respond_to?(:total_pages) && @products.total_pages > 1 %>
      <div class="card-footer bg-white d-flex justify-content-center py-3">
        <%= paginate @products, params: { status: @current_status, query: params[:query] } %>
      </div>
    <% end %>
  </div>
</div>

<!-- Librería SheetJS para exportar a Excel directamente desde HTML -->
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<script>
  function exportTableToExcel(tableID, filename = '') {
    const table = document.getElementById(tableID);
    const wb = XLSX.utils.table_to_book(table, { sheet: "Inventario" });
    const name = filename ? filename + '.xlsx' : 'reporte_inventario.xlsx';
    XLSX.writeFile(wb, name);
  }
</script>