<% 
  # Detectamos si viene algún filtro activo en la URL
  has_filters = params[:active_tab] == "all_products" || 
                params[:query].present? || 
                params[:category_id].present? || 
                params[:marca_id].present? || 
                params[:car_type_id].present? || 
                params[:min_price].present? || 
                params[:max_price].present? || 
                params[:offer].present?
%>

<div class="container-fluid min-vh-100 py-4">

  <!-- Alert Flashes -->
  <% if flash[:notice] || flash[:success] %>
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
      <i class="fas fa-check-circle me-2"></i><%= flash[:notice] || flash[:success] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <% if flash[:alert] || flash[:error] %>
    <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
      <i class="fas fa-exclamation-triangle me-2"></i><%= flash[:alert] || flash[:error] %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <!-- Encabezado -->
  <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between mb-4 gap-2">
    <h1 class="h3 text-gray-800 mb-0 fw-bold">
      <% if @current_user&.role&.name.in?(["super_admin","admin","cajero"]) %>
        <i class="fas fa-boxes text-primary me-2"></i> Catálogo de Productos
      <% else %>
        <i class="fas fa-store text-primary me-2"></i> Portal de Productos
      <% end %>
    </h1>

    <% if @current_user&.role&.name.in?(["super_admin","admin"]) %>
      <%= link_to admin_productos_new_path, class: "btn btn-primary shadow-sm text-nowrap" do %>
        <i class="fas fa-plus-circle me-1"></i> Crear Producto
      <% end %>
    <% end %>
  </div>

  <!-- Pestañas de Navegación (Tabs) -->
  <div class="card shadow-sm border-0 mb-4">

    <div class="card-body p-3 p-md-4 bg-light">
      
      <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-white p-3 rounded-3 shadow-sm border mb-0" id="category-explorer-breadcrumb">
          <!-- Renderizado dinámicamente con JS -->
        </ol>
      </nav>

      <!-- SECCIÓN DE CARDS DE CATEGORÍAS -->
      <div class="card border-0 shadow-sm rounded-3 mb-4 p-3 bg-white">
        <h5 class="fw-bold text-dark mb-3" id="current-category-title">
          <i class="fas fa-folder-open text-primary me-2"></i> Seleccione una Categoría
        </h5>

        <!-- Grid optimizado con g-2 para aprovechar el ancho -->
        <div class="row g-1" id="categories-cards-grid">
          <% @categories.each do |cat| %>
            <% 
              parent_id_val = cat.parent_id.present? ? cat.parent_id.to_s : "root"
              subcategories_count = cat.respond_to?(:subcategories) ? cat.subcategories.count : 0
            %>
            <!-- Distribución: 2 por fila en móvil (col-6), 4 en tablet (col-md-3), 6 en escritorio (col-lg-2) -->
            <div class="col-6 col-sm-4 col-md-3 col-lg-2 category-card-item" 
                 data-id="<%= cat.id %>" 
                 data-parent-id="<%= parent_id_val %>"
                 data-name="<%= cat.name %>"
                 data-subcategories-count="<%= subcategories_count %>">

              <div class="card h-100 border hover-category-card shadow-sm rounded-3 overflow-hidden cursor-pointer">
                <% if cat.respond_to?(:image_url) && cat.image_url.present? %>
                  <img src="<%= cat.image_url %>" class="card-img-top cat-img-height" alt="<%= cat.name %>">
                <% else %>
                  <div class="bg-light d-flex align-items-center justify-content-center text-muted cat-img-height">
                    <i class="fas fa-folder fa-2x text-secondary"></i>
                  </div>
                <% end %>

                <!-- Padding interno p-2 para cards más esbeltas -->
                <div class="card-body p-2 text-center d-flex flex-column justify-content-between">
                  <h6 class="fw-bold text-dark mb-1 text-truncate style-cat-title"><%= cat.name %></h6>

                  <% if subcategories_count > 0 %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill small-badge">
                      <%= subcategories_count %> subcat. <i class="fas fa-chevron-right ms-1"></i>
                    </span>
                  <% else %>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill small-badge">
                      Final
                    </span>
                  <% end %>
                </div>
              </div>

            </div>
          <% end %>
        </div>
      </div>

      <!-- LISTADO DE PRODUCTOS DE LA CATEGORÍA SELECCIONADA -->
      <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
        <h5 class="fw-bold text-dark mb-3 border-bottom pb-2" id="category-products-title">
          <i class="fas fa-boxes text-secondary me-2"></i> Seleccione una categoría para ver sus productos
        </h5>

        <div class="row" id="explorer-products-container">
          <% @products.each do |product| %>
            <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-4 explorer-product-item" 
                 data-category-id="<%= product.category_id %>">
              <%= render "product_card", product: product %>
            </div>
          <% end %>
        </div>

        <div id="no-products-alert" class="text-center py-5 text-muted d-none">
          <i class="fas fa-box-open fa-3x mb-3 text-secondary"></i>
          <h5>No hay productos registrados en esta categoría.</h5>
        </div>
      </div>

    </div>
  </div>

</div>

<!-- CSS Estilos -->
<style>
/* Altura de imagen reducida para hacer la card más delgada */
.cat-img-height {
  height: 130px;
  object-fit: cover;
}

.cursor-pointer {
  cursor: pointer;
}

.hover-category-card {
  transition: all 0.25s ease-in-out;
}

.hover-category-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1) !important;
}

.selected-cat-card {
  border: 2px solid #0d6efd !important;
  background-color: #e7f1ff !important;
  transform: translateY(-2px) scale(1.01);
  box-shadow: 0 0.4rem 0.8rem rgba(13, 110, 253, 0.18) !important;
}

.selected-cat-card .card-body {
  background-color: #a3e3ff !important;
}

/* Tipografía y badgets más compactos */
.style-cat-title { 
  font-size: 0.85rem; 
}

.small-badge { 
  font-size: 0.7rem; 
  padding: 0.25em 0.5em; 
}

.product-card {
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.product-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 6px 18px rgba(0,0,0,0.12);
}

.badge-top-right, .badge-top-left {
  position: absolute;
  top: 10px;
  padding: 0.4rem 0.6rem;
  font-size: 0.8rem;
  z-index: 3;
  border-radius: 0.4rem;
}

.badge-top-right { right: 10px; }
.badge-top-left { left: 10px; }

.custom-carousel {
  position: relative;
  width: 100%;
  padding-top: 75%;
  background-color: #f8f9fa;
  overflow: hidden;
}

.carousel-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  background: #fff;
  opacity: 0;
  transition: opacity 0.4s ease-in-out;
}

.carousel-image.active { opacity: 1; }

.custom-carousel button {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(0,0,0,0.5);
  color: white;
  border: none;
  padding: 0.2rem 0.6rem;
  cursor: pointer;
  font-size: 1.2rem;
  border-radius: 50%;
  z-index: 2;
}

.prev { left: 8px; }
.next { right: 8px; }

.carousel-indicators {
  position: absolute;
  bottom: 8px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 5px;
  z-index: 2;
}

.carousel-indicators .dot {
  width: 8px;
  height: 8px;
  background: rgba(255,255,255,0.6);
  border-radius: 50%;
  cursor: pointer;
}

.carousel-indicators .dot.active { background: #0d6efd; }

.filter-input, .filter-select {
  border-radius: 0.5rem;
  border: 1px solid #ced4da;
  padding: 0.45rem 0.75rem;
  font-size: 0.9rem;
}
</style>

<!-- Lógica JavaScript -->
<script>
function setupProductExplorer() {
  const cardsGrid = document.getElementById("categories-cards-grid");
  const breadcrumb = document.getElementById("category-explorer-breadcrumb");
  const explorerProducts = document.querySelectorAll(".explorer-product-item");
  const noProductsAlert = document.getElementById("no-products-alert");
  const currentCategoryTitle = document.getElementById("current-category-title");
  const categoryProductsTitle = document.getElementById("category-products-title");

  if (!cardsGrid || !breadcrumb) return;

  // Estructura de navegación
  let navigationHistory = [{ id: 'root', name: 'Categorías Principales', parentId: null, level: 0 }];
  let activeCategoryId = 'root';

  function renderExplorerLevel(parentId, selectedId = null) {
    const allCategoryCards = cardsGrid.querySelectorAll(".category-card-item");

    allCategoryCards.forEach(wrapper => {
      const card = wrapper.querySelector(".card");
      const cardBody = wrapper.querySelector(".card-body");
      
      card.classList.remove("selected-cat-card");
      if (cardBody) cardBody.classList.remove("bg-white");

      if (wrapper.dataset.parentId === parentId) {
        wrapper.classList.remove("d-none");
        if (selectedId && wrapper.dataset.id === selectedId) {
          card.classList.add("selected-cat-card");
        } else {
          if (cardBody) cardBody.classList.add("bg-white");
        }
      } else {
        wrapper.classList.add("d-none");
      }
    });

    const currentLevel = navigationHistory[navigationHistory.length - 1];
    if (currentCategoryTitle) {
      currentCategoryTitle.innerHTML = `<i class="fas fa-folder-open text-primary me-2"></i> ${currentLevel.name}`;
    }

    activeCategoryId = selectedId || parentId;

    renderBreadcrumb();
    filterProductsByCategory();
  }

  function filterProductsByCategory() {
    let visibleCount = 0;

    explorerProducts.forEach(prod => {
      const pCatId = prod.dataset.categoryId;

      if (activeCategoryId !== 'root' && pCatId === activeCategoryId) {
        prod.classList.remove("d-none");
        visibleCount++;
      } else {
        prod.classList.add("d-none");
      }
    });

    if (!categoryProductsTitle || !noProductsAlert) return;

    if (activeCategoryId === 'root') {
      categoryProductsTitle.innerHTML = `<i class="fas fa-boxes text-secondary me-2"></i> Seleccione una categoría para ver sus productos`;
      noProductsAlert.classList.add("d-none");
    } else {
      const currentLevelName = navigationHistory[navigationHistory.length - 1].name;
      categoryProductsTitle.innerHTML = `<i class="fas fa-boxes text-success me-2"></i> Productos en "${currentLevelName}"`;

      if (visibleCount === 0) {
        noProductsAlert.classList.remove("d-none");
      } else {
        noProductsAlert.classList.add("d-none");
      }
    }
  }

  function renderBreadcrumb() {
    breadcrumb.innerHTML = "";
    navigationHistory.forEach((item, index) => {
      const isLast = index === navigationHistory.length - 1;
      const li = document.createElement("li");
      li.className = `breadcrumb-item ${isLast ? "active fw-bold text-primary" : ""}`;

      if (isLast) {
        li.textContent = item.name;
      } else {
        const a = document.createElement("a");
        a.href = "#";
        a.className = "text-decoration-none";
        a.textContent = item.name;
        a.addEventListener("click", function(e) {
          e.preventDefault();
          navigationHistory = navigationHistory.slice(0, index + 1);
          renderExplorerLevel(item.id);
        });
        li.appendChild(a);
      }
      breadcrumb.appendChild(li);
    });
  }

  // Clic en tarjetas de categoría
  cardsGrid.onclick = function(e) {
    const cardItem = e.target.closest(".category-card-item");
    if (!cardItem) return;

    const catId = cardItem.dataset.id;
    const catName = cardItem.dataset.name;
    const parentId = cardItem.dataset.parentId;
    const subcount = parseInt(cardItem.dataset.subcategoriesCount || "0");

    const currentLevelIndex = navigationHistory.findIndex(item => item.id === parentId);

    if (currentLevelIndex !== -1) {
      navigationHistory = navigationHistory.slice(0, currentLevelIndex + 1);
    }

    if (subcount > 0) {
      navigationHistory.push({ id: catId, name: catName, parentId: parentId, level: navigationHistory.length });
      renderExplorerLevel(catId);
    } else {
      navigationHistory.push({ id: catId, name: catName, parentId: parentId, level: navigationHistory.length });
      renderExplorerLevel(parentId, catId);
    }
  };

  renderExplorerLevel("root");
}

document.addEventListener("DOMContentLoaded", setupProductExplorer);
document.addEventListener("turbo:load", setupProductExplorer);
document.addEventListener("turbolinks:load", setupProductExplorer);

// Funciones del Carrusel de Imágenes
function showSlide(carousel, index) {
  const slides = carousel.querySelectorAll('.carousel-image');
  const dots = carousel.querySelectorAll('.dot');
  slides.forEach((s, i) => s.classList.toggle('active', i === index));
  dots.forEach((d, i) => d.classList.toggle('active', i === index));
  carousel.dataset.current = index;
}

function nextSlide(btn) {
  const carousel = btn.closest('.custom-carousel');
  let index = parseInt(carousel.dataset.current || 0);
  const slides = carousel.querySelectorAll('.carousel-image');
  showSlide(carousel, (index + 1) % slides.length);
}

function prevSlide(btn) {
  const carousel = btn.closest('.custom-carousel');
  let index = parseInt(carousel.dataset.current || 0);
  const slides = carousel.querySelectorAll('.carousel-image');
  showSlide(carousel, (index - 1 + slides.length) % slides.length);
}

function goToSlide(dot, index) {
  const carousel = dot.closest('.custom-carousel');
  showSlide(carousel, index);
}
</script>