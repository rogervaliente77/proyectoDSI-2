<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow mb-4 border-0">
        <div class="card-header bg-dark text-white py-3">
          <h5 class="mb-0"><i class="fas fa-calculator me-2"></i>Nuevo Ingreso / Descuento Manual</h5>
        </div>
        <div class="card-body p-4">
          <p class="text-muted">Asignando registro a: <strong class="text-primary"><%= @empleado.full_name %></strong></p>
          <hr>

          <%# CAMBIADO: Añadimos url: admin_empleado_movimientos_planilla_index_path(@empleado) %>
        <%= form_with model: [:admin, @empleado, @movimiento], url: admin_empleado_movimientos_planilla_index_path(@empleado), method: :post, local: true do |f| %>
            <% if @movimiento.errors.any? %>
              <div class="alert alert-danger">
                <h6 class="alert-heading">Por favor corrige los siguientes errores:</h6>
                <ul class="mb-0 font-monospace small">
                  <% @movimiento.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="mb-3">
              <%= f.label :tipo, "Tipo de Movimiento", class: "form-label fw-bold text-secondary" %>
              <%= f.select :tipo, [["Bono (+)", "Bono"], ["Viático (+)", "Viatico"], ["Comisión (+)", "Comision"], ["Otros Descuentos (-)", "Descuento"]], { include_blank: "Seleccione una opción..." }, { class: "form-select", required: true } %>
            </div>

            <div class="mb-3">
              <%= f.label :monto, "Monto Monetario ($)", class: "form-label fw-bold text-secondary" %>
              <%= f.number_field :monto, step: "0.01", min: "0.01", class: "form-control", placeholder: "0.00", required: true %>
            </div>

            <div class="mb-3">
              <%= f.label :fecha, "Fecha de Aplicación", class: "form-label fw-bold text-secondary" %>
              <%= f.date_field :fecha, class: "form-control", required: true %>
              <small class="text-muted">Determina en qué rango de corte de planilla se incluirá este dinero.</small>
            </div>

            <div class="mb-3">
              <%= f.label :descripcion, "Descripción / Justificación (Opcional)", class: "form-label fw-bold text-secondary" %>
              <%= f.text_area :descripcion, rows: 2, class: "form-control", placeholder: "Ej: Comisión por metas de mayo / Viáticos de viaje a San Miguel" %>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
              <div class="d-flex justify-content-end gap-2 mt-4">
                <%# CAMBIADO: Se agregó _index antes de _path %>
                <%= link_to "Cancelar", admin_empleado_movimientos_planilla_index_path(@empleado), class: "btn btn-light" %>
                <%= f.submit "Guardar Registro", class: "btn btn-success px-4" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>