<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0 text-gray-800">Control de Planillas</h1>
      <p class="text-muted">Gestión de cierres salariales, prestaciones y periodos especiales.</p>
    </div>
    <%= link_to new_admin_planilla_path(tipo: @tipo_actual), data: { turbo: false }, class: "btn btn-primary shadow-sm" do %>
      <i class="fas fa-plus-circle me-1"></i> Nueva Planilla de <%= @tipo_actual %>
    <% end %>
  </div>

  <ul class="nav nav-tabs mb-4" id="planillaTabs" role="tablist">
    <li class="nav-item">
      <%= link_to admin_planillas_path(tipo: 'Salarial Ordinaria'), 
                  data: { turbo: false }, 
                  class: "nav-link #{'active fw-bold text-primary' if @tipo_actual == 'Salarial Ordinaria'}" do %>
        <i class="fas fa-wallet me-1"></i> Planillas Salariales
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_planillas_path(tipo: 'Aguinaldo'), 
                  data: { turbo: false }, 
                  class: "nav-link #{'active fw-bold text-success' if @tipo_actual == 'Aguinaldo'}" do %>
        <i class="fas fa-gift me-1"></i> Planillas de Aguinaldo
      <% end %>
    </li>
    <li class="nav-item">
      <%= link_to admin_planillas_path(tipo: 'Quincena 25'), 
                  data: { turbo: false }, 
                  class: "nav-link #{'active fw-bold text-info' if @tipo_actual == 'Quincena 25'}" do %>
        <i class="fas fa-calendar-plus me-1"></i> Quincena 25 / Especiales
      <% end %>
    </li>
  </ul>

  <div class="card shadow mb-4 border-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-dark">
          <tr>
            <th>Nombre del Periodo</th>
            <th>Tipo Periodo</th>
            <th>Rango de Fechas</th>
            <th>Fecha Pago</th>
            <th class="text-center">Estado</th>
            <th class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if @planillas.any? %>
            <% @planillas.each do |planilla| %>
              <tr>
                <td class="fw-bold text-gray-800"><%= planilla.nombre %></td>
                <td>
                  <span class="badge bg-light text-dark border"><%= planilla.tipo_periodo %></span>
                </td>
                <td>
                  <i class="far fa-calendar-alt text-muted me-1"></i>
                  <%= planilla.fecha_desde.strftime("%d/%m/%Y") %> al <%= planilla.fecha_hasta.strftime("%d/%m/%Y") %>
                </td>
                <td><%= planilla.fecha_pago&.strftime("%d/%m/%Y") || '---' %></td>
                <td class="text-center">
                  <% if planilla.procesada %>
                    <span class="badge bg-success shadow-sm"><i class="fas fa-check-circle me-1"></i>Procesada</span>
                  <% else %>
                    <span class="badge bg-warning text-dark shadow-sm"><i class="fas fa-clock me-1"></i>Abierta</span>
                  <% end %>
                </td>
                <td class="text-center">
                  <div class="d-inline-flex gap-2">
                    <%= link_to admin_planilla_path(planilla), class: "btn btn-sm btn-outline-secondary shadow-sm" do %>
                      <i class="fas fa-eye me-1"></i> Ver Boletas
                    <% end %>

                    <%# NUEVO: BOTÓN ELIMINAR PLANILLA %>
                    <%= button_to admin_planilla_path(planilla), 
                                  method: :delete, 
                                  class: "btn btn-sm btn-outline-danger shadow-sm",
                                  form: { class: "d-inline" },
                                  data: { confirm: "¿Está seguro de eliminar esta planilla? Esto borrará permanentemente todas las boletas de pago asociadas a ella.", turbo_confirm: "¿Está seguro de eliminar esta planilla? Esto borrará permanentemente todas las boletas de pago asociadas a ella." } do %>
                      <i class="fas fa-trash-alt me-1"></i> Eliminar
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="6" class="text-center text-muted py-5">
                <i class="fas fa-folder-open fa-2x mb-3 text-gray-300"></i>
                <p class="mb-0">No se encontraron registros de planillas de tipo <strong><%= @tipo_actual %></strong>.</p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>