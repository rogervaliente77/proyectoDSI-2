<div class="container-fluid">

  <!-- Encabezado -->
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Gestión de Planillas</h1>
    <%= link_to new_admin_planilla_path, class: "btn btn-sm btn-primary shadow-sm" do %>
      <i class="fas fa-plus fa-sm text-white-50"></i> Generar Nueva Planilla
    <% end %>
  </div>

  <!-- Tabla de Historial -->
  <div class="card shadow mb-4">
    <div class="card-header py-3">
      <h6 class="m-0 font-weight-bold text-primary">Historial de Pagos y Periodos</h6>
    </div>
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-bordered" width="100%" cellspacing="0">
          <thead class="bg-light">
            <tr>
              <th>Nombre de Planilla</th>
              <th>Periodo (Desde - Hasta)</th>
              <th>Tipo</th>
              <th>Fecha de Pago</th>
              <th>Boletas</th>
              <th class="text-center">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if @planillas.any? %>
              <% @planillas.each do |planilla| %>
                <tr>
                  <td class="font-weight-bold text-dark"><%= planilla.nombre %></td>
                  <td>
                    <small>
                      <%= planilla.fecha_desde.strftime("%d/%m/%Y") %> - 
                      <%= planilla.fecha_hasta.strftime("%d/%m/%Y") %>
                    </small>
                  </td>
                  <td>
                    <span class="badge badge-info"><%= planilla.tipo_periodo %></span>
                  </td>
                  <td><%= planilla.fecha_pago&.strftime("%d/%m/%Y") %></td>
                  <td>
                    <i class="fas fa-file-invoice-dollar mr-1"></i>
                    <%= planilla.boletas_de_pago.count %> empleados
                  </td>
                  <td class="text-center">
                    <%= link_to admin_planilla_path(planilla), class: "btn btn-info btn-circle btn-sm", title: "Ver Detalle y Boletas" do %>
                      <i class="fas fa-eye"></i>
                    <% end %>
                    
                    <button class="btn btn-secondary btn-circle btn-sm" title="Descargar Reporte General">
                      <i class="fas fa-download"></i>
                    </button>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="text-center py-4">
                  <div class="text-muted">No hay planillas generadas aún.</div>
                  <%= link_to "Generar la primera ahora", new_admin_planilla_path, class: "btn btn-link" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Resumen de Ayuda -->
  <div class="alert alert-secondary shadow-sm">
    <i class="fas fa-info-circle mr-2"></i>
    <strong>Recordatorio:</strong> Las planillas se basan en el <strong>Porcentaje de Asistencia</strong> calculado durante el corte. Asegúrate de haber procesado el corte en el módulo de Asistencias antes de generar una nueva planilla.
  </div>

</div>