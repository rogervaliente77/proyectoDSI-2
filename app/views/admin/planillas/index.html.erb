<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 text-gray-800">Historial de Planillas</h1>
    <%= link_to new_admin_planilla_path, class: "btn btn-sm btn-primary shadow-sm" do %>
      <i class="fas fa-plus me-1"></i> Generar Planilla
    <% end %>
  </div>

  <div class="card shadow mb-4">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Nombre de Planilla</th>
              <th>Periodo</th>
              <th>Rango de Fechas</th>
              <th>Fecha de Pago</th>
              <th>Estado</th>
              <th class="text-center">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if @planillas.any? %>
              <% @planillas.each do |p| %>
                <tr>
                  <td class="fw-bold text-primary"><%= p.nombre %></td>
                  <td><span class="badge bg-secondary"><%= p.tipo_periodo %></span></td>
                  <td><%= p.fecha_desde.strftime("%d/%m/%Y") %> al <%= p.fecha_hasta.strftime("%d/%m/%Y") %></td>
                  <td><%= p.fecha_pago&.strftime("%d/%m/%Y") %></td>
                  <td>
                    <span class="badge bg-success"><i class="fas fa-lock me-1"></i> Procesada</span>
                  </td>
                  <td class="text-center">
                    <%= link_to admin_planilla_path(p), class: "btn btn-sm btn-info text-white" do %>
                      <i class="fas fa-eye me-1"></i> Ver Boletas
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="text-center py-4 text-muted">No se han procesado planillas aún.</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>