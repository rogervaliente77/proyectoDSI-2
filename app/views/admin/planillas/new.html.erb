<div class="container-fluid">
  <div class="mb-4">
    <h1 class="h3 mb-0 text-gray-800">Generar Nueva Planilla</h1>
    <p class="text-muted">El sistema procesará las asistencias e incapacidades dentro del rango asignado.</p>
  </div>

  <% if flash[:alert] %>
    <div class="alert alert-danger"><%= flash[:alert] %></div>
  <% end %>

  <div class="card shadow mb-4" style="max-width: 600px;">
    <div class="card-body">
      <%= form_with model: [:admin, @planilla], local: true do |f| %>
        
        <div class="mb-3">
          <%= f.label :tipo_periodo, "Tipo de Periodo", class: "form-label fw-bold" %>
          <%= f.select :tipo_periodo, ['Semanal', 'Quincenal', 'Mensual'], {}, class: "form-select" %>
        </div>

        <div class="row">
          <div class="col-6 mb-3">
            <%= f.label :fecha_desde, "Fecha Inicial (Corte)", class: "form-label fw-bold" %>
            <%= f.date_field :fecha_desde, class: "form-control" %>
          </div>
          <div class="col-6 mb-3">
            <%= f.label :fecha_hasta, "Fecha Final (Corte)", class: "form-label fw-bold" %>
            <%= f.date_field :fecha_hasta, class: "form-control" %>
          </div>
        </div>

        <div class="mb-4">
          <%= f.label :fecha_pago, "Fecha de Pago Estimada", class: "form-label fw-bold" %>
          <%= f.date_field :fecha_pago, value: Date.today, class: "form-control" %>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <%= link_to "Cancelar", admin_planillas_path, class: "btn btn-secondary btn-sm" %>
          <%= f.submit "Procesar y Calcular Planilla", class: "btn btn-primary btn-sm", data: { turbo_confirm: "¿Estás seguro? Esto bloqueará las asistencias del rango." } %>
        </div>
      <% end %>
    </div>
  </div>
</div>