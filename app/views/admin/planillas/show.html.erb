<div class="container-fluid">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
    <div>
      <h1 class="h3 mb-0 text-gray-800">Detalle de Planilla Procesada</h1>
      <p class="text-muted mb-0">
        Periodo: <span class="fw-bold text-primary"><%= @planilla.nombre %></span> | 
        <% if @planilla.tipo_planilla == 'Aguinaldo' %>
          Año Fiscal: <span class="fw-bold text-success"><%= @planilla.fecha_hasta&.year || Time.current.year %></span>
        <% else %>
          Rango: <span class="fw-bold"><%= @planilla.fecha_desde.strftime("%d/%m/%Y") %> al <%= @planilla.fecha_hasta.strftime("%d/%m/%Y") %></span>
        <% end %>
      </p>
    </div>
    <div class="d-flex gap-2">
      <button onclick="generarBoletasPDF()" class="btn btn-sm btn-danger shadow-sm fw-bold">
        <i class="fas fa-file-pdf me-1"></i> Exportar Boletas de Pago (PDF)
      </button>

      <%= link_to admin_planillas_path, class: "btn btn-sm btn-secondary" do %>
        <i class="fas fa-arrow-left me-1"></i> Regresar al Historial
      <% end %>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-primary shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Neto a Pagar</div>
              <div class="h5 mb-0 font-weight-bold text-gray-800">$<%= number_with_precision(@boletas.sum(:total_neto), precision: 2) %></div>
            </div>
            <div class="col-auto">
              <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-danger shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Total Descuentos por Asistencia</div>
              <div class="h5 mb-0 font-weight-bold text-gray-800">$<%= number_with_precision(@boletas.sum(:descuento_faltas) + @boletas.sum(:descuento_retrasos), precision: 2) %></div>
            </div>
            <div class="col-auto">
              <i class="fas fa-user-clock fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-warning shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Retenciones Ley (ISSS/AFP/Renta)</div>
              <div class="h5 mb-0 font-weight-bold text-gray-800">
                $<%= number_with_precision(@boletas.sum(:isss_retencion) + @boletas.sum(:afp_retencion) + @boletas.sum(:renta_retencion), precision: 2) %>
              </div>
            </div>
            <div class="col-auto">
              <i class="fas fa-university fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-success shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Colaboradores Evaluados</div>
              <div class="h5 mb-0 font-weight-bold text-gray-800"><%= @boletas.count %> Empleados</div>
            </div>
            <div class="col-auto">
              <i class="fas fa-users fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow mb-4">
    <div class="card-header py-3 bg-dark text-white d-flex justify-content-between align-items-center">
      <h6 class="m-0 font-weight-bold">Desglose de Boletas de Pago</h6>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        
        <div class="table-responsive">
          <table class="table table-hover table-striped align-middle mb-0" style="font-size: 0.85rem;">
            <thead class="table-dark"> <%# Cambiado a table-dark para mejorar contraste visual con tantas columnas %>
              <tr>
                <th>Empleado</th>
                <% # 2. text-nowrap evita que el título se rompa hacia abajo %>
                <th class="text-nowrap">Fecha Ingreso</th>
                <th class="text-end">Sueldo Base</th>
                <th class="text-end">Sueldo Periodo</th>
                <th class="text-end text-success">Horas Extra</th>
                <th class="text-end text-success">Bonos</th>
                <th class="text-end text-success">Comisiones</th>
                <th class="text-end text-success">Viáticos / Otros</th>
                <th class="text-end text-danger">Desc. Faltas</th>
                <th class="text-end text-danger">Desc. Tardías</th>
                <th class="text-end text-danger">Otros Desc.</th>
                <th class="text-end">ISSS</th>
                <th class="text-end">AFP</th>
                <th class="text-end">Renta</th>
                <th class="text-end text-success fw-bold">Neto a Recibir</th>
              </tr>
            </thead>
            <tbody>
              <% @boletas.each do |boleta| %>
                <% 
                  movimientos = boleta.empleado.movimientos_planilla.where(planilla_id: boleta.planilla_id)
                  
                  bonos_m = movimientos.where(tipo: 'Bono').sum(:monto) || 0.0
                  comisiones_m = movimientos.where(tipo: 'Comision').sum(:monto) || 0.0
                  viaticos_m = movimientos.where(tipo: 'Viatico').sum(:monto) || 0.0
                  descuentos_m = movimientos.where(tipo: 'Descuento').sum(:monto) || 0.0

                  otros_ingresos_directos = [boleta.otros_ingresos - viaticos_m, 0.0].max
                  viaticos_totales_mostrar = viaticos_m + otros_ingresos_directos

                  horas_extra_puras = [boleta.monto_horas_extra - bonos_m - comisiones_m, 0.0].max
                  faltas_puras = [boleta.descuento_faltas - descuentos_m, 0.0].max
                %>
                <tr>
                  <td>
                    <div class="fw-bold text-gray-800 text-nowrap"><%= boleta.empleado&.full_name %></div>
                    <small class="text-muted"><%= boleta.empleado&.cargo_name || "Sin Cargo" %></small>
                  </td>
                  
                  <% # 3. Formateo DD/MM/AAAA y blindaje contra deformaciones %>
                  <td class="text-nowrap text-secondary">
                    <i class="far fa-calendar-alt text-muted me-1"></i>
                    <%= boleta.empleado&.fecha_inicio_trabajo&.strftime("%d/%m/%Y") || '—' %>
                  </td>
                  
                  <td class="text-end text-secondary">$<%= number_with_precision(boleta.empleado.salario_mensual, precision: 2) %></td>
                  <td class="text-end text-secondary fw-bold">$<%= number_with_precision(boleta.sueldo_base_momento, precision: 2) %></td>
                  
                  <td class="text-end text-success"><%= horas_extra_puras > 0 ? "$#{number_with_precision(horas_extra_puras, precision: 2)}" : "—" %></td>
                  <td class="text-end text-success"><%= bonos_m > 0 ? "$#{number_with_precision(bonos_m, precision: 2)}" : "—" %></td>
                  <td class="text-end text-success"><%= comisiones_m > 0 ? "$#{number_with_precision(comisiones_m, precision: 2)}" : "—" %></td>
                  
                  <td class="text-end text-success fw-bold"><%= viaticos_totales_mostrar > 0 ? "$#{number_with_precision(viaticos_totales_mostrar, precision: 2)}" : "—" %></td>

                  <td class="text-end text-danger fw-bold">
                    <% if faltas_puras > 0 %>
                      $<%= number_with_precision(faltas_puras, precision: 2) %>
                    <% else %>
                      <span class="text-muted" style="font-size: 0.75rem;">$0.00</span>
                    <% end %>
                  </td>

                  <td class="text-end text-danger fw-bold">
                    <% if boleta.descuento_retrasos > 0 %>
                      $<%= number_with_precision(boleta.descuento_retrasos, precision: 2) %>
                    <% else %>
                      <span class="text-muted" style="font-size: 0.75rem;">$0.00</span>
                    <% end %>
                  </td>

                  <td class="text-end text-danger fw-bold">
                    <% if descuentos_m > 0 %>
                      $<%= number_with_precision(descuentos_m, precision: 2) %>
                    <% else %>
                      <span class="text-muted" style="font-size: 0.75rem;">—</span>
                    <% end %>
                  </td>
                  
                  <td class="text-end text-muted">$<%= number_with_precision(boleta.isss_retencion, precision: 2) %></td>
                  <td class="text-end text-muted">$<%= number_with_precision(boleta.afp_retencion, precision: 2) %></td>
                  <td class="text-end text-muted">$<%= number_with_precision(boleta.renta_retencion, precision: 2) %></td>
                  
                  <td class="text-end text-success fw-bold fs-6 bg-light">
                    $<%= number_with_precision(boleta.total_neto, precision: 2) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

      </div>
    </div>
  </div>
</div>

<div id="contenedor-boletas-pdf" style="display: none;">
  <% @boletas.each_with_index do |boleta, index| %>
    <% 
      movimientos = boleta.empleado.movimientos_planilla.where(planilla_id: boleta.planilla_id)
      bonos_m = movimientos.where(tipo: 'Bono').sum(:monto) || 0.0
      comisiones_m = movimientos.where(tipo: 'Comision').sum(:monto) || 0.0
      viaticos_m = movimientos.where(tipo: 'Viatico').sum(:monto) || 0.0
      descuentos_m = movimientos.where(tipo: 'Descuento').sum(:monto) || 0.0

      otros_ingresos_directos = [boleta.otros_ingresos - viaticos_m, 0.0].max
      viaticos_totales_mostrar = viaticos_m + otros_ingresos_directos

      horas_extra_puras = [boleta.monto_horas_extra - bonos_m - comisiones_m, 0.0].max
      faltas_puras = [boleta.descuento_faltas - descuentos_m, 0.0].max
      
      total_ingresos_v = boleta.sueldo_base_momento + horas_extra_puras + bonos_m + comisiones_m + viaticos_totales_mostrar
      total_descuentos_v = faltas_puras + boleta.descuento_retrasos + descuentos_m + boleta.isss_retencion + boleta.afp_retencion + boleta.renta_retencion
    %>
    
    <div class="boleta-recibo" style="padding: 30px; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #333; <%= 'page-break-after: always;' if index < (@boletas.size - 1) %>">
      
      <div style="border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 20px;">
        <table style="width: 100%;">
          <tr>
            <td>
              <h2 style="margin: 0; font-size: 1.4rem; font-weight: bold; text-transform: uppercase;">COMPROBANTE DE PAGO DE SALARIO</h2>
              <p style="margin: 3px 0 0 0; font-size: 0.85rem; color: #555;">Planilla: <strong><%= @planilla.nombre %></strong></p>
            </td>
            <td style="text-align: right; vertical-align: bottom;">
              <p style="margin: 0; font-size: 0.85rem;">Fecha de Pago: <strong><%= @planilla.fecha_pago&.strftime("%d/%m/%Y") || Date.today.strftime("%d/%m/%Y") %></strong></p>
              <p style="margin: 2px 0 0 0; font-size: 0.85rem; color: #666;">Periodo: <%= @planilla.fecha_desde.strftime("%d/%m/%Y") %> al <%= @planilla.fecha_hasta.strftime("%d/%m/%Y") %></p>
            </td>
          </tr>
        </table>
      </div>

      <table style="width: 100%; background: #f9f9f9; padding: 12px; border-radius: 5px; margin-bottom: 25px; font-size: 0.9rem; border: 1px solid #e3e3e3;">
        <tr>
          <td style="width: 50%;">Colaborador: <strong><%= boleta.empleado&.full_name %></strong></td>
          <td style="width: 50%;">Cargo: <strong><%= boleta.empleado&.cargo_name || "Planta" %></strong></td>
        </tr>
        <tr>
          <td>Sueldo Base Mensual: <strong>$<%= number_with_precision(boleta.empleado.salario_mensual, precision: 2) %></strong></td>
          <td>Días Liquidados en Periodo: <strong><%= boleta.dias_trabajados %></strong></td>
        </tr>
      </table>

      <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem; margin-bottom: 30px;">
        <thead>
          <tr style="background: #f1f1f1; border-top: 1px solid #ccc; border-bottom: 1px solid #ccc;">
            <th style="text-align: left; padding: 8px; width: 35%;">CONCEPTO DE INGRESOS</th>
            <th style="text-align: right; padding: 8px; width: 15%; border-right: 1px solid #ddd;">MONTO</th>
            <th style="text-align: left; padding: 8px; width: 35%;">CONCEPTO DE DEDUCCIONES</th>
            <th style="text-align: right; padding: 8px; width: 15%;">MONTO</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom: 1px dashed #eee;">
            <td style="padding: 8px;">Sueldo Base del Periodo</td>
            <td style="text-align: right; padding: 8px; border-right: 1px solid #ddd;">$<%= number_with_precision(boleta.sueldo_base_momento, precision: 2) %></td>
            <td style="padding: 8px;">Retención ISSS</td>
            <td style="text-align: right; padding: 8px; color: #a94442;">$<%= number_with_precision(boleta.isss_retencion, precision: 2) %></td>
          </tr>
          <tr style="border-bottom: 1px dashed #eee;">
            <td style="padding: 8px;">Horas Extra Ordinarias / Nocturnas</td>
            <td style="text-align: right; padding: 8px; border-right: 1px solid #ddd;"><%= horas_extra_puras > 0 ? "$#{number_with_precision(horas_extra_puras, precision: 2)}" : "—" %></td>
            <td style="padding: 8px;">Retención AFP</td>
            <td style="text-align: right; padding: 8px; color: #a94442;">$<%= number_with_precision(boleta.afp_retencion, precision: 2) %></td>
          </tr>
          <tr style="border-bottom: 1px dashed #eee;">
            <td style="padding: 8px;">Bonificaciones Especiales</td>
            <td style="text-align: right; padding: 8px; border-right: 1px solid #ddd;"><%= bonos_m > 0 ? "$#{number_with_precision(bonos_m, precision: 2)}" : "—" %></td>
            <td style="padding: 8px;">Retención Impuesto sobre la Renta</td>
            <td style="text-align: right; padding: 8px; color: #a94442;">$<%= number_with_precision(boleta.renta_retencion, precision: 2) %></td>
          </tr>
          <tr style="border-bottom: 1px dashed #eee;">
            <td style="padding: 8px;">Comisiones por Venta / Metas</td>
            <td style="text-align: right; padding: 8px; border-right: 1px solid #ddd;"><%= comisiones_m > 0 ? "$#{number_with_precision(comisiones_m, precision: 2)}" : "—" %></td>
            <td style="padding: 8px;">Descuentos por Inasistencia / Faltas</td>
            <td style="text-align: right; padding: 8px; color: #a94442;"><%= faltas_puras > 0 ? "$#{number_with_precision(faltas_puras, precision: 2)}" : "—" %></td>
          </tr>
          <tr style="border-bottom: 1px dashed #eee;">
            <td style="padding: 8px;">Viáticos y Otros Ingresos Exentos</td>
            <td style="text-align: right; padding: 8px; border-right: 1px solid #ddd;"><%= viaticos_totales_mostrar > 0 ? "$#{number_with_precision(viaticos_totales_mostrar, precision: 2)}" : "—" %></td>
            <td style="padding: 8px;">Descuentos por Tardías / Minutos</td>
            <td style="text-align: right; padding: 8px; color: #a94442;"><%= boleta.descuento_retrasos > 0 ? "$#{number_with_precision(boleta.descuento_retrasos, precision: 2)}" : "—" %></td>
          </tr>
          <tr style="border-bottom: 1px solid #ccc;">
            <td style="padding: 8px; border-right: 1px solid #ddd;" colspan="2"></td>
            <td style="padding: 8px;">Otros Descuentos Manuales</td>
            <td style="text-align: right; padding: 8px; color: #a94442;"><%= descuentos_m > 0 ? "$#{number_with_precision(descuentos_m, precision: 2)}" : "—" %></td>
          </tr>
          <tr style="background: #fafafa; font-weight: bold;">
            <td style="padding: 10px; border-right: 1px solid #ddd;">Total Ingresos Brutos</td>
            <td style="text-align: right; padding: 10px; color: #3c763d; border-right: 1px solid #ddd;">$<%= number_with_precision(total_ingresos_v, precision: 2) %></td>
            <td style="padding: 10px;">Total Deducciones</td>
            <td style="text-align: right; padding: 10px; color: #a94442;">$<%= number_with_precision(total_descuentos_v, precision: 2) %></td>
          </tr>
        </tbody>
      </table>

      <table style="width: 100%; margin-top: 15px;">
        <tr>
          <td style="width: 45%; vertical-align: top;">
            <div style="background: #dff0d8; border: 1px solid #d6e9c6; padding: 15px; border-radius: 4px; text-align: center;">
              <span style="font-size: 0.8rem; text-transform: uppercase; color: #3c763d; display: block; margin-bottom: 2px;">NETO EFECTIVO A RECIBIR</span>
              <strong style="font-size: 1.5rem; color: #3c763d;">$<%= number_with_precision(boleta.total_neto, precision: 2) %></strong>
            </div>
          </td>
          <td style="width: 10%;"></td>
          <td style="width: 45%; text-align: center; vertical-align: bottom;">
            <div style="border-top: 1px solid #333; margin-top: 45px; padding-top: 5px; font-size: 0.8rem;">
              Firma del Colaborador<br>
              <span style="color: #777; font-size: 0.75rem;">Recibí conforme el pago de mis prestaciones</span>
            </div>
          </td>
        </tr>
      </table>

    </div>
  <% end %>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<script>
  function generarBoletasPDF() {
    const elemento = document.getElementById('contenedor-boletas-pdf');
    
    const clonElemento = elemento.cloneNode(true);
    clonElemento.style.display = 'block';

    const opciones = {
      margin:       15,
      filename:     'Boletas_Pago_' + '<%= @planilla.nombre.gsub(/[^0-9A-Za-z]/, "_") %>' + '.pdf',
      image:        { type: 'jpeg', quality: 0.98 },
      html2canvas:  { scale: 2, useCORS: true, logging: false },
      jsPDF:        { unit: 'mm', format: 'letter', orientation: 'portrait' }
    };

    html2pdf()
      .set(opciones)
      .from(clonElemento)
      .save()
      .then(() => {
         console.log("PDF exportado con éxito.");
      });
  }
</script>