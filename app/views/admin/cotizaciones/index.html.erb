<!-- Cargar librería html2pdf desde CDN (Sin dependencias en el servidor) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<div class="container-fluid mt-4 mb-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold text-primary mb-0">
        <i class="fas fa-file-invoice-dollar me-2"></i>Cotizaciones de Mantenimiento
      </h2>
      <p class="text-muted small mb-0">Gestión de cotizaciones y licitaciones vehiculares</p>
    </div>
    <%= link_to new_admin_cotizacione_path, class: "btn btn-success fw-bold shadow-sm" do %>
      <i class="fas fa-plus me-1"></i> Nueva Cotización
    <% end %>
  </div>

  <!-- TABLA PRINCIPAL DE COTIZACIONES -->
  <div class="card shadow border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-dark">
            <tr>
              <th class="ps-3">N° Cotización</th>
              <th>Cliente / Institución</th>
              <th>Año Licitación</th>
              <th class="text-center">Vehículos</th>
              <th>Plazo Entrega</th>
              <th class="text-end pe-3">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% if @cotizaciones.present? %>
              <% @cotizaciones.each do |cotizacion| %>
                <tr>
                  <td class="ps-3 fw-bold text-primary">
                    <%= cotizacion.numero_cotizacion.presence || cotizacion.id %>
                  </td>
                  <td>
                    <span class="fw-bold"><%= cotizacion.cliente_nombre %></span>
                  </td>
                  <td>
                    <span class="badge bg-secondary"><%= cotizacion.anio_licitacion %></span>
                  </td>
                  <td class="text-center">
                    <span class="badge bg-info text-dark">
                      <i class="fas fa-car me-1"></i><%= cotizacion.vehiculos.size rescue 0 %>
                    </span>
                  </td>
                  <td>
                    <small class="text-muted"><%= cotizacion.plazo_entrega.presence || "No especificado" %></small>
                  </td>
                  <td class="text-end pe-3">
                    <div class="btn-group btn-group-sm" role="group">
                      
                      <!-- BOTÓN GENERAR Y DESCARGAR PDF POR JS -->
                      <button id="btn-pdf-<%= cotizacion.id %>" 
                              class="btn btn-outline-danger" 
                              onclick="generarPDF('<%= cotizacion.id %>')" 
                              title="Descargar PDF">
                        <i class="fas fa-file-pdf"></i> PDF
                      </button>

                      <%= link_to admin_cotizacione_path(cotizacion), class: "btn btn-outline-primary", title: "Ver Detalle" do %>
                        <i class="fas fa-eye"></i>
                      <% end %>

                      <%= link_to edit_admin_cotizacione_path(cotizacion), class: "btn btn-outline-warning", title: "Editar" do %>
                        <i class="fas fa-edit"></i>
                      <% end %>

                      <%= link_to admin_cotizacione_path(cotizacion), 
                                  data: { turbo_method: :delete, turbo_confirm: "¿Está seguro de eliminar esta cotización?" }, 
                                  class: "btn btn-outline-danger", 
                                  title: "Eliminar" do %>
                        <i class="fas fa-trash-alt"></i>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% else %>
              <tr>
                <td colspan="6" class="text-center py-4 text-muted">
                  <i class="fas fa-folder-open fa-2x mb-2 d-block"></i>
                  No se encontraron cotizaciones registradas.
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- CONTENEDOR OCULTO PARA CONSTRUIR EL DOCUMENTO DEL PDF -->
<div style="display: none;">
  <div id="plantilla-pdf" style="padding: 20px; font-family: Arial, sans-serif; color: #333; font-size: 11px; background: #ffffff;">
    <!-- El script de JavaScript llenará este contenido dinámicamente -->
  </div>
</div>

<!-- SCRIPT DE JAVASCRIPT PARA GENERAR EL PDF -->
<script>
  async function generarPDF(cotizacionId) {
    const btn = document.getElementById(`btn-pdf-${cotizacionId}`);
    const originalText = btn.innerHTML;
    
    try {
      // 1. Cambiar estado visual del botón
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Generando...';

      // 2. Consultar el endpoint JSON de Rails
      // Reemplaza estas líneas en tu función generarPDF:
      const response = await fetch(`/admin/cotizaciones/${cotizacionId}/datos_pdf`);
      if (!response.ok) {
        throw new Error(`Servidor devolvió código ${response.status} (${response.statusText})`);
      }
      
      const data = await response.json();

      // 3. Renderizar la plantilla HTML en el contenedor invisible
      const contenedor = document.getElementById('plantilla-pdf');
      contenedor.innerHTML = construirHTMLCotizacion(data);

      // 4. Configurar opciones del PDF
      const opciones = {
        margin:       [10, 10, 10, 10], // Margenes (arriba, izquierda, abajo, derecha en mm)
        filename:     `Cotizacion_${data.numero_cotizacion || data._id}.pdf`,
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, logging: false },
        jsPDF:        { unit: 'mm', format: 'letter', orientation: 'portrait' }
      };

      // 5. Convertir a PDF y descargar en el navegador del usuario
      await html2pdf().set(opciones).from(contenedor).save();

    } catch (error) {
      alert("Error al generar el PDF: " + error.message);
      console.error("Error PDF JS:", error);
    } finally {
      // Restaurar el botón a su estado original
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  }

  // Función para maquetar el HTML estético de la oferta de mantenimiento
  function construirHTMLCotizacion(c) {
    let html = `
      <!-- ENCABEZADO DE EMPRESA CON LOGO -->
      <div style="border-bottom: 2px solid #1a365d; padding-bottom: 12px; margin-bottom: 15px;">
        <table style="width: 100%; border-collapse: collapse;">
          <tr>
            <!-- COLUMNA IZQUIERDA: LOGO -->
            <td style="width: 35%; vertical-align: middle;">
              <img src="/logo_bimers.png" alt="BIMERS Motor Cars" style="max-width: 180px; height: auto;" />
            </td>
            
            <!-- COLUMNA DERECHA: INFORMACIÓN CORPORATIVA Y DETALLES DE LA COTIZACIÓN -->
            <td style="width: 65%; text-align: right; vertical-align: middle; line-height: 1.3;">
              <h1 style="margin: 0; color: #1a365d; font-size: 16px; font-weight: bold; text-transform: uppercase;">
                BIMERS S.A DE C.V
              </h1>
              <h2 style="margin: 2px 0 0 0; color: #2b6cb0; font-size: 11px; font-weight: bold;">
                TALLER AUTOMOTRIZ ESPECIALIZADO
              </h2>
              <p style="margin: 2px 0 6px 0; color: #4a5568; font-size: 8.5px; font-style: italic;">
                (Mecánica, electrónica, enderezado, pintura, venta de repuestos, accesorios y A/C)
              </p>
              
              <div style="margin-top: 6px; padding-top: 4px; border-top: 1px dashed #cbd5e0;">
                <span style="font-size: 12px; color: #1a365d; font-weight: bold; display: inline-block; margin-right: 12px;">
                  N° COTIZACIÓN: ${c.numero_cotizacion || 'N/A'}
                </span>
                <span style="font-size: 10px; color: #718096;">
                  Fecha: ${new Date().toLocaleDateString('es-SV')}
                </span>
              </div>
            </td>
          </tr>
        </table>
      </div>

      <!-- DATOS DEL CLIENTE Y LICITACIÓN -->
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px; font-size: 10px; background-color: #f7fafc; border: 1px solid #e2e8f0;">
        <tr>
          <td style="padding: 6px 10px; width: 60%;">
            <strong>Cliente:</strong> ${c.cliente_nombre || 'N/A'}
          </td>
          <td style="padding: 6px 10px; width: 40%; text-align: right;">
            <strong>Licitación Año:</strong> ${c.anio_licitacion || 'N/A'}
          </td>
        </tr>
      </table>

      <div style="background-color: #1a365d; color: #ffffff; padding: 5px 8px; font-weight: bold; font-size: 11px; margin-bottom: 8px;">
        I. CONDICIONES GENERALES
      </div>
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 10px;">
        <tr>
          <td style="padding: 5px; border: 1px solid #cbd5e0; width: 50%;"><strong>Plazo de Entrega:</strong> ${c.plazo_entrega || 'N/A'}</td>
          <td style="padding: 5px; border: 1px solid #cbd5e0; width: 50%;"><strong>Lugar de Entrega:</strong> ${c.lugar_entrega || 'N/A'}</td>
        </tr>
        <tr>
          <td style="padding: 5px; border: 1px solid #cbd5e0;"><strong>Pago Maint. Preventivo:</strong> ${c.condiciones_pago_preventivo || 'N/A'}</td>
          <td style="padding: 5px; border: 1px solid #cbd5e0;"><strong>Pago Maint. Correctivo:</strong> ${c.condiciones_pago_correctivo || 'N/A'}</td>
        </tr>
      </table>
    `;

    let granTotalServicios = 0;
    let granTotalRepuestos = 0;
    let granTotalAdicionales = 0;

    if (c.vehiculos && c.vehiculos.length > 0) {
      c.vehiculos.forEach((v, index) => {
        const pageBreak = index > 0 ? 'page-break-before: always;' : '';
        let subtotalServicios = 0;
        
        // Leemos directamente los precios globales asignados al vehículo
        const subtotalRepuestos = parseFloat(v.precio_repuestos || 0);
        const subtotalAdicionales = parseFloat(v.precio_consumibles || 0);

        html += `
          <div style="${pageBreak} margin-top: 15px;">
            <div style="background-color: #2b6cb0; color: #ffffff; padding: 6px; font-weight: bold; font-size: 10px; margin-bottom: 6px;">
              UNIDAD N° ${v.numero_correlativo || (index + 1)} — ${v.tipo || ''} ${v.marca || ''} ${v.modelo || ''} (${v.anio || ''}) | PLACA: ${v.placa || ''}
            </div>

            <!-- TABLA 1: SERVICIOS Y MANO DE OBRA -->
            <div style="font-weight: bold; font-size: 10px; color: #1a365d; margin-top: 5px; margin-bottom: 3px;">1. DETALLE DE SERVICIOS Y MANO DE OBRA</div>
            <table style="width: 100%; border-collapse: collapse; font-size: 9px; margin-bottom: 10px;">
              <thead>
                <tr style="background-color: #2d3748; color: #ffffff;">
                  <th style="padding: 4px; border: 1px solid #4a5568; text-align: center; width: 15%;">Mantenimiento</th>
                  <th style="padding: 4px; border: 1px solid #4a5568; text-align: left; width: 25%;">Sistema</th>
                  <th style="padding: 4px; border: 1px solid #4a5568; text-align: left; width: 45%;">Descripción del Servicio</th>
                  <th style="padding: 4px; border: 1px solid #4a5568; text-align: right; width: 15%;">Precio ($)</th>
                </tr>
              </thead>
              <tbody>
        `;

        if (v.cotizacion_servicios && v.cotizacion_servicios.length > 0) {
          v.cotizacion_servicios.forEach(s => {
            const p = parseFloat(s.precio || 0);
            subtotalServicios += p;
            html += `
              <tr>
                <td style="padding: 4px; border: 1px solid #cbd5e0; text-align: center; font-weight: bold;">${s.tipo_mantenimiento || '-'}</td>
                <td style="padding: 4px; border: 1px solid #cbd5e0; font-weight: bold; color: #2b6cb0;">${s.sistema || '-'}</td>
                <td style="padding: 4px; border: 1px solid #cbd5e0;">${s.servicio_descripcion || '-'}</td>
                <td style="padding: 4px; border: 1px solid #cbd5e0; text-align: right; font-weight: bold;">$${p.toFixed(2)}</td>
              </tr>
            `;
          });
        } else {
          html += `<tr><td colspan="4" style="padding: 4px; text-align: center; color: #718096;">Sin servicios registrados.</td></tr>`;
        }

        html += `
              <tr style="background-color: #edf2f7; font-weight: bold;">
                <td colspan="3" style="padding: 4px; border: 1px solid #cbd5e0; text-align: right;">SUBTOTAL SERVICIOS:</td>
                <td style="padding: 4px; border: 1px solid #cbd5e0; text-align: right; color: #2b6cb0;">$${subtotalServicios.toFixed(2)}</td>
              </tr>
            </tbody>
          </table>

          <!-- TABLA 2: REPUESTOS Y LUBRICANTES (SIN COLUMNA PRECIO POR FILA) -->
          <div style="font-weight: bold; font-size: 10px; color: #276749; margin-top: 8px; margin-bottom: 3px;">2. FICHA TÉCNICA DE REPUESTOS Y LUBRICANTES OFERTADOS</div>
          <table style="width: 100%; border-collapse: collapse; font-size: 8px; margin-bottom: 10px;">
            <thead>
              <tr style="background-color: #276749; color: #ffffff;">
                <th style="padding: 4px; border: 1px solid #2f855a; width: 12%;">Tipo</th>
                <th style="padding: 4px; border: 1px solid #2f855a; width: 25%;">Repuesto / Insumo</th>
                <th style="padding: 4px; border: 1px solid #2f855a; width: 12%;">Oferta</th>
                <th style="padding: 4px; border: 1px solid #2f855a; width: 15%;">Marca</th>
                <th style="padding: 4px; border: 1px solid #2f855a; width: 10%;">Origen</th>
                <th style="padding: 4px; border: 1px solid #2f855a; width: 26%;">Especificación / Uso</th>
              </tr>
            </thead>
            <tbody>
        `;

        if (v.repuestos && v.repuestos.length > 0) {
          v.repuestos.forEach(r => {
            html += `
              <tr>
                <td style="padding: 4px; border: 1px solid #cbd5e0; text-align: center; font-weight: bold;">${r.tipo_item || 'Repuesto'}</td>
                <td style="padding: 4px; border: 1px solid #cbd5e0; font-weight: bold;">${r.nombre || '-'}</td>
                <td style="padding: 4px; border: 1px solid #cbd5e0; text-align: center;">${r.tipo_origen || '-'}</td>
                <td style="padding: 4px; border: 1px solid #cbd5e0;">${r.marca || '-'}</td>
                <td style="padding: 4px; border: 1px solid #cbd5e0; text-align: center;">${r.pais_origen || '-'}</td>
                <td style="padding: 4px; border: 1px solid #cbd5e0;">
                  ${r.especificacion ? `<strong>Espec:</strong> ${r.especificacion}<br>` : ''}
                  ${r.comentario_uso ? `<span style="color: #4a5568;"><em>Uso:</em> ${r.comentario_uso}</span>` : ''}
                </td>
              </tr>
            `;
          });
        } else {
          html += `<tr><td colspan="6" style="padding: 4px; text-align: center; color: #718096;">Sin repuestos o lubricantes especificados.</td></tr>`;
        }

        // FILA FINAL CON TOTAL GLOBAL DE LA SECCIÓN
        html += `
              <tr style="background-color: #f0fff4; font-weight: bold; font-size: 9px;">
                <td colspan="5" style="padding: 5px; border: 1px solid #cbd5e0; text-align: right;">TOTAL REPUESTOS Y LUBRICANTES:</td>
                <td style="padding: 5px; border: 1px solid #cbd5e0; text-align: right; color: #276749;">$${subtotalRepuestos.toFixed(2)}</td>
              </tr>
            </tbody>
          </table>

          <!-- TABLA 3: ADICIONALES Y CONSUMIBLES -->
          <div style="font-weight: bold; font-size: 10px; color: #d69e2e; margin-top: 8px; margin-bottom: 3px;">3. TRABAJOS Y ELEMENTOS ADICIONALES</div>
          <table style="width: 100%; border-collapse: collapse; font-size: 8px; margin-bottom: 10px;">
            <thead>
              <tr style="background-color: #b7791f; color: #ffffff;">
                <th style="padding: 4px; border: 1px solid #975a16; text-align: left;">Descripción Insumos / Adicionales</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 6px; border: 1px solid #cbd5e0; color: #2d3748;">
                  ${v.consumibles_menores || 'No se registraron consumibles ni trabajos adicionales.'}
                </td>
              </tr>
              <tr style="background-color: #fffff0; font-weight: bold; font-size: 9px;">
                <td style="padding: 5px; border: 1px solid #cbd5e0; text-align: right; color: #b7791f;">
                  TOTAL ADICIONALES Y CONSUMIBLES: $${subtotalAdicionales.toFixed(2)}
                </td>
              </tr>
            </tbody>
          </table>

          <!-- RESUMEN POR VEHÍCULO -->
          <!-- RESUMEN POR VEHÍCULO -->
          <table style="width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 10px; background-color: #1a365d; color: #ffffff;">
            <tr>
              <td style="padding: 6px; font-weight: bold;">TOTAL UNIDAD N° ${v.numero_correlativo || (index + 1)} (${v.placa || 'S/P'}):</td>
              <td style="padding: 6px; text-align: right; font-weight: bold; font-size: 11px;">$${(subtotalServicios + subtotalRepuestos + subtotalAdicionales).toFixed(2)}</td>
            </tr>
          </table>
        </div>
        `;

        granTotalServicios += subtotalServicios;
        granTotalRepuestos += subtotalRepuestos;
        granTotalAdicionales += subtotalAdicionales;
      });

      const granTotalGeneral = granTotalServicios + granTotalRepuestos + granTotalAdicionales;

      html += `
        <div style="margin-top: 25px; page-break-inside: avoid;">
          <div style="background-color: #1a365d; color: #ffffff; padding: 6px; font-weight: bold; font-size: 11px; margin-bottom: 5px;">
            RESUMEN GENERAL DE LA OFERTA
          </div>
          <table style="width: 100%; border-collapse: collapse; font-size: 10px;">
            <tr>
              <td style="padding: 6px; border: 1px solid #cbd5e0; width: 70%;"><strong>TOTAL SERVICIOS Y MANO DE OBRA:</strong></td>
              <td style="padding: 6px; border: 1px solid #cbd5e0; text-align: right; font-weight: bold;">$${granTotalServicios.toFixed(2)}</td>
            </tr>
            <tr>
              <td style="padding: 6px; border: 1px solid #cbd5e0;"><strong>TOTAL REPUESTOS Y LUBRICANTES:</strong></td>
              <td style="padding: 6px; border: 1px solid #cbd5e0; text-align: right; font-weight: bold;">$${granTotalRepuestos.toFixed(2)}</td>
            </tr>
            <tr>
              <td style="padding: 6px; border: 1px solid #cbd5e0;"><strong>TOTAL ADICIONALES Y CONSUMIBLES:</strong></td>
              <td style="padding: 6px; border: 1px solid #cbd5e0; text-align: right; font-weight: bold;">$${granTotalAdicionales.toFixed(2)}</td>
            </tr>
            <tr style="background-color: #2b6cb0; color: #ffffff; font-size: 12px; font-weight: bold;">
              <td style="padding: 8px; border: 1px solid #2b6cb0;">TOTAL GENERAL OFERTA:</td>
              <td style="padding: 8px; border: 1px solid #2b6cb0; text-align: right;">$${granTotalGeneral.toFixed(2)}</td>
            </tr>
          </table>
        </div>
      `;
    }

    return html;
  }


</script>