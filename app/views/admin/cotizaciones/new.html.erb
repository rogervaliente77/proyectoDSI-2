<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-0 text-gray-800">Nueva Cotización de Licitación</h1>
      <%= link_to admin_cotizaciones_path, class: "btn btn-outline-secondary", data: { turbo: false } do %>
        <i class="fas fa-arrow-left me-1"></i> Volver
      <% end %>
      <p class="text-muted">Ingrese los precios globales por categoría de mantenimiento para cada vehículo.</p>
    </div>
  </div>

  <%= render 'form', cotizacion: @cotizacion %>
</div>