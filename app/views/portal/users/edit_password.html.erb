<div class="edit-password-container">
  <div class="edit-password-card">
    
    <!-- Encabezado de la Tarjeta -->
    <div class="edit-password-header">
      <div class="header-title">
        <i class="fa-solid fa-shield-halved"></i>
        <h2>Cambiar Contraseña</h2>
      </div>
      <%= link_to portal_home_path, data: { turbo: false }, class: "btn-back-home" do %>
        <i class="fa-solid fa-arrow-left"></i> Volver al inicio
      <% end %>
    </div>

    <!-- Cuerpo del Formulario -->
    <div class="edit-password-body">

      <!-- ALERTAS FLASH (NOTICE / ALERT) CON BOTÓN DE CIERRE -->
      <% flash.each do |key, message| %>
        <% alert_type = (key.to_s == 'notice' || key.to_s == 'success') ? 'success' : 'danger' %>
        <div class="custom-flash-alert flash-<%= alert_type %>" id="flash-alert-<%= key %>">
          <div class="flash-content">
            <i class="fa-solid <%= alert_type == 'success' ? 'fa-circle-check' : 'fa-triangle-exclamation' %>"></i>
            <span><%= message %></span>
          </div>
          <button type="button" class="btn-close-flash" onclick="closeFlashAlert(this)">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
      <% end %>

      <p class="edit-password-description">
        Ingresa tu nueva contraseña a continuación para actualizar la seguridad de tu cuenta.
      </p>

      <%= simple_form_for :user, url: portal_users_update_path(id: @user.id), method: :patch, html: { class: "password-form", data: { turbo: false } } do |form| %> 
        
        <div class="form-grid">
          <!-- Campo Nueva Contraseña -->
          <div class="form-group-custom">
            <label for="user_password">Nueva Contraseña</label>
            <div class="input-password-wrapper">
              <i class="fa-solid fa-lock input-icon-left"></i>
              <input type="password" name="user[password]" id="user_password" class="custom-input" placeholder="••••••••" required>
              <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('user_password', this)">
                <i class="fa-solid fa-eye"></i>
              </button>
            </div>
          </div>

          <!-- Campo Confirmar Contraseña -->
          <div class="form-group-custom">
            <label for="user_password_confirmation">Confirmar Contraseña</label>
            <div class="input-password-wrapper">
              <i class="fa-solid fa-shield-cat input-icon-left"></i>
              <input type="password" name="user[password_confirmation]" id="user_password_confirmation" class="custom-input" placeholder="••••••••" required>
              <button type="button" class="toggle-password-btn" onclick="togglePasswordVisibility('user_password_confirmation', this)">
                <i class="fa-solid fa-eye"></i>
              </button>
            </div>
          </div>
        </div>

        <div class="form-actions">
          <%= link_to "Cancelar", portal_home_path, data: { turbo: false }, class: "btn-cancel" %>
          <button type="submit" class="btn-submit-password">
            <i class="fa-solid fa-floppy-disk"></i> Guardar Cambios
          </button>
        </div>

      <% end %>
    </div>

  </div>
</div>

<!-- ========================================================================== -->
<!-- ESTILOS ESPECÍFICOS DE LA VISTA Y ALERTAS FLASH                             -->
<!-- ========================================================================== -->
<style>
  .edit-password-container {
    max-width: 800px;
    margin: 40px auto;
    padding: 0 20px;
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .edit-password-card {
    width: 100%;
    background: #ffffff;
    border-radius: 14px;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.1);
    border: 1px solid #e2e8f0;
    overflow: hidden;
  }

  .edit-password-header {
    background: #0f172a;
    color: #ffffff;
    padding: 20px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .header-title {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header-title i {
    font-size: 1.4rem;
    color: #38bdf8;
  }

  .header-title h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
  }

  .btn-back-home {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s ease;
  }

  .btn-back-home:hover {
    color: #38bdf8;
  }

  .edit-password-body {
    padding: 30px 28px;
  }

  /* ESTILOS DE LAS ALERTAS FLASH */
  .custom-flash-alert {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-size: 0.9rem;
    font-weight: 500;
    animation: fadeIn 0.3s ease-in-out;
  }

  .custom-flash-alert .flash-content {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .custom-flash-alert.flash-success {
    background-color: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #065f46;
  }

  .custom-flash-alert.flash-danger {
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .btn-close-flash {
    background: transparent;
    border: none;
    color: inherit;
    opacity: 0.6;
    font-size: 1rem;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 4px;
    transition: opacity 0.2s ease;
  }

  .btn-close-flash:hover {
    opacity: 1;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .edit-password-description {
    color: #64748b;
    font-size: 0.92rem;
    margin-bottom: 24px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 28px;
  }

  @media (max-width: 640px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }

  .form-group-custom label {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    color: #0f172a;
    margin-bottom: 8px;
  }

  .input-password-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-icon-left {
    position: absolute;
    left: 14px;
    color: #94a3b8;
    font-size: 1rem;
    pointer-events: none;
  }

  .custom-input {
    width: 100%;
    padding: 11px 42px 11px 40px;
    border: 1.5px solid #cbd5e1;
    border-radius: 8px;
    font-size: 0.95rem;
    color: #0f172a;
    background-color: #ffffff;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }

  .custom-input:focus {
    outline: none;
    border-color: #0284c7;
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
  }

  .toggle-password-btn {
    position: absolute;
    right: 10px;
    background: transparent;
    border: none;
    color: #64748b;
    padding: 6px 8px;
    cursor: pointer;
    font-size: 1rem;
    border-radius: 4px;
    transition: color 0.2s;
  }

  .toggle-password-btn:hover {
    color: #0f172a;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    border-top: 1px solid #f1f5f9;
    padding-top: 20px;
  }

  .btn-cancel {
    padding: 10px 20px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #475569;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-cancel:hover {
    background: #f8fafc;
    color: #0f172a;
  }

  .btn-submit-password {
    padding: 10px 24px;
    border-radius: 8px;
    border: none;
    background: #0284c7;
    color: #ffffff;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: background 0.2s;
  }

  .btn-submit-password:hover {
    background: #0369a1;
  }
</style>

<!-- ========================================================================== -->
<!-- SCRIPTS JAVASCRIPT                                                         -->
<!-- ========================================================================== -->
<script>
  // Ojo para mostrar / ocultar contraseña
  function togglePasswordVisibility(inputId, btnElement) {
    const input = document.getElementById(inputId);
    const icon = btnElement.querySelector('i');

    if (!input || !icon) return;

    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.remove('fa-eye');
      icon.classList.add('fa-eye-slash');
    } else {
      input.type = 'password';
      icon.classList.remove('fa-eye-slash');
      icon.classList.add('fa-eye');
    }
  }

  // Cerrar alerta flash
  function closeFlashAlert(buttonElement) {
    const alertBox = buttonElement.closest('.custom-flash-alert');
    if (alertBox) {
      alertBox.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
      alertBox.style.opacity = '0';
      alertBox.style.transform = 'translateY(-6px)';
      setTimeout(() => alertBox.remove(), 200);
    }
  }
</script>