<div class="my-purchases-container" style="max-width: 1000px; margin: 40px auto; padding: 0 20px;">
  <h2 style="color: #0f172a; font-weight: 900; margin-bottom: 25px; text-transform: uppercase;">
    <i class="fa-solid fa-bag-shopping" style="color: #0d6efd; margin-right: 10px;"></i> Mis Compras
  </h2>

  <% if @sales.present? && @sales.any? %>
    <% 
      latest_sale = @sales.first
      past_sales = @sales.to_a[1..-1] || []
    %>

    <!-- 1. COMPRA ACTUAL / RECIENTE -->
    <div class="latest-purchase-card" style="background: #ffffff; border: 2px solid #0d6efd; border-radius: 14px; padding: 25px; box-shadow: 0 10px 25px rgba(13, 110, 253, 0.1); margin-bottom: 40px; position: relative;">
      
      <!-- Overlay de Carga durante la Subida -->
      <div id="upload-spinner-overlay" style="display: none; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255, 255, 255, 0.92); border-radius: 12px; z-index: 10; flex-direction: column; justify-content: center; align-items: center; gap: 15px;">
        <i class="fa-solid fa-circle-notch fa-spin" style="font-size: 2.8rem; color: #d97706;"></i>
        <strong style="color: #0f172a; font-size: 1rem;">Subiendo comprobante, por favor espera...</strong>
        <p style="margin: 0; font-size: 0.85rem; color: #64748b;">Guardando en el servidor...</p>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 15px; margin-bottom: 20px; flex-wrap: wrap; gap: 10px;">
        <div>
          <span style="background: #dbeafe; color: #1e40af; font-size: 0.75rem; font-weight: 800; padding: 4px 10px; border-radius: 20px; text-transform: uppercase;">Compra más reciente</span>
          <h3 style="color: #0f172a; font-size: 1.4rem; font-weight: 800; margin: 8px 0 0 0;"><%= latest_sale.code %></h3>
        </div>
        <div style="text-align: right;">
          <span style="font-size: 0.85rem; color: #64748b; display: block;">Fecha: <%= latest_sale.sold_at.strftime("%d/%m/%Y %H:%M") %></span>
          <% 
            status_color = case latest_sale.status
                           when 'pending_payment_comprob' then '#d97706'
                           when 'pending_check_payment_comprob' then '#0284c7'
                           else '#059669'
                           end
          %>
          <span style="font-weight: 700; font-size: 0.88rem; color: <%= status_color %>;">
            Estado: <%= latest_sale.status.titleize %>
          </span>
        </div>
      </div>

      <!-- ALERTA SI ES TRANSFERENCIA Y FALTA COMPROBANTE -->
      <% if latest_sale.forma_pago == 'TRANSFERENCIA' && latest_sale.status == 'pending_payment_comprob' %>
        <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px; padding: 20px; margin-bottom: 20px;">
          <div style="display: flex; align-items: center; gap: 12px; color: #92400e; margin-bottom: 12px;">
            <i class="fa-solid fa-triangle-exclamation" style="font-size: 1.5rem;"></i>
            <div>
              <strong>Pago por Transferencia Pendiente de Comprobante</strong>
              <p style="margin: 2px 0 0 0; font-size: 0.85rem;">Por favor realiza la transferencia por el monto total y sube tu captura para continuar.</p>
            </div>
          </div>
          <div style="background: #ffffff; padding: 12px; border-radius: 6px; border: 1px solid #fef3c7; font-size: 0.88rem; color: #1e293b; margin-bottom: 15px;">
            <strong>Banco Agrícola - Cuenta Corriente:</strong> #123-456789-0<br>
            <strong>A nombre de:</strong> BIMERS MOTOR CARS
          </div>

          <!-- Formulario para subir el comprobante -->
          <%= form_with url: portal_purchase_upload_proof_path(latest_sale), method: :post, local: true, html: { id: "proof-upload-form", multipart: true, style: "display: flex; flex-direction: column; gap: 12px; width: 100%;" } do %>
            <input type="file" id="transfer-proof-input" name="transfer_proof" accept="image/png, image/jpeg, image/jpg, image/webp" required style="font-size: 0.85rem; background: #fff; padding: 8px; border: 1px solid #cbd5e1; border-radius: 6px; width: 100%; box-sizing: border-box;">

            <!-- PREVISUALIZACIÓN DE IMAGEN ANTES DE SUBIR -->
            <div id="image-preview-container" style="display: none; text-align: center; margin-top: 5px; background: #ffffff; padding: 12px; border-radius: 8px; border: 1px dashed #cbd5e1;">
              <span style="font-size: 0.8rem; color: #64748b; display: block; margin-bottom: 8px;">Vista previa de la imagen a subir:</span>
              <img id="image-preview" src="#" alt="Previsualización" style="max-height: 180px; max-width: 100%; border-radius: 6px; border: 1px solid #e2e8f0; object-fit: contain; margin-bottom: 8px;">
              
              <div>
                <button type="button" id="btn-view-selected-preview" style="background: #0284c7; color: #fff; border: none; padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                  <i class="fa-solid fa-magnifying-glass"></i> Ver en pantalla completa
                </button>
              </div>
            </div>

            <button type="submit" id="btn-submit-proof" style="background: #d97706; color: #fff; border: none; padding: 12px 16px; border-radius: 6px; font-weight: 700; font-size: 0.85rem; cursor: pointer; width: 100%; text-align: center; display: flex; justify-content: center; align-items: center; gap: 8px;">
              <i class="fa-solid fa-upload"></i> <span id="btn-text">Subir Comprobante</span>
            </button>
          <% end %>
        </div>

      <% elsif latest_sale.forma_pago == 'TRANSFERENCIA' && latest_sale.status == 'pending_check_payment_comprob' %>
        <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 15px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; color: #1e40af;">
          <div style="display: flex; align-items: center; gap: 12px;">
            <i class="fa-solid fa-circle-info" style="font-size: 1.3rem;"></i>
            <div>
              <strong>Comprobante en revisión</strong>
              <p style="margin: 2px 0 0 0; font-size: 0.85rem;">Hemos recibido tu captura. El taller está verificando la transferencia para aprobar tu pedido.</p>
            </div>
          </div>

          <!-- MUESTRA EL BOTÓN SI EXISTE EL CAMPO transfer_proof_path -->
          <% if latest_sale.respond_to?(:transfer_proof_path) && latest_sale.transfer_proof_path.present? %>
            <button type="button" onclick="openProofModal('<%= latest_sale.transfer_proof_path %>')" style="background: #1e40af; color: #ffffff; border: none; padding: 8px 14px; border-radius: 6px; font-size: 0.82rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; white-space: nowrap; box-shadow: 0 2px 4px rgba(30, 64, 175, 0.2);">
              <i class="fa-solid fa-file-image"></i> Ver Comprobante
            </button>
          <% end %>
        </div>
      <% end %>

      <!-- Detalle de productos de la compra actual -->
      <div style="margin-bottom: 15px;">
        <h4 style="font-size: 0.95rem; color: #334155; margin-bottom: 10px; font-weight: 700;">Productos en este pedido:</h4>
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;">
          <% latest_sale.product_sales.each do |ps| %>
            <li style="display: flex; justify-content: space-between; font-size: 0.9rem; color: #475569; background: #f8fafc; padding: 8px 12px; border-radius: 6px;">
              <span><strong><%= ps.quantity %>x</strong> <%= ps.product&.name || "Producto" %></span>
              <span style="font-weight: 700; color: #0f172a;">$<%= '%.2f' % (ps.subtotal || (ps.quantity * ps.unit_price)) %></span>
            </li>
          <% end %>
        </ul>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px dashed #e2e8f0; padding-top: 15px; margin-top: 15px; flex-wrap: wrap; gap: 10px;">
        <div style="display: flex; flex-direction: column; gap: 2px;">
          <span style="font-size: 0.85rem; color: #64748b;">
            Método de pago: <strong><%= latest_sale.forma_pago == 'TRANSFERENCIA' ? 'Transferencia Bancaria' : 'Efectivo (Contra Entrega)' %></strong>
            
            <!-- SI YA FUE APROBADA O PROCESADA Y ES TRANSFERENCIA, MUESTRA EL BOTÓN SI EXISTE ADJUNTO -->
            <% if latest_sale.forma_pago == 'TRANSFERENCIA' && latest_sale.status != 'pending_payment_comprob' && latest_sale.status != 'pending_check_payment_comprob' %>
              <% approved_proof_url = latest_sale.try(:transfer_proof_url) || latest_sale.try(:transfer_proof)&.url %>
              <% if approved_proof_url.present? %>
                <button type="button" onclick="openProofModal('<%= approved_proof_url %>')" style="background: #f1f5f9; color: #0f172a; border: 1px solid #cbd5e1; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 600; cursor: pointer; margin-left: 8px;">
                  <i class="fa-solid fa-eye"></i> Ver Comprobante
                </button>
              <% end %>
            <% end %>
          </span>
          <span style="font-size: 0.85rem; color: #64748b;">Entrega: <strong><%= latest_sale.delivery_method == 'delivery' ? 'Envío a Domicilio' : 'Recoger en Taller' %></strong></span>
        </div>
        <span style="font-size: 1.2rem; font-weight: 800; color: #0f172a;">Total: <span style="color: #0d6efd;">$<%= '%.2f' % latest_sale.total_amount %></span></span>
      </div>
    </div>

    <!-- 2. HISTORIAL DE COMPRAS ANTERIORES -->
    <% if past_sales.present? && past_sales.any? %>
      <h3 style="color: #334155; font-size: 1.1rem; font-weight: 700; margin-bottom: 15px;">Compras Anteriores</h3>
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <% past_sales.each do |sale| %>
          <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div>
              <strong style="color: #0f172a; font-size: 0.95rem;"><%= sale.code %></strong>
              <span style="font-size: 0.82rem; color: #64748b; margin-left: 12px;"><%= sale.sold_at.strftime("%d/%m/%Y") %></span>
              <span style="font-size: 0.78rem; background: #f1f5f9; color: #475569; padding: 2px 8px; border-radius: 4px; margin-left: 10px;"><%= sale.delivery_method == 'delivery' ? 'Delivery' : 'Pickup' %></span>
            </div>
            <div style="display: flex; align-items: center; gap: 15px;">
              <span style="font-size: 0.85rem; font-weight: 600; color: #059669;"><%= sale.status.titleize %></span>
              
              <!-- VER COMPROBANTE EN HISTORIAL SOLO SI ES TRANSFERENCIA Y EXISTE -->
              <% if sale.forma_pago == 'TRANSFERENCIA' %>
                <% past_proof_url = sale.try(:transfer_proof_url) || sale.try(:transfer_proof)&.url %>
                <% if past_proof_url.present? %>
                  <button type="button" onclick="openProofModal('<%= past_proof_url %>')" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 4px 10px; border-radius: 6px; font-size: 0.78rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 5px;">
                    <i class="fa-solid fa-file-image"></i> Comprobante
                  </button>
                <% end %>
              <% end %>

              <strong style="color: #0f172a;">$<%= '%.2f' % sale.total_amount %></strong>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

  <% else %>
    <div style="text-align: center; background: #ffffff; padding: 50px; border-radius: 12px; border: 1px dashed #cbd5e1; color: #64748b;">
      <i class="fa-solid fa-receipt" style="font-size: 3rem; margin-bottom: 15px; color: #94a3b8;"></i>
      <p style="font-size: 1.05rem; font-weight: 500; margin: 0;">Aún no has realizado ninguna compra en línea.</p>
    </div>
  <% end %>
</div>

<!-- MODAL LIGHTBOX PARA VISUALIZAR COMPROBANTES (NUEVOS O YA EXISTENTES) -->
<div id="proof-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.8); z-index: 9999; justify-content: center; align-items: center; padding: 20px; box-sizing: border-box;">
  <div style="background: #fff; border-radius: 12px; padding: 20px; max-width: 650px; width: 100%; max-height: 90vh; display: flex; flex-direction: column; position: relative; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px;">
      <strong style="color: #0f172a; font-size: 1rem;"><i class="fa-solid fa-image" style="color: #0284c7; margin-right: 6px;"></i> Visualizador de Comprobante</strong>
      <button type="button" onclick="closeProofModal()" style="background: transparent; border: none; font-size: 1.3rem; cursor: pointer; color: #64748b;"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div style="overflow-y: auto; text-align: center; padding: 5px;">
      <img id="modal-proof-img" src="" alt="Comprobante de Pago" style="max-width: 100%; height: auto; border-radius: 8px; border: 1px solid #e2e8f0; object-fit: contain;">
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const fileInput = document.getElementById("transfer-proof-input");
    const previewContainer = document.getElementById("image-preview-container");
    const previewImage = document.getElementById("image-preview");
    const btnViewSelected = document.getElementById("btn-view-selected-preview");
    const uploadForm = document.getElementById("proof-upload-form");
    const spinnerOverlay = document.getElementById("upload-spinner-overlay");
    const btnSubmit = document.getElementById("btn-submit-proof");
    const btnText = document.getElementById("btn-text");

    let selectedImageSrc = "";

    // 1. Mostrar vista previa y habilitar botón de pantalla completa
    if (fileInput) {
      fileInput.addEventListener("change", function (e) {
        const file = e.target.files[0];

        if (file) {
          if (!file.type.startsWith("image/")) {
            alert("Por favor selecciona únicamente un archivo de imagen (JPG, PNG, WEBP).");
            fileInput.value = "";
            previewContainer.style.display = "none";
            selectedImageSrc = "";
            return;
          }

          const reader = new FileReader();
          reader.onload = function (e) {
            selectedImageSrc = e.target.result;
            previewImage.src = selectedImageSrc;
            previewContainer.style.display = "block";
          };
          reader.readAsDataURL(file);
        } else {
          previewContainer.style.display = "none";
          selectedImageSrc = "";
        }
      });
    }

    // 2. Abrir la imagen recién seleccionada en el modal al presionar "Ver en pantalla completa"
    if (btnViewSelected) {
      btnViewSelected.addEventListener("click", function () {
        if (selectedImageSrc) {
          openProofModal(selectedImageSrc);
        }
      });
    }

    // 3. Activar spinner al enviar el formulario
    if (uploadForm) {
      uploadForm.addEventListener("submit", function () {
        if (spinnerOverlay) {
          spinnerOverlay.style.display = "flex";
        }
        if (btnSubmit) {
          btnSubmit.disabled = true;
          btnSubmit.style.opacity = "0.7";
          btnSubmit.style.cursor = "not-allowed";
        }
        if (btnText) {
          btnText.textContent = "Subiendo archivo...";
        }
      });
    }
  });

  // Funciones globales para el modal lightbox
  function openProofModal(imageUrl) {
    const modal = document.getElementById("proof-modal");
    const modalImg = document.getElementById("modal-proof-img");
    if (modal && modalImg) {
      modalImg.src = imageUrl;
      modal.style.display = "flex";
    }
  }

  function closeProofModal() {
    const modal = document.getElementById("proof-modal");
    if (modal) {
      modal.style.display = "none";
    }
  }
</script>