    overflow-y: auto;
    padding-right: 5px;
    display: block; 
    -webkit-line-clamp: unset;
    -webkit-box-orient: unset;
  }

  .service-desc::-webkit-scrollbar {
    width: 4px;
  }
  .service-desc::-webkit-scrollbar-thumb {
    background: #cbd5e1;
