      width: 100%;
      height: 160px;
      min-height: auto;
    }

    .service-card-body {
      width: 100%;
    }

    .services-cards-slider {
      justify-content: flex-start;
    }
  }

  .product-img-box {
    position: relative;
    width: 100%;
    height: 190px;
  }

  .badge-offer {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: #ffc532;
    color: #000000;
    font-size: 0.75rem;
