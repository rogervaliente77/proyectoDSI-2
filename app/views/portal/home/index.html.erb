<!-- 5. CARDS DE CATEGORÍAS (DINÁMICAS CON BREADCRUMB) -->
<section id="servicios" class="text-center">
  <div class="section-title text-center">
    <h2 style="color: #0f172a;"><%= @config.categories_title%></h2>
    <p style="color: #0f172a;"><%= @config.categories_description%></p>
  </div>

  <!-- Breadcrumb -->
  <nav class="landing-breadcrumb-container mb-4 flex-center">
    <ul class="landing-breadcrumb" id="category-breadcrumb">
      <li class="breadcrumb-item active" data-category-id="root">
        <i class="fa-solid fa-folder"></i> Categorías Principales
      </li>
    </ul>
  </nav>

  <!-- Grid dinámico de categorías -->
  <div class="categories-grid" id="categories-grid">
    <% @categories.each do |category| %>
      <% 
        parent_id_val = category.parent_id.present? ? category.parent_id.to_s : "root"
        subcategories_count = category.subcategories.count
        has_image = category.respond_to?(:image_url) && category.image_url.present?
      %>
      <div class="category-card category-card-wrapper" 
           data-id="<%= category.id %>" 
           data-parent-id="<%= parent_id_val %>" 
           data-name="<%= category.name %>"
           data-slug="<%= category.name.parameterize %>">
        
        <div class="category-card-img-wrapper">
          <% if has_image %>
            <img src="<%= category.image_url %>" alt="<%= category.name %>">
          <% else %>
            <div class="category-card-placeholder">
              <i class="fa-solid fa-layer-group"></i>
            </div>
          <% end %>
        </div>
        
        <div class="category-card-body">
          <div class="category-card-title" title="<%= category.name %>">
            <span><%= category.name %></span>
          </div>
          
          <div class="category-card-action">
            <% if subcategories_count > 0 %>
              <button type="button" class="btn-subcategories view-subcategories-btn" data-id="<%= category.id %>" data-name="<%= category.name %>">
                Ver Subcategorías (<%= subcategories_count %>) <i class="fa-solid fa-chevron-right"></i>
              </button>
            <% else %>
              <button type="button" class="btn-subcategories" onclick="filterCategory('<%= category.name.parameterize %>')">
                Ver Productos <i class="fa-solid fa-arrow-down"></i>
              </button>
            <% end %>
          </div>
        </div>

      </div>
    <% end %>
  </div>
</section>

<!-- 6. CATÁLOGO CON FILTROS LATERALES -->
<section class="catalog-container" id="tienda">
  
  <!-- Filtros Lateral -->
  <aside class="filter-sidebar">
    <div class="search-box-sidebar">
      <input type="text" id="search-input" placeholder="Buscar..." onkeyup="filterProducts()">
    </div>

    <div class="filter-header-btn">
      <i class="fa-solid fa-sliders"></i> Filtros
    </div>

    <!-- Filtro de Categoría -->
    <div class="filter-group">
      <label>Categoría</label>
      <select id="category-select" onchange="filterProducts()">
        <option value="all">Todas las categorías</option>
        <% if @categories.present? %>
          <% @categories.each do |cat| %>
            <option value="<%= cat.name.parameterize %>"><%= cat.name %></option>
          <% end %>
        <% end %>
      </select>
    </div>

    <div class="filter-group">
      <label>Tipo de servicio / producto</label>
      <select id="type-select" onchange="filterProducts()">
        <option value="all">Todos los tipos</option>
        <% if defined?(CarType) %>
          <% CarType.all.each do |ct| %>
            <option value="<%= ct.name.parameterize %>"><%= ct.name %></option>
          <% end %>
        <% else %>
          <option value="preventivo">Preventivo</option>
          <option value="alto-rendimiento">Alto Rendimiento</option>
        <% end %>
      </select>
    </div>

    <div class="filter-group">
      <label>Marca Vehículo</label>
      <select id="brand-select" onchange="filterProducts()">
        <option value="all">Todas las marcas</option>
        <% if defined?(Marca) %>
          <% Marca.all.each do |m| %>
            <option value="<%= m.name.parameterize %>"><%= m.name %></option>
          <% end %>
        <% else %>
          <option value="bmw">BMW</option>
          <option value="audi">Audi</option>
          <option value="mercedes">Mercedes-Benz</option>
        <% end %>
      </select>
    </div>

    <!-- Select de Ordenamiento -->
    <div class="filter-group">
      <label>Ordenar por</label>
      <select id="sort-select" onchange="filterProducts()">
        <option value="default">Por defecto</option>
        <option value="price-asc">Precio: Menor a Mayor</option>
        <option value="price-desc">Precio: Mayor a Menor</option>
        <option value="name-asc">Nombre: A - Z</option>
        <option value="name-desc">Nombre: Z - A</option>
      </select>
    </div>

    <button class="btn-apply-filters" onclick="filterProducts()">Filtrar</button>
  </aside>

  <!-- Products Cards Grid Dinámico con Paginación -->
  <main>
    <div class="products-grid" id="products-grid">
      
      <% if @products.present? && @products.any? %>
        <% @products.each do |product| %>
          <% 
            # 1. Normalización de variables de imagen
            first_img_obj = product.try(:product_images)&.first
            img_url_from_db = if first_img_obj.is_a?(Hash)
                                first_img_obj['image_url'] || first_img_obj[:image_url]
                              else
                                first_img_obj.try(:image_url) || first_img_obj.try(:[], 'image_url')
                              end

            img_product = img_url_from_db.presence || 'https://images.unsplash.com/photo-1600706432522-e78112d8a9f2?auto=format&fit=crop&w=500&q=80'

            # 2. Evaluación de Oferta
            exp_date = product.offer_expires_at
            offer_active = product.offer.present? && (exp_date.blank? || exp_date.to_date >= Date.current)
            offer = offer_active ? product.offer : nil
            expiration = exp_date

            base_price = product.price.to_f
            discount = product.discount.to_f
            offer_type_upcase = offer&.offer_type&.upcase

            offer_price = if offer_active && offer_type_upcase == "DESCUENTO" && discount > 0
                            (base_price - (base_price * discount / 100.0)).round(2)
                          elsif offer_active
                            base_price
                          else
                            0
                          end

            effective_price = (offer_active && offer_price > 0) ? offer_price : base_price
          %>

          <div class="product-card" 
            data-category="<%= product.category ? product.category.name.parameterize : 'sin-categoria' %>" 
            data-brand="<%= product.respond_to?(:marca) && product.marca ? product.marca.name.parameterize : '' %>"
            data-type="<%= product.respond_to?(:car_type) && product.car_type ? product.car_type.name.parameterize : '' %>"
            data-name="<%= product.name.downcase %>"
            data-price="<%= effective_price %>">
            
            <div class="product-img-box">
              <!-- INSIGNIA/BADGE DE OFERTA -->
              <% if offer_active %>
                <span class="badge-offer">
                  <i class="fa-solid fa-tag"></i> <%= offer.display_name.presence || "¡OFERTA!" %>
                </span>
              <% end %>

              <img src="<%= img_product %>" alt="<%= product.name %>">
            </div>

            <div class="product-body">
              <h3 class="product-title"><%= product.name %></h3>
              <p class="product-desc"><%= product.try(:description) || "Producto de alta gama." %></p>

              <!-- DETALLES DE EXPIRACIÓN Y MAYOREO -->
              <div class="product-offer-details">
                <% if offer_active %>
                  <div class="offer-expiration">
                    <i class="fa-regular fa-clock"></i> Oferta válida hasta:
                    <%= expiration.present? ? expiration.strftime("%d/%m/%Y") : "Por tiempo limitado" %>
                  </div>
                <% end %>

                <% if offer_type_upcase == "MAYOREO" && product.wholesale_quantity.to_i > 0 %>
                  <div class="wholesale-info">
                    <i class="fa-solid fa-boxes-stacked"></i>
                    Mayoreo: a partir de <%= product.wholesale_quantity %> u.
                    <% if discount > 0 %> (-<%= discount.to_i %>% OFF) <% end %>
                  </div>
                <% end %>

                <% if offer_type_upcase == "DESCUENTO" && discount > 0 %>
                  <div class="wholesale-info">
                    <strong><%= discount.to_i %>% OFF</strong>
                  </div>
                <% end %>
              </div>

              <div class="product-footer">
                <!-- DESPLIEGUE DE PRECIOS -->
                <div class="product-price-container">
                  <% if offer_active && offer_type_upcase == "DESCUENTO" && discount > 0 %>
                    <span class="original-price">$<%= '%.2f' % base_price %></span>
                    <span class="product-price offer-price">$<%= '%.2f' % offer_price %></span>
                  <% elsif offer_active %>
                    <span class="product-price offer-price">$<%= '%.2f' % base_price %></span>
                  <% else %>
                    <span class="product-price">$<%= '%.2f' % base_price %></span>
                  <% end %>
                </div>

                <!-- CONTENEDOR DE BOTÓN/CONTADOR DINÁMICO -->
                <div class="product-cart-action-box" data-product-id="<%= product.id %>" data-product-name="<%= product.name %>" data-product-price="<%= effective_price %>" data-product-img="<%= img_product %>">
                  <button class="btn-buy btn-add-to-cart" type="button" aria-label="Agregar al carrito" onclick="handleAddToCart('<%= product.id %>')">
                    <i class="fa-solid fa-cart-shopping"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>

    </div>

    <!-- Contenedor para Controles de Paginación -->
    <div class="pagination-container" id="pagination-container"></div>
  </main>
</section>

<!-- MODAL DE PAGO (QUEMADO PARA DESPLIEGUE INICIAL) -->
<div id="checkout-modal-overlay" class="checkout-modal-overlay" onclick="closeCheckoutModal()">
  <div class="checkout-modal" onclick="event.stopPropagation()">
    <div class="checkout-modal-header">
      <h3><i class="fa-solid fa-credit-card"></i> Finalizar Compra</h3>
      <button type="button" class="checkout-close-btn" onclick="closeCheckoutModal()">&times;</button>
    </div>

    <div class="checkout-modal-body">
      <div class="checkout-summary-box">
        <h4>Resumen del Pedido</h4>
        <div id="checkout-items-list" class="checkout-items-list">
          <!-- Carga dinámicamente el contenido del carrito -->
        </div>
        <div class="checkout-total-row">
          <span>Total a Pagar:</span>
          <strong id="checkout-total-amount">$0.00</strong>
        </div>
      </div>

      <form id="checkout-form" onsubmit="event.preventDefault(); alert('Funcionalidad de pago en desarrollo'); closeCheckoutModal();">
        <div class="form-group mb-3">
          <label class="form-label">Método de Pago</label>
          <select class="form-select">
            <option value="card">Tarjeta de Crédito / Débito</option>
            <option value="transfer">Transferencia Bancaria</option>
            <option value="cash">Pago en Efectivo al Recibir</option>
          </select>
        </div>

        <div class="form-group mb-3">
          <label class="form-label">Dirección de Envío</label>
          <input type="text" class="form-input" placeholder="Ej. Av. Principal #123, San Salvador" required>
        </div>

        <div class="form-group mb-3">
          <label class="form-label">Teléfono de Contacto</label>
          <input type="tel" class="form-input" placeholder="Ej. +503 7000-0000" required>
        </div>

        <button type="submit" class="btn-confirm-payment">
          <i class="fa-solid fa-lock"></i> Confirmar y Pagar
        </button>
      </form>
    </div>
  </div>
</div>

<!-- ESTILOS GENERALES -->
<style>
  html {
    scroll-behavior: smooth;
  }

  /* Breadcrumb original */
  .landing-breadcrumb-container {
    max-width: 1200px;
    margin: 0 auto 20px auto;
    padding: 0 20px;
  }

  .landing-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 12px 20px;
    background-color: #f8f9fa;
    border-radius: 8px;
    gap: 8px;
    align-items: center;
    font-size: 0.95rem;
  }

  .landing-breadcrumb li.breadcrumb-item a {
    color: #0d6efd;
    text-decoration: none;
    font-weight: 500;
  }

  .landing-breadcrumb li.breadcrumb-item a:hover {
    text-decoration: underline;
  }

  .landing-breadcrumb li.breadcrumb-item.active {
    color: #333;
    font-weight: 700;
  }

  .landing-breadcrumb li + li::before {
    content: "/";
    padding-right: 8px;
    color: #6c757d;
  }

  #servicios {
    text-align: center;
  }

  .section-title {
    text-align: center;
    margin-bottom: 25px;
  }

  /* Grid de Categorías Scroll Horizontal */
  .categories-grid {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    justify-content: center;
    gap: 16px;
    max-width: 100%;
    margin: 0 auto;
    padding: 10px 5px 20px 5px;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }

  @media (max-width: 1200px) {
    .categories-grid {
      justify-content: flex-start;
    }
  }

  .categories-grid::-webkit-scrollbar {
    height: 6px;
  }

  .categories-grid::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
  }

  .categories-grid::-webkit-scrollbar-thumb {
    background: #ccc;
    border-radius: 10px;
  }

  .categories-grid::-webkit-scrollbar-thumb:hover {
    background: #0d6efd;
  }

  /* Card de Categoría Restablecida */
  .category-card {
    flex: 0 0 200px;
    width: 200px;
    height: 270px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    background: #ffffff;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #e9ecef;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .category-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
  }

  .category-card-img-wrapper {
    width: 100%;
    height: 140px;
    flex-shrink: 0;
    overflow: hidden;
    background-color: #f8f9fa;
    position: relative;
  }

  .category-card-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .category-card:hover .category-card-img-wrapper img {
    transform: scale(1.06);
  }

  .category-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
    color: #adb5bd;
  }

  .category-card-placeholder i {
    font-size: 2.8rem;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .category-card:hover .category-card-placeholder i {
    transform: scale(1.1);
    color: #6c757d;
  }

  .category-card-body {
    padding: 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
    width: 100%;
    box-sizing: border-box;
    background-color: #ffffff;
  }

  .category-card-title {
    height: 2.6em;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-bottom: 8px;
    width: 100%;
  }

  .category-card-title span {
    font-size: 0.88rem;
    font-weight: 700;
    color: #212529;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .category-card-action {
    width: 100%;
    margin-top: auto;
  }

  .btn-subcategories {
    background: #0d6efd;
    border: none;
    color: #ffffff;
    padding: 7px 10px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    white-space: nowrap;
  }

  .btn-subcategories:hover {
    background: #0b5ed7;
    color: #ffffff;
  }

  /* Mensaje Sin Productos */
  .no-products-msg {
    grid-column: 1 / -1;
    width: 100%;
    padding: 50px 20px;
    text-align: center;
    background-color: #ffffff;
    border: 1px dashed #ced4da;
    border-radius: 10px;
    color: #6c757d;
    margin: 20px 0;
  }

  .no-products-msg i {
    font-size: 3rem;
    margin-bottom: 12px;
    color: #adb5bd;
  }

  .no-products-msg p {
    font-size: 1.05rem;
    font-weight: 500;
    margin: 0;
  }

  /* ESTILOS DE PAGINACIÓN DE PRODUCTOS */
  .pagination-container {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 30px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .page-btn {
    background-color: #ffffff;
    border: 1px solid #dee2e6;
    color: #0d6efd;
    padding: 8px 14px;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .page-btn:hover:not(:disabled) {
    background-color: #e9ecef;
    border-color: #ced4da;
    color: #0b5ed7;
  }

  .page-btn.active {
    background-color: #0d6efd;
    border-color: #0d6efd;
    color: #ffffff;
  }

  .page-btn:disabled {
    color: #6c757d;
    background-color: #f8f9fa;
    border-color: #dee2e6;
    cursor: not-allowed;
    opacity: 0.6;
  }

  .product-img-box {
    position: relative;
    width: 100%;
    height: 190px;
  }

  .badge-offer {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: #ffc532;
    color: #000000;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 4px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    z-index: 5;
    text-transform: uppercase;
  }

  .product-price-container {
    display: flex;
    flex-direction: column;
  }

  .original-price {
    font-size: 0.85rem;
    color: #94a3b8;
    text-decoration: line-through;
  }

  .product-price.offer-price {
    color: #dc3545;
    font-size: 1.2rem;
    font-weight: 800;
  }

  .offer-expiration {
    color: #d97706;
    font-size: 0.78rem;
    font-weight: 600;
    margin-top: 4px;
  }

  /* Color negro por defecto para los enlaces de este navbar */
  .main-nav .nav-links li a {
    color: #000000 !important;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .main-nav .nav-links li a:hover {
    color: #ffffff !important;
  }

  /* ESTILOS DEL MODAL DE CHECKOUT (PAGO) */
  .checkout-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1050;
  }

  .checkout-modal-overlay.open {
    display: flex;
  }

  .checkout-modal {
    background: #ffffff;
    width: 100%;
    max-width: 520px;
    border-radius: 12px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    margin: 15px;
  }

  .checkout-modal-header {
    background: #0f172a;
    color: #ffffff;
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .checkout-modal-header h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .checkout-close-btn {
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 1.5rem;
    cursor: pointer;
  }

  .checkout-modal-body {
    padding: 20px;
    max-height: 80vh;
    overflow-y: auto;
  }

  .checkout-summary-box {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 20px;
  }

  .checkout-summary-box h4 {
    margin: 0 0 10px 0;
    font-size: 0.95rem;
    color: #0f172a;
  }

  .checkout-items-list {
    max-height: 120px;
    overflow-y: auto;
    font-size: 0.85rem;
    color: #475569;
    margin-bottom: 10px;
  }

  .checkout-item-line {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
  }

  .checkout-total-row {
    display: flex;
    justify-content: space-between;
    border-top: 1px dashed #cbd5e1;
    padding-top: 8px;
    font-size: 1rem;
    color: #0f172a;
  }

  .form-group {
    margin-bottom: 12px;
  }

  .form-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: #334155;
    margin-bottom: 4px;
  }

  .form-input, .form-select {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    font-size: 0.9rem;
    box-sizing: border-box;
  }

  .form-input:focus, .form-select:focus {
    outline: none;
    border-color: #0d6efd;
  }

  .btn-confirm-payment {
    width: 100%;
    padding: 12px;
    background: #10b981;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.2s ease;
    margin-top: 10px;
  }

  .btn-confirm-payment:hover {
    background: #059669;
  }
</style>

<!-- JAVASCRIPT CORREGIDO Y EXPANDIDO -->
<script>
  function setupLandingScript() {
    const menuToggle = document.getElementById('menu-toggle');
    const navMenu = document.getElementById('nav-menu');

    if (menuToggle && navMenu) {
      menuToggle.addEventListener('click', () => {
        navMenu.classList.toggle('active');
      });
    }

    const categoriesGrid = document.getElementById("categories-grid");
    const breadcrumb = document.getElementById("category-breadcrumb");
    
    if (categoriesGrid && breadcrumb) {
      let navigationHistory = [{ id: 'root', name: 'Categorías Principales' }];

      function renderCurrentLevel(parentId) {
        const allWrappers = categoriesGrid.querySelectorAll(".category-card-wrapper");
        let countVisible = 0;

        allWrappers.forEach(wrapper => {
          if (wrapper.dataset.parentId === parentId) {
            wrapper.style.display = 'flex';
            countVisible++;
          } else {
            wrapper.style.display = 'none';
          }
        });

        let noCatMsg = document.getElementById("no-categories-msg");
        if (countVisible === 0) {
          if (!noCatMsg) {
            noCatMsg = document.createElement("div");
            noCatMsg.id = "no-categories-msg";
            noCatMsg.style.cssText = "width: 100%; text-align: center; padding: 40px; color: #6c757d;";
            noCatMsg.innerHTML = '<i class="fa-solid fa-folder-open" style="font-size: 2.5rem; margin-bottom: 10px;"></i><p>No hay subcategorías disponibles en este nivel.</p>';
            categoriesGrid.appendChild(noCatMsg);
          }
        } else if (noCatMsg) {
          noCatMsg.remove();
        }

        renderBreadcrumb();
      }

      function renderBreadcrumb() {
        breadcrumb.innerHTML = "";
        navigationHistory.forEach((item, index) => {
          const isLast = index === navigationHistory.length - 1;
          const li = document.createElement("li");
          li.className = `breadcrumb-item ${isLast ? "active" : ""}`;
          
          if (isLast && index > 0) {
            li.textContent = item.name;
          } else {
            const a = document.createElement("a");
            a.href = "#servicios";
            a.innerHTML = index === 0 ? '<i class="fa-solid fa-folder"></i> Categorías Principales' : item.name;
            a.style.cursor = "pointer";
            
            a.addEventListener("click", function(e) {
              e.preventDefault();
              
              navigationHistory = navigationHistory.slice(0, index + 1);
              renderCurrentLevel(item.id);

              if (index === 0) {
                const catSelect = document.getElementById('category-select');
                if (catSelect) {
                  catSelect.value = 'all';
                  if (typeof window.filterProducts === 'function') {
                    window.filterProducts();
                  }
                }
              }
            });
            li.appendChild(a);
          }
          breadcrumb.appendChild(li);
        });
      }

      categoriesGrid.onclick = function(e) {
        const btn = e.target.closest(".view-subcategories-btn");
        if (btn) {
          e.stopPropagation();
          const catId = btn.dataset.id;
          const catName = btn.dataset.name;

          navigationHistory.push({ id: catId, name: catName });
          renderCurrentLevel(catId);
        }
      };

      renderCurrentLevel("root");
    }

    let currentPage = 1;
    const itemsPerPage = 10;
    let filteredCards = [];

    window.filterCategory = function(catSlug) {
      const catSelect = document.getElementById('category-select');
      if (catSelect) {
        catSelect.value = catSlug;
        window.filterProducts();
        
        const tiendaSection = document.getElementById('tienda');
        if (tiendaSection) {
          tiendaSection.scrollIntoView({ behavior: 'smooth' });
        }
      }
    };

    window.filterProducts = function() {
      const normalizeText = (str) => 
        (str || "")
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "");

      const searchVal = normalizeText(document.getElementById('search-input')?.value);
      const selectedCategory = document.getElementById('category-select')?.value || 'all';
      const selectedBrand = document.getElementById('brand-select')?.value || 'all';
      const selectedType = document.getElementById('type-select')?.value || 'all';
      const selectedSort = document.getElementById('sort-select')?.value || 'default';
      
      const allCards = Array.from(document.querySelectorAll('.product-card'));
      const productsGrid = document.getElementById('products-grid');

      filteredCards = allCards.filter(card => {
        const cardCategory = card.dataset.category;
        const cardBrand = card.dataset.brand;
        const cardType = card.dataset.type;
        const cardName = normalizeText(card.dataset.name);

        const matchesCategory = (selectedCategory === 'all' || cardCategory === selectedCategory);
        const matchesBrand = (selectedBrand === 'all' || cardBrand === selectedBrand);
        const matchesType = (selectedType === 'all' || cardType === selectedType);
        const matchesSearch = cardName.includes(searchVal);

        return matchesCategory && matchesBrand && matchesType && matchesSearch;
      });

      filteredCards.sort((a, b) => {
        const priceA = parseFloat(a.dataset.price) || 0;
        const priceB = parseFloat(b.dataset.price) || 0;
        const nameA = a.dataset.name || '';
        const nameB = b.dataset.name || '';

        switch (selectedSort) {
          case 'price-asc':
            return priceA - priceB;
          case 'price-desc':
            return priceB - priceA;
          case 'name-asc':
            return nameA.localeCompare(nameB);
          case 'name-desc':
            return nameB.localeCompare(nameA);
          default:
            return 0;
        }
      });

      filteredCards.forEach(card => productsGrid.appendChild(card));
      allCards.forEach(card => card.style.display = 'none');

      let noProductsMsg = document.getElementById('no-products-empty-msg');
      if (filteredCards.length === 0) {
        if (!noProductsMsg && productsGrid) {
          noProductsMsg = document.createElement('div');
          noProductsMsg.id = 'no-products-empty-msg';
          noProductsMsg.className = 'no-products-msg';
          noProductsMsg.innerHTML = `
            <i class="fa-solid fa-box-open"></i>
            <p>No se encontraron productos para esta búsqueda o filtro.</p>
          `;
          productsGrid.appendChild(noProductsMsg);
        }
      } else if (noProductsMsg) {
        noProductsMsg.remove();
      }

      currentPage = 1;
      renderPage();
    };

    function renderPage() {
      const totalPages = Math.ceil(filteredCards.length / itemsPerPage);
      filteredCards.forEach(card => card.style.display = 'none');

      const startIndex = (currentPage - 1) * itemsPerPage;
      const endIndex = startIndex + itemsPerPage;
      const pageItems = filteredCards.slice(startIndex, endIndex);

      pageItems.forEach(card => card.style.display = 'flex');
      renderPaginationControls(totalPages);
    }

    function renderPaginationControls(totalPages) {
      const paginationContainer = document.getElementById('pagination-container');
      if (!paginationContainer) return;

      paginationContainer.innerHTML = '';

      if (totalPages <= 1) return;

      const prevBtn = document.createElement('button');
      prevBtn.className = 'page-btn';
      prevBtn.innerHTML = '<i class="fa-solid fa-chevron-left"></i>';
      prevBtn.disabled = (currentPage === 1);
      prevBtn.onclick = () => {
        if (currentPage > 1) {
          currentPage--;
          renderPage();
          scrollToTienda();
        }
      };
      paginationContainer.appendChild(prevBtn);

      for (let i = 1; i <= totalPages; i++) {
        const pageBtn = document.createElement('button');
        pageBtn.className = `page-btn ${i === currentPage ? 'active' : ''}`;
        pageBtn.textContent = i;
        pageBtn.onclick = () => {
          currentPage = i;
          renderPage();
          scrollToTienda();
        };
        paginationContainer.appendChild(pageBtn);
      }

      const nextBtn = document.createElement('button');
      nextBtn.className = 'page-btn';
      nextBtn.innerHTML = '<i class="fa-solid fa-chevron-right"></i>';
      nextBtn.disabled = (currentPage === totalPages);
      nextBtn.onclick = () => {
        if (currentPage < totalPages) {
          currentPage++;
          renderPage();
          scrollToTienda();
        }
      };
      paginationContainer.appendChild(nextBtn);
    }

    function scrollToTienda() {
      const tiendaSection = document.getElementById('tienda');
      if (tiendaSection) {
        tiendaSection.scrollIntoView({ behavior: 'smooth' });
      }
    }

    window.filterProducts();
  }

  // --- SISTEMA DE GESTIÓN DEL CARRITO ---

  const STORAGE_KEY = 'bimers_cart_data';

  function getCart() {
    try {
      const data = localStorage.getItem(STORAGE_KEY);
      return data ? JSON.parse(data) : [];
    } catch (e) {
      console.error("Error al leer localStorage:", e);
      return [];
    }
  }

  function saveCart(cart) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
    } catch (e) {
      console.error("Error al guardar en localStorage:", e);
    }
    updateUI();
  }

  function handleAddToCart(productId) {
    let cart = getCart();
    const box = document.querySelector(`.product-cart-action-box[data-product-id='${productId}']`);
    
    if (!box) return;

    const name = box.dataset.productName;
    const price = parseFloat(box.dataset.productPrice);
    const img = box.dataset.productImg;

    const existingIndex = cart.findIndex(item => String(item.id) === String(productId));

    if (existingIndex > -1) {
      cart[existingIndex].qty += 1;
    } else {
      cart.push({ id: String(productId), name: name, price: price, img: img, qty: 1 });
    }

    saveCart(cart);
  }

  function changeQty(productId, delta) {
    let cart = getCart();
    const index = cart.findIndex(item => String(item.id) === String(productId));

    if (index > -1) {
      cart[index].qty += delta;
      if (cart[index].qty <= 0) {
        cart.splice(index, 1);
      }
      saveCart(cart);
    }
  }

  function toggleCartModal() {
    document.getElementById('cart-modal-overlay')?.classList.toggle('open');
    document.getElementById('cart-drawer')?.classList.toggle('open');
  }

  /* ACCIÓN: PROCEDER AL PAGO (DESPLIEGA EL MODAL DE CHECKOUT) */
  function proceedToCheckout() {
    const cart = getCart();
    if (cart.length === 0) {
      alert("Tu carrito está vacío. Agrega algunos productos antes de proceder al pago.");
      return;
    }

    toggleCartModal(); // Cierra el slider/drawer del carrito

    // Carga los productos dentro del modal de checkout
    const itemsContainer = document.getElementById('checkout-items-list');
    const totalElem = document.getElementById('checkout-total-amount');

    if (itemsContainer) {
      itemsContainer.innerHTML = cart.map(item => `
        <div class="checkout-item-line">
          <span>${item.qty}x ${item.name}</span>
          <strong>$${(item.price * item.qty).toFixed(2)}</strong>
        </div>
      `).join('');
    }

    if (totalElem) {
      const grandTotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
      totalElem.textContent = `$${grandTotal.toFixed(2)}`;
    }

    // Muestra el modal de checkout
    document.getElementById('checkout-modal-overlay')?.classList.add('open');
  }

  function closeCheckoutModal() {
    document.getElementById('checkout-modal-overlay')?.classList.remove('open');
  }

  function updateUI() {
    const cart = getCart();
    
    const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
    const badge = document.getElementById('floating-cart-count');
    if (badge) badge.textContent = totalQty;

    document.querySelectorAll('.product-cart-action-box').forEach(box => {
      const productId = String(box.dataset.productId);
      const item = cart.find(i => String(i.id) === productId);

      if (item && item.qty > 0) {
        box.innerHTML = `
          <div class="card-qty-selector">
            <button type="button" class="btn-qty" onclick="changeQty('${productId}', -1)">-</button>
            <span class="qty-num">${item.qty}</span>
            <button type="button" class="btn-qty" onclick="changeQty('${productId}', 1)">+</button>
          </div>
        `;
      } else {
        box.innerHTML = `
          <button class="btn-buy btn-add-to-cart" type="button" aria-label="Agregar al carrito" onclick="handleAddToCart('${productId}')">
            <i class="fa-solid fa-cart-shopping"></i>
          </button>
        `;
      }
    });

    const container = document.getElementById('cart-drawer-items');
    const totalElem = document.getElementById('cart-drawer-total');
    
    if (container) {
      if (cart.length === 0) {
        container.innerHTML = `<p style="text-align:center; color:#64748b; margin-top:30px;">Tu carrito está vacío.</p>`;
      } else {
        container.innerHTML = cart.map(item => {
          const itemSubtotal = (item.price * item.qty).toFixed(2);
          const itemUnitPrice = item.price.toFixed(2);

          return `
            <div class="cart-item-row">
              <img src="${item.img}" alt="${item.name}">
              <div class="cart-item-info">
                <h4 class="cart-item-title">${item.name}</h4>
                <div class="cart-item-details">
                  <span class="cart-item-qty-badge">Cant: <strong>${item.qty}</strong></span>
                  <span class="cart-item-unit-price">($${itemUnitPrice} c/u)</span>
                </div>
                <span class="cart-item-price">$${itemSubtotal}</span>
              </div>
              <div class="cart-qty-controls">
                <button type="button" class="btn-qty" onclick="changeQty('${item.id}', -1)">-</button>
                <span class="qty-display">${item.qty}</span>
                <button type="button" class="btn-qty" onclick="changeQty('${item.id}', 1)">+</button>
              </div>
            </div>
          `;
        }).join('');
      }
    }

    if (totalElem) {
      const grandTotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
      totalElem.textContent = `$${grandTotal.toFixed(2)}`;
    }
  }

  function initLandingPage() {
    setupLandingScript();
    updateUI();
  }

  ['DOMContentLoaded', 'turbo:load', 'turbolinks:load'].forEach(eventName => {
    document.removeEventListener(eventName, initLandingPage);
    document.addEventListener(eventName, initLandingPage);
  });
</script>